---
// Layout base: <head> completo, skip link, header y footer.
// Se usa en las cinco rutas para que compartan exactamente el mismo header.
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  title: string;
  description: string;
  /**
   * `true` cuando la PRIMERA sección de la página tiene fondo oscuro.
   *
   * El header es claro, sticky y **opaco en las cinco rutas** (decisión de
   * Jorge, 26 ago 2026: se comporta igual en todo el sitio). Lo único que
   * cambia esta bandera es la hairline de abajo: sobre un hero oscuro no
   * separa nada —la frontera ya la hace el salto de luminosidad— y el filete
   * gris sobre la tinta se lee como una costura suelta, así que se quita.
   *
   * Lo declara la página porque es la página la que sabe de qué color
   * arranca. Si /nosotros o cualquier otra estrena hero oscuro, se le pone
   * esta bandera y ya.
   */
  heroOscuro?: boolean;
  /**
   * `true` en las páginas que no deben salir en resultados de búsqueda.
   *
   * Hoy son las tres legales —/terminos, /privacidad, /cookies—: no compiten
   * por búsquedas y no deben posicionarse por encima de las páginas que sí
   * venden. Siguen siendo enlazables y siguen teniendo su canonical; lo único
   * que cambia es que el buscador no las indexa.
   */
  noindex?: boolean;
  /**
   * Tarjeta para redes (og:image). Ruta absoluta desde la raíz del sitio.
   *
   * El default es la portada. Una página puede poner la suya sin rehacer nada:
   * la etiqueta se resuelve a URL ABSOLUTA con `new URL(imagen, Astro.site)`,
   * porque con una ruta relativa ni Facebook ni LinkedIn ni WhatsApp la
   * encuentran y la tarjeta sale sin imagen.
   */
  imagen?: string;
}

const {
  title,
  description,
  heroOscuro = false,
  noindex = false,
  imagen = "/assets/og/portada.jpg",
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === "Ilhas" ? title : `${title} · Ilhas`;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#7A3CFF" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ilhas" />
    <meta property="og:locale" content="es_LA" />
    {/* El home pasa title="Ilhas" para que su <title> no salga «Ilhas · Ilhas».
        Eso está bien para la pestaña, pero de titular de una tarjeta compartida
        «Ilhas» a secas no dice nada, así que ahí sí lleva la frase. */}
    <meta
      property="og:title"
      content={
        pageTitle === "Ilhas"
          ? "Ilhas — tu primer proceso corriendo con IA"
          : pageTitle
      }
    />
    <meta property="og:description" content={description} />
    {/* og:url sale de canonicalURL y es DISTINTA en cada página. No la fijes a
        https://ilhas.ai: compartir /finanzas reportaría la portada. Lo mismo el
        canonical de arriba. Los dos están bien. */}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(imagen, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Ilhas — tu primer proceso corriendo con IA"
    />
    {/* `summary_large_image` y no `summary`: con `summary` la tarjeta sale
        cuadrada y recorta una imagen de 1200×630 por los lados, o sea que se
        pierde la cotización, que es la mitad del diseño. */}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicon, generado desde public/assets/logo/logo-mark.svg -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!--
      Fuentes self-hosted. Solo se precargan DOS, no las cuatro: el titular
      (Space Grotesk 600) y el cuerpo (Inter 400) son las que pintan el primer
      texto de cualquier página. Precargar las cuatro ponía ~96 KB de fuentes
      a competir con la imagen LCP en la misma ventana de ancho de banda, y el
      "render delay" se comía el 61% del LCP en /nosotros.
      Inter 500 y 600 se descubren desde el CSS y entran con `font-display:
      swap`, así que el texto se pinta con la fuente de respaldo y cambia
      cuando llegan — nunca se queda en blanco esperándolas.
    -->
    <link
      rel="preload"
      href="/assets/fonts/space-grotesk-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/inter-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido principal</a>
    <Nav currentPath={Astro.url.pathname} heroOscuro={heroOscuro} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
