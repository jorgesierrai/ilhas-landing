---
/**
 * Clip con voz — máximo 90 s (regla 5 de curaduría, PLAN-MEDIOS.md Parte 5).
 *
 * Nunca autoplay: tiene audio. `preload="none"` para que un clip de 12 MB no
 * se descargue en cuanto alguien abre la página; el póster es lo que se ve
 * hasta que el visitante decide reproducir.
 */
import { porId } from "../../data/medios";
import { hayMedio, rutaVideo, rutaPoster, rutaSubtitulos } from "../../lib/medios";
import Ranura from "./Ranura.astro";

interface Props {
  id: string;
  titulo?: string;
  ratio?: string;
  /** Chrome de ventana alrededor del video. Ver `.marco` en base.css. */
  marco?: "navegador" | "terminal" | "ninguno";
  /**
   * Tope de ancho del video. Los verticales lo necesitan: a más de ~440 px
   * la fuente de 1080 px baja de densidad y se ve suave y barata
   * (medios/BRIEF-autoridad-radio.md, spec 1).
   */
  maxAncho?: string;
}

const {
  id,
  titulo,
  ratio = "16 / 9",
  marco = "ninguno",
  maxAncho,
} = Astro.props;

const slot = porId(id);
if (!slot) throw new Error(`VideoClip: no existe la ranura "${id}" en src/data/medios.ts`);

const listo = hayMedio(id);
const mp4 = rutaVideo(id, "mp4");
const poster = rutaPoster(id);
const vtt = rutaSubtitulos(id);
const etiqueta = titulo ?? slot.alt;
---

{
  listo && mp4 ? (
    <figure class="clip" style={maxAncho ? `--clip-max: ${maxAncho}` : undefined}>
      <div class:list={["marco", marco === "terminal" && "marco--terminal"]}>
        {marco !== "ninguno" && (
          <div class="marco__barra" aria-hidden="true">
            <span /><span /><span />
          </div>
        )}
        <video
          class="clip__video"
          controls
          preload="none"
          playsinline
          poster={poster ?? undefined}
          style={`--clip-ratio: ${ratio}`}
          aria-label={etiqueta}
        >
          <source src={mp4} type="video/mp4" />
          {/*
            `default` autoenciende los subtítulos, que es lo correcto en un
            sitio en español con clips de voz. La excepción son los archivos
            que YA traen los subtítulos quemados en la imagen: ahí el
            navegador pinta su capa encima de la que está en el pixel y se
            leen dobles. La bandera vive en el manifiesto porque es una
            propiedad del archivo, no de la página.
          */}
          {vtt && (
            <track
              kind="captions"
              src={vtt}
              srclang="es"
              label="Español"
              default={!slot.subtitulosQuemados}
            />
          )}
        </video>
      </div>
      {/*
        Solo `caption`. `duracion` NO va aquí: es una nota de producción para
        saber a qué largo cortar el clip, no texto para el visitante. Se
        publicaba y se leía "Radio Imagen · 2018 · 45-60 s"; peor, anunciaba
        rangos que el archivo final no cumple (el clip de conferencia decía
        "45 s" durando 21). El largo real ya lo dice el propio <video>.
      */}
      {slot.caption && <figcaption class="clip__pie">{slot.caption}</figcaption>}
    </figure>
  ) : (
    <Ranura slot={slot} />
  )
}

<style>
  .clip {
    margin: 0;
    max-width: var(--clip-max, none);
  }

  .clip__video {
    display: block;
    width: 100%;
    aspect-ratio: var(--clip-ratio);
    background: var(--ilhas-dark);
  }

  /* Sin marco el video pone su propio radio; con marco lo pone el contenedor
     (si no, las esquinas del video se salen del chrome). */
  .clip .marco:not(:has(.marco__barra)) .clip__video {
    border-radius: var(--ilhas-radius-card);
  }

  .clip__pie {
    margin-top: 0.75rem;
    font-family: var(--ilhas-font-body);
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-text);
  }

  /* Sobre sección oscura --ilhas-text mide 1.76:1 y falla AA. */
  :global(.bg-dark) .clip__pie {
    color: rgba(248, 250, 255, 0.7);
  }
</style>
