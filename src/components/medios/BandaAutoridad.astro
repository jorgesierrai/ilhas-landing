---
/**
 * Banda de autoridad — tira delgada, no una sección.
 *
 * Traduce "apenas estamos empezando a ofrecer Ilhas" en "pero no apenas
 * empezamos" (PLAN-MEDIOS.md Parte 2). Máximo ~80 px de alto y sin fondo
 * propio: si se convierte en una sección, deja de funcionar y le compite al
 * hero, que es justo lo que la regla 6 de curaduría prohíbe.
 *
 * Regla 4 de curaduría: la fecha es parte de la prueba. "Radio Imagen" vale la
 * mitad de "Radio Imagen · 2018".
 */
interface Item {
  etiqueta: string;
  año?: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ul class="banda">
  {
    items.map((item) => (
      <li class="banda__item">
        {item.href ? (
          <a href={item.href} class="banda__enlace">
            {item.etiqueta}
            {item.año && <span class="banda__año">{item.año}</span>}
          </a>
        ) : (
          <>
            {item.etiqueta}
            {item.año && <span class="banda__año">{item.año}</span>}
          </>
        )}
      </li>
    ))
  }
</ul>

<style>
  .banda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    padding-block: 1rem;
    border-top: 1px solid var(--ilhas-gray);
    border-bottom: 1px solid var(--ilhas-gray);
    list-style: none;
  }

  .banda__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--ilhas-font-body);
    font-weight: 500;
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-text);
  }

  .banda__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .banda__enlace:hover {
    color: var(--ilhas-primary);
  }

  .banda__año {
    padding: 0.125rem 0.5rem;
    border-radius: var(--ilhas-radius-pill);
    background: var(--ilhas-primary-10);
    color: var(--ilhas-primary);
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 0.75rem;
  }

  :global(.bg-dark) .banda {
    border-color: rgba(248, 250, 255, 0.12);
  }

  :global(.bg-dark) .banda__item {
    color: rgba(248, 250, 255, 0.8);
  }

  :global(.bg-dark) .banda__año {
    background: rgba(248, 250, 255, 0.1);
    color: var(--ilhas-grad-start);
  }
</style>
