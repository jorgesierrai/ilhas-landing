---
/**
 * Banda de autoridad — tira delgada, no una sección.
 *
 * Traduce "apenas estamos empezando a ofrecer Ilhas" en "pero no apenas
 * empezamos" (PLAN-MEDIOS.md Parte 2). Máximo ~80 px de alto y sin fondo
 * propio: si se convierte en una sección, deja de funcionar y le compite al
 * hero, que es justo lo que la regla 6 de curaduría prohíbe.
 *
 * Regla 4 de curaduría: la fecha es parte de la prueba. "Radio Imagen" vale la
 * mitad de "Radio Imagen · 2018".
 */
interface Item {
  etiqueta: string;
  año?: string;
  href?: string;
}

interface Props {
  /** La línea que resume las fechas. Es lo que se lee en dos segundos. */
  titulo?: string;
  items: Item[];
  /** A dónde manda a quien quiera la prueba completa. */
  href?: string;
  hrefTexto?: string;
}

const { titulo, items, href, hrefTexto = "Ver la trayectoria" } = Astro.props;
---

<div class="banda">
  {titulo && <p class="banda__titulo">{titulo}</p>}

  <ul class="banda__fechas">
    {
      items.map((item) => (
        <li class="banda__item">
          {item.href ? (
            <a href={item.href} class="banda__enlace">
              {item.año && <span class="banda__año">{item.año}</span>}
              {item.etiqueta}
            </a>
          ) : (
            <>
              {item.año && <span class="banda__año">{item.año}</span>}
              {item.etiqueta}
            </>
          )}
        </li>
      ))
    }
  </ul>

  {
    href && (
      <a href={href} class="banda__ver">
        {hrefTexto} →
      </a>
    )
  }
</div>

<style>
  /* Tira, no sección: sin fondo propio y con tope de alto. Si crece, deja de
     funcionar y le compite al hero — regla 6 de curaduría. */
  .banda {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem 1.5rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--ilhas-gray);
    border-bottom: 1px solid var(--ilhas-gray);
  }

  .banda__titulo {
    max-width: none;
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--ilhas-dark);
  }

  .banda__fechas {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .banda__ver {
    margin-left: auto;
    align-self: baseline;
    font-family: var(--ilhas-font-body);
    font-weight: 600;
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-primary-dark);
    text-decoration: none;
    white-space: nowrap;
  }

  .banda__ver:hover {
    text-decoration: underline;
  }

  .banda__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--ilhas-font-body);
    font-weight: 500;
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-text);
  }

  .banda__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .banda__enlace:hover {
    color: var(--ilhas-primary);
  }

  .banda__año {
    padding: 0.125rem 0.5rem;
    border-radius: var(--ilhas-radius-pill);
    background: var(--ilhas-primary-10);
    /* -dark, no --ilhas-primary: el chip es texto de 12 px sobre el morado al
       10%, y ahí el primary mide 4.44:1 — falla AA por muy poco. El oscuro
       mide 6.26:1 sobre el mismo fondo. */
    color: var(--ilhas-primary-dark);
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 0.75rem;
  }

  :global(.bg-dark) .banda {
    border-color: rgba(248, 250, 255, 0.12);
  }

  :global(.bg-dark) .banda__item {
    color: rgba(248, 250, 255, 0.8);
  }

  :global(.bg-dark) .banda__año {
    background: rgba(248, 250, 255, 0.1);
    color: var(--ilhas-grad-start);
  }
</style>
