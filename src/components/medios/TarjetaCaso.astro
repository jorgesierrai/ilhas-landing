---
/**
 * Tarjeta de construcción — el marcado de `.linaje li` en el home y de
 * `.casos li` en /soluciones. Un archivo, dos páginas: las mismas seis
 * capturas `producto-*` se usan en los dos lugares.
 *
 * Se titula por **lo que resuelve**, no por el nombre del producto
 * (`medios/BRIEF-historial.md` §2). La marca y el año van como línea
 * secundaria, y son opcionales de facto: los productos bajo NDA pasan solo
 * el año.
 *
 * Si la ranura de la captura está vacía, la tarjeta se ve solo con texto.
 * Seis nombres no prueban nada; seis pantallas sí (PLAN-MEDIOS.md Parte 2) —
 * pero mientras la pantalla no exista, el texto solo sigue siendo válido.
 *
 * Regla de PLAN-MEDIOS.md §Casos: la captura del producto es tuya; el logo del
 * cliente no. Sin permiso escrito no va el logo — pero la pantalla sí.
 */
import { porId } from "../../data/medios";
import { mostrar } from "../../lib/medios";
import Captura from "./Captura.astro";

interface Props {
  /** Lo que resuelve. Es el titular de la tarjeta. */
  titulo: string;
  /** Qué hizo, en concreto. */
  detalle?: string;
  /** Línea secundaria: marca y año. Solo el año cuando hay NDA. */
  marca?: string;
  capturaId?: string;
}

const { titulo, detalle, marca, capturaId } = Astro.props;

// Falla temprano si alguien escribe mal el id, en vez de callar la captura.
if (capturaId && !porId(capturaId)) {
  throw new Error(
    `TarjetaCaso: no existe la ranura "${capturaId}" en src/data/medios.ts`,
  );
}
---

<li class="tarjeta-caso card hover-lift reveal">
  {
    capturaId && mostrar(capturaId) && (
      <div class="tarjeta-caso__captura">
        <Captura id={capturaId} ancho={640} mostrarPie={false} />
      </div>
    )
  }
  <p class="tarjeta-caso__titulo">{titulo}</p>
  {marca && <p class="tarjeta-caso__marca">{marca}</p>}
  {detalle && <p class="tarjeta-caso__detalle">{detalle}</p>}
</li>

<style>
  .tarjeta-caso {
    list-style: none;
  }

  .tarjeta-caso__captura {
    margin-bottom: 1.25rem;
  }

  .tarjeta-caso__titulo {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    color: var(--ilhas-dark);
  }

  .tarjeta-caso__marca {
    margin-top: 0.25rem;
    font-family: var(--ilhas-font-body);
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-primary);
  }

  .tarjeta-caso__detalle {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    color: var(--ilhas-text);
  }

  /* Sobre sección oscura, el texto se invierte. `.bg-dark .card` de base.css
     ya cambia el fondo de la tarjeta; aquí van los colores del texto. */
  :global(.bg-dark) .tarjeta-caso__titulo {
    color: var(--ilhas-white);
  }

  :global(.bg-dark) .tarjeta-caso__detalle {
    color: rgba(248, 250, 255, 0.7);
  }

  /* --ilhas-primary mide ~3.6:1 sobre --ilhas-dark y falla AA para texto
     pequeño. El cian de marca mide ~13:1. */
  :global(.bg-dark) .tarjeta-caso__marca {
    color: var(--ilhas-grad-start);
  }
</style>
