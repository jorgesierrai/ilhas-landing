---
/**
 * Métrica grande. Usa `--ilhas-fs-stat`, el token de tokens.css que hasta hoy
 * no se usaba en ninguna parte del sitio.
 *
 * Regla 4 de CLAUDE.md: los números se atribuyen, nunca se suman. El contexto
 * de cada Stat dice de quién es el número — el "40 + 12" junto solo existe en
 * /finanzas, que es donde los dos se juntan.
 */
interface Props {
  dato: string;
  contexto: string;
  /**
   * Unidad o símbolo que va pegado al número, en violeta: " MDP", "+", "→".
   * Va DENTRO del número para que no se separe de él al envolver.
   */
  unidad?: string;
  /**
   * "hero": regla vertical a la izquierda y etiqueta en versalitas con
   * tracking. Es el tratamiento del hero del home.
   *
   * Sin props nuevas este componente tiene que renderizar exactamente igual
   * que antes: /nosotros depende de eso (verificado con diff del HTML).
   */
  variante?: "hero";
}

const { dato, contexto, unidad, variante } = Astro.props;
---

<div class:list={["stat", variante && `stat--${variante}`]}>
  <p class="stat__dato">{dato}{unidad && <i class="stat__unidad">{unidad}</i>}</p>
  <p class="stat__contexto">{contexto}</p>
</div>

<style>
  .stat__dato {
    max-width: none;
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: var(--ilhas-fs-stat);
    line-height: 1.1;
    color: var(--ilhas-dark);
  }

  .stat__contexto {
    margin-top: 0.375rem;
    font-family: var(--ilhas-font-body);
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-text);
  }

  :global(.bg-dark) .stat__dato {
    color: var(--ilhas-white);
  }

  :global(.bg-dark) .stat__contexto {
    color: rgba(248, 250, 255, 0.7);
  }

  /* --- variante "hero" --------------------------------------------------- */
  .stat--hero {
    border-left: 2px solid rgba(255, 255, 255, 0.16);
    padding-left: 1rem;
  }

  .stat--hero .stat__dato {
    font-size: clamp(1.45rem, 2.1vw, 1.95rem);
    line-height: 1;
    color: var(--ilhas-white);
    white-space: nowrap;
  }

  .stat--hero .stat__contexto {
    margin-top: 0.3rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* .62 mide 7.7:1 sobre tinta. */
    color: rgba(255, 255, 255, 0.62);
  }

  .stat__unidad {
    font-style: normal;
    color: var(--ilhas-grad-end);
  }
</style>
