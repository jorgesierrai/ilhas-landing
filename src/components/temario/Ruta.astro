---
/**
 * «Qué curso ves en cada fase del Bootcamp» — la ruta sugerida.
 *
 * Los datos viven en `src/lib/temario.ts` (RUTA), porque la exportación del
 * temario no trae el diagrama; los nombres y los conteos sí salen del temario.
 *
 * Dos marcados, uno por tamaño, y nunca los dos a la vez en el árbol de
 * accesibilidad (el que no toca va con `display: none`):
 *
 *   · escritorio: una <table> de verdad, con encabezados de fila y de columna
 *     y `colspan` donde un curso cruza tramos. Es la forma honesta de una
 *     rejilla de dos ejes, y un lector de pantalla la recorre como tal;
 *   · teléfono: una lista por tramo, en orden (Antes → I·L·H → A → S →
 *     Después), porque seis columnas no caben en 390 px.
 */
import type { Temario } from "../../lib/temario";
import { TRAMOS, armarRuta, todosLosCursos } from "../../lib/temario";

interface Props {
  temario: Temario;
}

const { temario } = Astro.props;
const { renglones } = armarRuta(temario);
const ia = todosLosCursos(temario).find((c) => c.id === "ia");

/** Las celdas de un renglón, con los huecos vacíos y los `colspan` resueltos. */
function celdas(r: (typeof renglones)[number]) {
  const out: { texto: string | null; span: number }[] = [];
  for (let i = 0; i < TRAMOS.length; i++) {
    const c = r.celdas.find((x) => x.desde === i);
    if (c) {
      out.push({ texto: c.texto, span: c.hasta - c.desde + 1 });
      i = c.hasta;
    } else {
      out.push({ texto: null, span: 1 });
    }
  }
  return out;
}

const porTramo = TRAMOS.map((tramo, i) => ({
  nombre: tramo.durante ? `Durante el Bootcamp · ${tramo.nombre}` : tramo.nombre,
  cursos: renglones.flatMap((r) =>
    r.celdas
      .filter((c) => c.desde <= i && i <= c.hasta)
      .map((c) => ({ curso: r.nombre, texto: c.texto, eje: r.eje })),
  ),
}));
---

<figure class="ruta">
  <figcaption class="ruta__cabeza">
    <h3 class="ruta__titulo">Qué curso ves en cada fase del Bootcamp</h3>
    {
      ia && (
        <p class="ruta__sub">
          Ruta sugerida. Los niveles 4 y 5 de {ia.nombre} van después, a tu ritmo.
        </p>
      )
    }
  </figcaption>

  <div class="ruta__tabla-caja">
    <table class="ruta__tabla">
      <thead>
        <tr>
          <th scope="col" rowspan="2" class="ruta__esquina">Curso</th>
          <th scope="col" rowspan="2">Antes</th>
          <th scope="colgroup" colspan="3" class="ruta__durante">Durante el Bootcamp</th>
          <th scope="col" rowspan="2">Después</th>
        </tr>
        <tr>
          {
            TRAMOS.filter((t) => t.durante).map((t) => (
              <th scope="col" class="ruta__tramo">{t.nombre}</th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          renglones.map((r) => (
            <tr class:list={[r.eje && "ruta__eje"]}>
              <th scope="row">{r.nombre}</th>
              {celdas(r).map((c) =>
                c.texto ? (
                  <td colspan={c.span > 1 ? c.span : undefined}>
                    <span class="ruta__celda">{c.texto}</span>
                  </td>
                ) : (
                  <td class="ruta__vacio" />
                ),
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <ol class="ruta__lista" role="list">
    {
      porTramo.map((t) => (
        <li class="ruta__paso">
          <p class="ruta__paso-nombre">{t.nombre}</p>
          <ul role="list">
            {t.cursos.map((c) => (
              <li class:list={[c.eje && "ruta__eje"]}>
                <span class="ruta__curso">{c.curso}</span>
                <span class="ruta__celda">{c.texto}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .ruta {
    margin: 2.5rem 0 0;
  }

  .ruta__titulo {
    font-size: 1.25rem;
  }

  .ruta__sub {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
  }

  /* --- Escritorio: la tabla -------------------------------------------------- */
  .ruta__tabla-caja {
    display: none;
    margin-top: 1.25rem;
  }

  .ruta__tabla {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0.375rem;
    margin-inline: -0.375rem;
  }

  .ruta__tabla th,
  .ruta__tabla td {
    padding: 0;
    text-align: left;
    vertical-align: middle;
  }

  .ruta__tabla thead th {
    padding: 0.35rem 0.75rem;
    font-family: var(--ilhas-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ilhas-text);
  }

  .ruta__esquina {
    width: 13rem;
  }

  /* El tramo del Bootcamp lleva su llave: una regla con el degradado de marca
     debajo de «Durante el Bootcamp», que agrupa las tres columnas sin pintar
     ninguna de fondo. */
  .ruta__tabla thead .ruta__durante {
    text-align: center;
    color: var(--ilhas-primary);
    border-bottom: 2px solid transparent;
    border-image: var(--ilhas-gradient-h) 1;
  }

  .ruta__tabla thead .ruta__tramo {
    text-align: center;
    font-family: var(--ilhas-font-display);
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ilhas-dark);
  }

  .ruta__tabla tbody th {
    padding-right: 0.75rem;
    font-family: var(--ilhas-font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--ilhas-dark);
  }

  .ruta__vacio {
    height: 2.75rem;
    border-radius: 0.625rem;
    border: 1px dashed var(--ilhas-gray);
  }

  .ruta__tabla .ruta__celda {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.4rem 0.75rem;
    border-radius: 0.625rem;
    background: var(--ilhas-primary-10);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
    color: var(--ilhas-dark);
  }

  /* El Bootcamp es el eje: sólido. Blanco sobre --ilhas-primary mide 5.3:1. */
  .ruta__tabla .ruta__eje .ruta__celda {
    background: var(--ilhas-primary);
    color: var(--ilhas-white);
    font-family: var(--ilhas-font-display);
    font-size: 1rem;
  }

  .ruta__tabla .ruta__eje th {
    color: var(--ilhas-primary);
  }

  /* --- Teléfono: una lista por tramo ---------------------------------------- */
  .ruta__lista {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .ruta__paso {
    padding: 1rem 1.125rem;
    border-radius: var(--ilhas-radius-card);
    border: 1px solid var(--ilhas-gray);
    background: var(--ilhas-light);
  }

  .ruta__paso-nombre {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ilhas-primary);
  }

  .ruta__paso ul {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .ruta__paso li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.9375rem;
  }

  .ruta__curso {
    font-weight: 600;
    color: var(--ilhas-dark);
  }

  .ruta__lista .ruta__celda {
    flex-shrink: 0;
    font-size: 0.875rem;
    color: var(--ilhas-text);
  }

  .ruta__lista .ruta__eje .ruta__curso,
  .ruta__lista .ruta__eje .ruta__celda {
    color: var(--ilhas-primary);
  }

  @media (min-width: 760px) {
    .ruta__tabla-caja {
      display: block;
    }

    .ruta__lista {
      display: none;
    }
  }
</style>
