---
/**
 * El mapa de la empresa: trece áreas en tres capas.
 *
 * Referencia visual: `medios/mapa-empresa-referencia.html`. Las tres decisiones
 * de diseño de abajo NO son estética — si se cambian, el diagrama deja de
 * argumentar y se vuelve una lista con marcos:
 *
 *   1. Es UN objeto con tres estratos, no tres tarjetas. `border-radius` solo
 *      en las esquinas exteriores (vía `overflow: hidden`) y bordes internos a
 *      hueso. Tres cajas separadas se leen como categorías; un bloque
 *      estratificado se lee como estructura.
 *   2. La barra izquierda gana peso hacia abajo (.28 → .55 → 1). Es el
 *      gradiente de carga. Nadie lo lee conscientemente y todos lo sienten.
 *   3. El cimiento es oscuro y con más aire vertical. El argumento «el
 *      fundamento sostiene» no se escribe: se dibuja. No le quites el fondo
 *      oscuro para que combine.
 *
 * El encabezado (kicker + H2 + lead) lo pone la página, porque cambia en cada
 * una. El componente es solo el diagrama.
 */
import { CAPAS } from "../data/mapa";

interface Props {
  /**
   * "limpio"   — nada resaltado. La universalidad es el argumento (/metodo).
   * "prueba"   — punto morado donde Ilhas ya construyó (/soluciones).
   * "cimiento" — las dos capas de arriba se apagan (/finanzas).
   */
  variante?: "limpio" | "prueba" | "cimiento";
}

const { variante = "limpio" } = Astro.props;
const conPrueba = variante === "prueba";
---

<div class:list={["mapa-empresa", `mapa-empresa--${variante}`, "reveal"]}>
  {
    CAPAS.map((capa) => (
      <div class:list={["capa", `capa--${capa.id}`]}>
        <div class="capa__rotulo">
          <span class="capa__nombre">{capa.nombre}</span>
          <span class="capa__que">{capa.que}</span>
        </div>
        {/* SOLO la variante "prueba" abre las listas. En "limpio" (/metodo) y
            "cimiento" (/finanzas) el área sigue siendo una píldora con su
            nombre: si las 38 líneas se colaran ahí, /metodo —que ya es la
            página más alta del sitio— se volvería inmanejable. */}
        {conPrueba ? (
          <ul class="capa__areas">
            {capa.areas.map((area) => (
              <li class="area">
                <p class="area__nombre">{area.nombre}</p>
                {area.construye && area.construye.length > 0 && (
                  <ul>
                    {area.construye.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <ul class="capa__fichas">
            {capa.areas.map((area) => (
              <li class="ficha">{area.nombre}</li>
            ))}
          </ul>
        )}
      </div>
    ))
  }
</div>

{/* Sin leyenda. La versión del 28 ago 2026 distinguía con punto lo que "ya
    estaba corriendo con un cliente" y explicaba la diferencia abajo. Jorge lo
    corrigió el 30: todo lo listado ya se implementó y corrió con clientes, así
    que la distinción era falsa y la frase que la sostenía sobraba. Quién hizo
    qué lo dice el titular de la sección —"Dónde ya lo hicimos"— y los casos de
    abajo. */}

<style>
  /* Decisión 1: un objeto con tres estratos. El `overflow: hidden` es lo que
     recorta las esquinas de la primera y la última capa contra el radio del
     contenedor. Si lo quitas, vuelven a leerse tres cajas. */
  .mapa-empresa {
    margin-top: 2.5rem;
    border: 1px solid var(--ilhas-gray);
    border-radius: var(--ilhas-radius-card);
    overflow: hidden;
    box-shadow: var(--ilhas-shadow-soft);
    background: var(--ilhas-white);
  }

  .capa {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 1.6rem 1.75rem 1.6rem 2.25rem;
    border-bottom: 1px solid var(--ilhas-gray);
  }

  .capa:last-child {
    border-bottom: none;
  }

  /* Decisión 2: el gradiente de carga. */
  .capa::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--ilhas-primary);
  }

  .capa--externa::before {
    opacity: 0.28;
  }

  .capa--motor::before {
    opacity: 0.55;
  }

  .capa--base::before {
    opacity: 1;
  }

  .capa__nombre {
    display: block;
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--ilhas-dark);
    letter-spacing: var(--ilhas-tracking-display);
    line-height: 1.2;
  }

  /* La referencia usaba #71717f aquí. Ese gris no existe en tokens.css y sobre
     las superficies teñidas de violeta mide 4.41:1 — texto chico por debajo de
     AA. tokens.css es explícito: "para texto pequeño usa --ilhas-text o
     --ilhas-dark sólidos". La jerarquía la hacen el tamaño y el peso. */
  .capa__que {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--ilhas-text);
  }

  .capa__fichas {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-content: center;
  }

  .ficha {
    padding: 0.5rem 1rem;
    border-radius: var(--ilhas-radius-pill);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ilhas-dark);
    background: var(--ilhas-white);
    border: 1px solid var(--ilhas-gray);
    white-space: nowrap;
  }

  .capa--motor {
    background: var(--ilhas-light);
  }

  /* Decisión 3: el cimiento pisa más. Más oscuro y con más aire vertical. */
  .capa--base {
    background: var(--ilhas-dark);
    padding-block: 2rem;
    border-bottom: none;
  }

  .capa--base .capa__nombre {
    color: var(--ilhas-white);
  }

  .capa--base .capa__que {
    /* 7.4:1 sobre tinta. */
    color: rgba(248, 250, 255, 0.62);
  }

  .capa--base .ficha {
    background: rgba(248, 250, 255, 0.08);
    border-color: rgba(248, 250, 255, 0.18);
    color: var(--ilhas-white);
  }

  /* --- variante "prueba" · /soluciones -------------------------------------
     El área deja de ser píldora y pasa a columna con título y lista.

     SIN tarjeta ni borde alrededor: se probó, y las áreas de un solo ítem
     —"Cadena de suministro", "Ejecución y entrega"— quedaban como cajas altas
     medio vacías al lado de las de cinco; el vacío se veía más que el
     contenido. Una regla de 2 px arriba basta para separar una columna de
     otra, y le quita ~100 px al mapa.

     `align-items: start` no es opcional: sin él las columnas se estiran a la
     más alta y vuelve el hueco. */
  .capa__areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.15rem;
    align-items: start;
  }

  .area {
    padding-top: 0.6rem;
    border-top: 2px solid var(--ilhas-gray);
  }

  .capa--base .area {
    border-top-color: rgba(248, 250, 255, 0.18);
  }

  .area__nombre {
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--ilhas-dark);
  }

  .capa--base .area__nombre {
    color: #fff;
  }

  .area ul {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  .area li {
    position: relative;
    padding-left: 0.85rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: #6e6e7a;
  }

  .capa--base .area li {
    color: rgba(248, 250, 255, 0.62);
  }

  .area li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.3rem;
    height: 1.5px;
    border-radius: 1px;
    background: #c3c3ce;
  }

  .capa--base .area li::before {
    background: rgba(248, 250, 255, 0.3);
  }

  /* --- variante "cimiento" · /finanzas ------------------------------------
     Las dos capas de arriba se apagan, pero NO se ocultan: el argumento
     necesita verlas sosteniéndose sobre la que sí importa.

     La referencia lo hacía con `opacity: .42` sobre la capa entera. Medido con
     Lighthouse en /finanzas, eso tira TODO el texto de esas dos capas a
     2.2–2.8:1 — falla AA de verdad, no es un falso positivo, y el checklist de
     esta iteración pide medirlo. Subirle la opacidad hasta que pase exige .75,
     donde ya no se ve apagado y el argumento se pierde igual.

     Así que el apagado se hace donde no hay texto: las capas de arriba pierden
     su superficie y el relleno de sus fichas, y sus barras bajan a .12 y .22.
     Se quedan planas y calladas —que es lo que se buscaba— con el texto en
     --ilhas-text a contraste completo. El cimiento conserva pastillas,
     superficie oscura y halo: sigue siendo el único que pisa. */
  .mapa-empresa--cimiento .capa--externa,
  .mapa-empresa--cimiento .capa--motor {
    background: transparent;
  }

  .mapa-empresa--cimiento .capa--externa::before {
    opacity: 0.12;
  }

  .mapa-empresa--cimiento .capa--motor::before {
    opacity: 0.22;
  }

  .mapa-empresa--cimiento .capa--externa .capa__nombre,
  .mapa-empresa--cimiento .capa--motor .capa__nombre {
    color: var(--ilhas-text);
  }

  /* Siguen siendo fichas, solo calladas: conservan pastilla, borde y padding.
     Quitárselos las convertía en texto corrido y el mapa dejaba de leerse como
     el mismo diagrama de las otras dos variantes. */
  .mapa-empresa--cimiento .capa--externa .ficha,
  .mapa-empresa--cimiento .capa--motor .ficha {
    background: rgba(255, 255, 255, 0.55);
    border-color: rgba(122, 60, 255, 0.14);
    color: var(--ilhas-text);
    font-weight: 400;
  }

  .mapa-empresa--cimiento .capa--base {
    box-shadow: 0 -14px 40px rgba(122, 60, 255, 0.18);
  }

  @media (min-width: 720px) {
    .capa__areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .capa {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      gap: 2rem;
      align-items: center;
    }

    /* Con listas adentro, centrar verticalmente descuadra: la columna de
       rótulos debe empezar arriba, con las áreas. */
    .mapa-empresa--prueba .capa {
      align-items: start;
    }
  }

  @media (min-width: 1000px) {
    .capa__areas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    /* Cinco, no cuatro: el cimiento tiene cinco áreas y con cuatro columnas la
       quinta se cae sola a un segundo renglón y se ve rota. */
    .capa--base .capa__areas {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* En angosto las fichas envuelven en vez de encogerse: cinco fichas apiladas
     de una en una convierten el cimiento en una torre. Bajarles el tipo antes
     de romper la línea es lo que evita que crezca de más. */
  @media (max-width: 899px) {
    .capa {
      padding: 1.35rem 1.25rem 1.35rem 1.6rem;
    }

    .capa--base {
      padding-block: 1.7rem;
    }

    .ficha {
      white-space: normal;
      font-size: 0.875rem;
      padding: 0.4rem 0.8rem;
    }
  }
</style>
