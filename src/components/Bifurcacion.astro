---
// Los dos carriles del método (docs/01-arquitectura.md). El contenido de las
// dos tarjetas es fijo a propósito: son las mismas dos puertas en cualquier
// página que las use (/metodo hoy, / más adelante). Solo el encabezado
// que las presenta cambia según el contexto de la página.
interface Props {
  heading: string;
  lead?: string;
}

const { heading, lead } = Astro.props;
---

<div class="bifurcacion">
  <h2>{heading}</h2>
  {lead && <p class="bifurcacion__lead">{lead}</p>}

  <div class="bifurcacion__cards">
    <a href="/finanzas" class="bifurcacion__card">
      <span class="bifurcacion__label">¿Quieres aprenderlo?</span>
      <span class="bifurcacion__title">Ilhas Finanzas</span>
      <span class="bifurcacion__desc"
        >El método, enseñado — empezando por tus números.</span
      >
      <span class="bifurcacion__link">Conocer Ilhas Finanzas →</span>
    </a>

    <a href="/soluciones" class="bifurcacion__card">
      <span class="bifurcacion__label"
        >¿Quieres que lo implementemos en tu empresa?</span
      >
      <span class="bifurcacion__title">Soluciones</span>
      <span class="bifurcacion__desc"
        >El método, aplicado directo en tu empresa.</span
      >
      <span class="bifurcacion__link">Conocer Soluciones →</span>
    </a>
  </div>
</div>

<style>
  .bifurcacion {
    text-align: center;
  }

  .bifurcacion h2 {
    max-width: 34ch;
    margin-inline: auto;
  }

  .bifurcacion__lead {
    max-width: 60ch;
    margin: 1rem auto 0;
    color: var(--ilhas-text);
  }

  .bifurcacion__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
    text-align: left;
  }

  .bifurcacion__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 2rem;
    background: var(--ilhas-white);
    border: 1px solid var(--ilhas-gray);
    border-radius: var(--ilhas-radius-card);
    box-shadow: var(--ilhas-shadow-soft);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .bifurcacion__card:hover {
    box-shadow: var(--ilhas-shadow-hover);
    transform: translateY(-2px);
    color: inherit;
  }

  .bifurcacion__label {
    font-family: var(--ilhas-font-body);
    font-weight: 500;
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-primary);
  }

  .bifurcacion__title {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--ilhas-dark);
  }

  .bifurcacion__desc {
    font-family: var(--ilhas-font-body);
    color: var(--ilhas-text);
  }

  .bifurcacion__link {
    margin-top: auto;
    padding-top: 1rem;
    font-family: var(--ilhas-font-body);
    font-weight: 600;
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-primary);
  }

  @media (max-width: 640px) {
    .bifurcacion__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
