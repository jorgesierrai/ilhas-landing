---
// Footer del sitio. Repite el menú principal (docs/01-arquitectura.md) y no
// enlaza nada que no exista todavía (nada de "Términos"/"Privacidad" placeholder).
// El año se calcula en build time — sitio 100% estático, cero JS de cliente.
const year = new Date().getFullYear();

const links = [
  { href: "/metodo", label: "El Método" },
  { href: "/finanzas", label: "Ilhas Finanzas" },
  { href: "/soluciones", label: "Soluciones" },
  { href: "/nosotros", label: "Nosotros" },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <a href="/" class="site-footer__brand" aria-label="Ilhas — ir al inicio">
      <img
        src="/assets/logo/logo-mark.svg"
        alt=""
        width="28"
        height="28"
      />
      <span>ilhas</span>
    </a>

    <nav class="site-footer__nav" aria-label="Pie de página">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="site-footer__copy">© {year} Ilhas.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--ilhas-gray);
    background: var(--ilhas-white);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2rem;
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ilhas-dark);
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: var(--ilhas-tracking-wordmark);
  }

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
  }

  .site-footer__nav a {
    font-family: var(--ilhas-font-body);
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-text);
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    color: var(--ilhas-primary);
  }

  .site-footer__copy {
    font-family: var(--ilhas-font-body);
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-text);
    max-width: none;
  }
</style>
