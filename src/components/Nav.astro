---
// Menú del sitio — docs/01-arquitectura.md
// "ilhas    El Método · Ilhas Finanzas · Soluciones · Nosotros        [Hablemos]"
// El wordmark es el link al home (no hay pestaña "Inicio").
// [Hablemos] apunta a /soluciones: es el carril de servicio, el techo de la
// escalera de valor (docs/01-arquitectura.md). No existe agendador propio todavía.
//
// "Nosotros" sigue fuera del menú a propósito: la ruta /nosotros existe pero
// docs/02-paginas.md la marca como bloqueada (falta bio y foto de cada
// participante) y la regla del menú es que cada pestaña es una promesa de que
// hay algo detrás. Se agrega de vuelta cuando la página tenga contenido real.
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { href: "/metodo", label: "El Método" },
  { href: "/finanzas", label: "Ilhas Finanzas" },
  { href: "/soluciones", label: "Soluciones" },
];

const isCurrent = (href: string) =>
  currentPath === href || currentPath === `${href}/`;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Ilhas — ir al inicio">
      <img
        src="/assets/logo/logo.svg"
        alt="Ilhas"
        width="118"
        height="36"
        class="site-header__logo"
      />
    </a>

    <nav class="site-header__nav" aria-label="Principal">
      <ul class="site-header__links">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/soluciones" class="btn btn-primary site-header__cta">
      Hablemos
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(248, 250, 255, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--ilhas-gray);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-header__logo {
    height: 2rem;
    width: auto;
  }

  .site-header__nav {
    flex: 1;
    min-width: 0;
  }

  .site-header__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    list-style: none;
  }

  .site-header__links a {
    display: inline-block;
    padding: 0.25rem 0;
    font-family: var(--ilhas-font-body);
    font-weight: 500;
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-text);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .site-header__links a:hover {
    color: var(--ilhas-dark);
  }

  .site-header__links a[aria-current="page"] {
    color: var(--ilhas-dark);
    border-bottom-color: var(--ilhas-primary);
  }

  .site-header__cta {
    flex-shrink: 0;
    padding: 0.6rem 1.25rem;
  }

  @media (max-width: 720px) {
    .site-header__inner {
      flex-wrap: wrap;
    }

    .site-header__nav {
      order: 3;
      width: 100%;
    }

    .site-header__links {
      justify-content: flex-start;
      gap: 0.5rem 1.25rem;
    }
  }
</style>
