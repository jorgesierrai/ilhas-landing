---
// Menú del sitio — docs/01-arquitectura.md
// "ilhas    El Método · Ilhas Finanzas · Soluciones · Nosotros        [Hablemos]"
// El wordmark es el link al home (no hay pestaña "Inicio").
// [Hablemos] apunta a /soluciones: es el carril de servicio, el techo de la
// escalera de valor (docs/01-arquitectura.md). No existe agendador propio todavía.
interface Props {
  currentPath: string;
  /** Ver `heroOscuro` en Base.astro. */
  heroOscuro?: boolean;
}

const { currentPath, heroOscuro = false } = Astro.props;

const navItems = [
  { href: "/metodo", label: "El Método" },
  { href: "/finanzas", label: "Ilhas Finanzas" },
  { href: "/soluciones", label: "Soluciones" },
  { href: "/nosotros", label: "Nosotros" },
];

const isCurrent = (href: string) =>
  currentPath === href || currentPath === `${href}/`;
---

<header class:list={["site-header", heroOscuro && "site-header--hero-oscuro"]}>
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Ilhas — ir al inicio">
      {/*
        Isotipo como <img> + wordmark como texto, el mismo patrón que el
        footer. logo.svg pesa 19 KB porque trae la fuente incrustada en
        base64: un <img> es un documento aislado y no hereda las fuentes de
        la página, así que el archivo tiene que cargarlas él. Aquí no hace
        falta — Space Grotesk ya está cargada y precargada — y esos 19 KB
        estaban en la ruta crítica de las cinco páginas. El isotipo solo
        pesa 517 B.
      */}
      <img
        src="/assets/logo/logo-mark.svg"
        alt=""
        width="32"
        height="32"
        class="site-header__isotipo"
      />
      <span class="site-header__wordmark">ilhas</span>
    </a>

    <!-- Escritorio: nav normal, siempre visible, oculta por media query en
         móvil. Vive fuera de <details> a propósito — pisar con CSS el
         estado "cerrado" nativo de <details> (sin el atributo open) no es
         confiable entre navegadores; más simple no pelearse con eso. -->
    <nav class="site-header__nav site-header__nav--desktop" aria-label="Principal">
      <ul class="site-header__links">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Móvil: el mismo menú, pero dentro de <details> nativo (cero JS).
         Oculto por completo en escritorio vía media query. -->
    <details class="site-header__toggle">
      <summary class="site-header__burger" aria-label="Abrir menú">
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <nav class="site-header__nav site-header__nav--mobile" aria-label="Principal">
        <ul class="site-header__links">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <a href="/soluciones" class="btn btn-primary site-header__cta">
      Hablemos
    </a>
  </div>
</header>

<style>
  .site-header {
    /* OPACO EN LAS CINCO RUTAS. Decisión de Jorge, 26 ago 2026: el header se
       comporta igual en todo el sitio.

       Antes era translúcido con blur en las páginas de hero claro y opaco solo
       donde el hero era oscuro, así que la barra cambiaba de material según en
       qué página estuvieras. Además el esmerilado era el bug que más veces
       volvió en este repositorio (R1 de AUDITORIA-VISUAL.md, tres
       reapariciones): había que declarar `backdrop-filter` SIN la variante
       -webkit- porque el minificador deduplicaba las dos y se quedaba con la
       prefijada, que Chrome moderno ya no soporta —medido, `CSS.supports` da
       false—; el @supports entraba igual, bajaba la opacidad y el blur nunca
       corría, así que el contenido se veía pasar por debajo del menú.

       Con el fondo opaco esa clase entera de bug deja de existir: no hay
       @supports, no hay prefijo que deduplicar y no hay estado de scroll que
       simular sin JS. */
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--ilhas-light);
    border-bottom: 1px solid var(--ilhas-gray);
  }

  /* Sobre hero oscuro la hairline no separa nada: la frontera ya la hace el
     salto de luminosidad, y el filete gris encima de la tinta se lee como una
     costura suelta. Es lo único que sigue distinguiendo a esas páginas. */
  .site-header--hero-oscuro {
    border-bottom-color: transparent;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    text-decoration: none;
  }

  .site-header__isotipo {
    width: 2rem;
    height: 2rem;
  }

  .site-header__wordmark {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 1.375rem;
    letter-spacing: var(--ilhas-tracking-wordmark);
    color: var(--ilhas-dark);
  }

  .site-header__nav--desktop {
    flex: 1;
    min-width: 0;
  }

  /* Oculto por defecto (mobile-first): solo aparece en el media query de
     escritorio, de vuelta. */
  .site-header__toggle {
    display: none;
  }

  .site-header__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /* Cargado a la izquierda, junto al logo — no centrado en el hueco
       entre logo y CTA, que lo dejaba flotando a la mitad del header. */
    justify-content: flex-start;
    margin-left: 3rem;
    gap: 0.5rem 1.75rem;
    list-style: none;
  }

  .site-header__links a {
    display: inline-block;
    padding: 0.25rem 0;
    font-family: var(--ilhas-font-body);
    font-weight: 500;
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-text);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .site-header__links a:hover {
    color: var(--ilhas-dark);
  }

  .site-header__links a[aria-current="page"] {
    color: var(--ilhas-dark);
    border-bottom-color: var(--ilhas-primary);
  }

  .site-header__cta {
    flex-shrink: 0;
    padding: 0.6rem 1.25rem;
  }

  /* --- Menú móvil: <details> nativo, cero JS. Cerrado, el header ocupa
     una sola fila compacta (logo · hamburguesa · CTA) — no los ~171px/20%
     de un iPhone que el nav envuelto en su propia fila consumía siempre,
     abierto o no. El panel abre como dropdown absoluto: solo empuja el
     contenido de la página mientras el usuario lo tiene abierto. --- */
  @media (max-width: 720px) {
    .site-header__nav--desktop {
      display: none;
    }

    .site-header__toggle {
      display: block;
    }

    .site-header__burger {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: var(--ilhas-radius-pill);
      border: 1px solid var(--ilhas-gray);
      cursor: pointer;
      list-style: none;
    }

    .site-header__burger::-webkit-details-marker {
      display: none;
    }

    .site-header__burger span {
      display: block;
      width: 1.125rem;
      height: 2px;
      background: var(--ilhas-dark);
      border-radius: 1px;
    }

    .site-header__burger span + span {
      margin-top: 4px;
    }

    .site-header__toggle[open] .site-header__burger {
      border-color: var(--ilhas-primary);
    }

    .site-header__nav--mobile {
      /* Relativo a .site-header (position:sticky, el contenedor
         posicionado más cercano) — no a .site-header__toggle, que solo
         mide el ancho del botón hamburguesa. left/right:0 lo estira al
         ancho completo del header en vez de anclarse al botón chico. */
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--ilhas-white);
      border-bottom: 1px solid var(--ilhas-gray);
      box-shadow: var(--ilhas-shadow-soft);
      padding: 0.5rem var(--ilhas-gutter) 1.5rem;
    }

    .site-header__nav--mobile .site-header__links {
      flex-direction: column;
      align-items: flex-start;
      margin-left: 0;
      gap: 1rem;
    }

    .site-header__nav--mobile .site-header__links a {
      font-size: var(--ilhas-fs-body);
    }
  }
</style>
