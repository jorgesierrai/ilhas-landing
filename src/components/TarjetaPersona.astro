---
// Tarjeta individual para /nosotros — docs/02-paginas.md: "tarjetas
// individuales, una por persona, presentadas como participantes de Ilhas,
// no como dúo". Cada persona trae su propia foto, rol y trayectoria; los
// números se pasan ya atribuidos (nunca sumados entre personas).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Enlace } from "../data/personas";
import IconoSocial from "./IconoSocial.astro";

interface Atribucion {
  dato: string;
  contexto: string;
}

interface Props {
  nombre: string;
  rol: string;
  trayectoria: string;
  atribuciones: Atribucion[];
  /** Si no hay foto real todavía, se muestra un avatar con la inicial en
   * vez de un <img> roto — nunca una foto inventada. Recortes de cuerpo
   * completo sangrados por abajo (docs/05-assets.md): el sujeto llega al
   * borde inferior de la imagen fuente, por eso el recorte de la tarjeta
   * ancla arriba y deja que el cuerpo sangre por abajo en vez de flotar
   * centrado con aire debajo. */
  foto?: ImageMetadata;
  fotoAlt?: string;
  /**
   * `true` cuando la tarjeta está arriba del pliegue. Astro pone
   * `loading="lazy"` por defecto, y diferir justo el elemento LCP es el error
   * clásico de rendimiento: en /nosotros la foto del equipo ES el LCP, y con
   * lazy medía 4.1 s.
   */
  prioritaria?: boolean;
  /**
   * Enlaces públicos de la persona. Vienen de `src/data/personas.ts`, nunca
   * escritos a mano en la página: las mismas dos personas salen en /finanzas y
   * en /nosotros, y duplicar URLs es cómo se desincronizan.
   *
   * Opcional: sin ellos la tarjeta se ve exactamente igual que antes, sin
   * separador colgando.
   */
  redes?: Enlace[];
}

const {
  nombre,
  rol,
  trayectoria,
  atribuciones,
  foto,
  fotoAlt,
  prioritaria = false,
  redes,
} = Astro.props;
const inicial = nombre.trim().charAt(0).toUpperCase();
---

<article class="tarjeta-persona hover-lift reveal">
  {
    foto ? (
      <Image
        src={foto}
        alt={fotoAlt ?? nombre}
        width={640}
        class="tarjeta-persona__foto"
        loading={prioritaria ? "eager" : "lazy"}
        fetchpriority={prioritaria ? "high" : undefined}
      />
    ) : (
      <div class="tarjeta-persona__avatar" aria-hidden="true">
        <span>{inicial}</span>
      </div>
    )
  }
  <div class="tarjeta-persona__body">
    <p class="tarjeta-persona__nombre">{nombre}</p>
    <p class="tarjeta-persona__rol">{rol}</p>
    <p class="tarjeta-persona__trayectoria">{trayectoria}</p>
    <ul class="tarjeta-persona__atribuciones">
      {
        atribuciones.map((a) => (
          <li>
            <span class="tarjeta-persona__dato">{a.dato}</span>
            <span class="tarjeta-persona__contexto">{a.contexto}</span>
          </li>
        ))
      }
    </ul>

    {/* Al final de la tarjeta, después de la trayectoria: son el destino, no
        la presentación. El aria-label es obligatorio — un <a> cuyo único
        contenido es un <svg aria-hidden> no tiene nombre accesible y un lector
        de pantalla lo anuncia como "enlace" a secas. */}
    {
      redes && redes.length > 0 && (
        <div class="redes">
          {redes.map((e) => (
            <a
              href={e.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={e.etiqueta}
            >
              <IconoSocial red={e.red} />
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .tarjeta-persona {
    display: flex;
    flex-direction: column;
    background: var(--ilhas-white);
    border: 1px solid var(--ilhas-gray);
    border-radius: var(--ilhas-radius-card);
    overflow: hidden;
    box-shadow: var(--ilhas-shadow-soft);
  }

  .tarjeta-persona__foto {
    /* Sin height fijo en el <Image>: así Astro no pre-recorta el webp a
       una caja centrada en build time (eso decapitaba a Jorge hijo — su
       fuente es mucho más vertical que el 3:4 que pedíamos). El recorte
       real lo hace este CSS, con la cabeza como ancla.
       1:1, no 4:5 — en tarjetas anchas (grid de 2 columnas en un
       contenedor de 1140px) un 4:5 producía fotos de ~700px de alto,
       obligando a hacer scroll para ver la foto completa.
       height:auto explícito — sin esto, el atributo HTML height que
       Astro genera solo (para preservar la proporción real, muy alta,
       de la foto fuente) queda como "definido" y le gana a
       aspect-ratio, así que el navegador ignora por completo el 1:1 y
       usa la altura original del archivo. */
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: 50% 8%;
    background: var(--ilhas-light);
  }

  .tarjeta-persona__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--ilhas-gradient);
  }

  .tarjeta-persona__avatar span {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 4rem;
    color: var(--ilhas-white);
  }

  .tarjeta-persona__body {
    padding: 1.5rem;
  }

  .tarjeta-persona__nombre {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ilhas-dark);
  }

  /* Chip, no solo texto morado: las dos tarjetas dicen "Jorge Sierra" —
     sin un rol que pese visualmente, el ojo lo lee como error de
     copiar-pegar en vez de dos personas distintas. */
  .tarjeta-persona__rol {
    display: inline-block;
    margin-top: 0.625rem;
    padding: 0.25rem 0.75rem;
    background: var(--ilhas-primary-10);
    border-radius: var(--ilhas-radius-pill);
    font-family: var(--ilhas-font-body);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ilhas-primary);
  }

  .tarjeta-persona__trayectoria {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--ilhas-text);
  }

  .tarjeta-persona__atribuciones {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ilhas-gray);
  }

  .tarjeta-persona__atribuciones li {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }

  /* Bajo 480px, "dato" + "contexto" en fila produce sangría colgante fea
     cuando el contexto envuelve a una segunda línea (queda indentado bajo
     el dato, en vez de alinearse al borde). Apilados, cada uno ocupa el
     ancho completo y no hay indentación que corregir. */
  @media (max-width: 480px) {
    .tarjeta-persona__atribuciones li {
      display: block;
    }

    .tarjeta-persona__dato {
      display: block;
    }
  }

  .tarjeta-persona__dato {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    color: var(--ilhas-dark);
    flex-shrink: 0;
  }

  .tarjeta-persona__contexto {
    color: var(--ilhas-text);
  }

  /* Círculos de 2.25 rem (36 px): cumplen el mínimo de área táctil sin
     competir con el CTA de la página. En reposo van gris y borde; el color de
     marca aparece solo al pasar el cursor o al llegar con teclado — cuatro
     logos a todo color en una tarjeta se comen la atención del botón.

     `flex-wrap`: cuatro círculos caben de sobra a 640 px, pero la tarjeta se
     angosta más en pantallas chicas y no deben desbordar. */
  .redes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ilhas-gray);
  }

  .redes a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: #6e6e7a;
    background: transparent;
    border: 1px solid var(--ilhas-gray);
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .redes a:hover,
  .redes a:focus-visible {
    color: var(--ilhas-primary);
    border-color: rgba(122, 60, 255, 0.35);
    background: var(--ilhas-primary-10);
  }

  /* Aparte del :hover y con su propio anillo: sin esto, quien navega con
     teclado ve el cambio de color pero no dónde está parado, y en un círculo
     gris de 36 px eso no se distingue. */
  .redes a:focus-visible {
    outline: 2px solid var(--ilhas-primary);
    outline-offset: 2px;
  }
</style>
