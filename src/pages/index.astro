---
import Base from "../layouts/Base.astro";
import Bifurcacion from "../components/Bifurcacion.astro";
import BandaHilas from "../components/BandaHilas.astro";
import TarjetaCaso from "../components/medios/TarjetaCaso.astro";
import Stat from "../components/medios/Stat.astro";
import { mostrar } from "../lib/medios";
import { porId } from "../data/medios";
import { PRODUCTOS } from "../data/productos";

// El hero lo ocupa el LOOP desde el 31 ago 2026 (iteración 19), no la foto de
// Talent Land. Va con rutas absolutas de public/ y no por `astro:assets`: los
// loops no pasan por el optimizador. La ranura sigue siendo la fuente de verdad
// de si el medio existe o no.
const LOOP = "/assets/video/home-hero-loop";

// El flujo que va debajo del video. A tamaño de hero la hoja de cálculo es
// ilegible: el loop enseña QUE algo corre, pero no QUÉ. Esto lo nombra.
//
// `agente: true` distingue las dos piezas que Ilhas construye de los tres
// documentos que entran y salen. Ésa es la estructura real —documento, agente,
// documento, agente, documento— y es lo que hace que se lea de un vistazo sin
// tener que leerlo.
//
// Los rótulos son de Jorge (31 ago 2026) y van literales.
const flujo = [
  { paso: "Planos" },
  { paso: "Agente Despiece", agente: true },
  { paso: "Cotización" },
  { paso: "Agente Ahorro", agente: true },
  { paso: "Reporte Ingresos Optimizados" },
];

const pasos = [
  { letra: "I", paso: "Identificar", linea: "Cómo se mueve el dinero, dónde se fuga y desde qué número mides." },
  { letra: "L", paso: "Levantamiento", linea: "Tus datos en un solo lugar, y el estándar de los mejores." },
  { letra: "H", paso: "Hilar", linea: "Costos, precios y márgenes en un solo criterio." },
  { letra: "A", paso: "Accionar", linea: "Decides con números, no con intuición." },
  { letra: "S", paso: "Sistematizar", linea: "La IA como tu equipo, con alertas y mantenimiento." },
];

// §02 · El mapa: lo que reportan que falló → el paso que lo cubre.
// Las cifras y las fuentes van LITERALES (prompts/iteracion-4-hueco.md §2).
// MIT va sin liga a propósito: el reporte circuló como PDF de MIT NANDA y no
// tiene URL pública estable en mit.edu. Se cita por nombre; no se liga un
// re-host de terceros.
const GARTNER =
  "https://www.gartner.com/en/newsroom/press-releases/2024-07-29-gartner-predicts-30-percent-of-generative-ai-projects-will-be-abandoned-after-proof-of-concept-by-end-of-2025";
const fallas: Record<string, { texto: string; fuente: string; url?: string }> = {
  I: {
    texto: "No había línea base: nadie sabía qué medir antes de empezar.",
    fuente: "MIT · The GenAI Divide, 2025",
  },
  L: {
    texto:
      "Datos sin preparar: solo el 24% los tiene limpios, centralizados y en tiempo real.",
    fuente: "Cisco AI Readiness Index 2025",
    url: "https://www.cisco.com/c/m/en_us/solutions/ai/readiness-index.html",
  },
  H: {
    texto:
      "Valor de negocio poco claro: el proyecto nunca se amarró a la operación.",
    fuente: "Gartner",
    url: GARTNER,
  },
  A: {
    texto: "Los costos se dispararon por encima del retorno esperado.",
    fuente: "Gartner",
    url: GARTNER,
  },
  S: {
    texto: "Abandono después del piloto: 30% no llega a producción.",
    fuente: "Gartner · pronóstico 2024",
    url: GARTNER,
  },
};

// La cita va en TEXTO, no el video: el home tiene ocho segundos y el clip
// completo vive en /soluciones, que es a donde manda la liga.
const testimonio = porId("soluciones-testimonio-oncologia")!.atribucion!;

// Métricas del hero. El copy es de Jorge y va literal (brief de la
// iteración 3): número, unidad en violeta, y etiqueta en versalitas.
const kpis = [
  { dato: "+1,000", unidad: " MDP", contexto: "al mes, volumen respaldado" },
  { dato: "6", unidad: "+", contexto: "startups · infraestructura creada" },
  { dato: "2016", unidad: "→", contexto: "desarrollando IA" },
];

---

<Base
  title="Ilhas"
  description="El método con el que se construyen productos que mueven millones, apuntado a tu trabajo. Aprende Ilhas, o deja que lo implementemos."
  heroOscuro
>
  <article>
    {/* 01 · HERO — el loop de Kinzal, ENTERO.
         Referencia: medios/hero-referencia.html (variante F, la buena).

         Reescrito el 31 ago 2026, después de que la iteración 19 ya se había
         corrido una vez con el video de Morgan. Aquel necesitaba desenfoque
         para ser publicable —y un desenfoque visible en el hero anuncia que
         ahí había algo escondido—, nombraba a la clínica en pantalla y
         enseñaba el total de un ciclo de quimioterapia. Éste es de Kinzal,
         empresa de Jorge, y no necesita taparse nada.

         DEJA DE RECORTAR. Antes la caja medía 56%×100% y el video la llenaba
         con `object-fit: cover`, o sea recortando por los lados: se veía la
         cotización y se perdía la mitad de la demo. Ahora la caja lleva la
         relación de aspecto del video y va con `contain`, así que se ve
         entero: los planos cargando, la solicitud, el generador armando la
         cotización y el cierre en el bloque de ahorro.

         Y DEJA DE SER UNA SOLA CAPA. El velo existía para que el texto se
         leyera ENCIMA de la foto; ahora el texto y el video no se tocan, así
         que lo único que hacía era apagar la captura. Se fue. */}
    <section class="hero">
      <div class="hero__inner">
        <div class="hero__resplandor" aria-hidden="true"></div>

        <div class="hero__texto">
          {/* Titular elegido por Jorge el 31 ago 2026. Va literal. */}
          <h1>
            Tu primer proceso corriendo <span class="text-gradient">con IA</span>
            .
          </h1>

          {/* ⚠️ SUBTÍTULO PENDIENTE DEL VISTO BUENO DE JORGE. Es una propuesta,
              no copy aprobado: el anterior hablaba de infraestructura crítica y
              empresas unicornio, que era el pie del titular viejo, y no podía
              quedarse. Está puesto para que la página no quede coja. */}
          <p class="hero__lead">
            Lo que hoy le toma horas a alguien de tu equipo, hecho por un
            sistema que tú entiendes y que corre solo.
          </p>

          <div class="hero__ctas">
            <a href="/finanzas" class="btn btn-primary">Quiero aprenderlo</a>
            <a href="/soluciones" class="btn btn-ghost-oscuro">
              Quiero implementarlo
            </a>
          </div>
        </div>

        {/* EL MEDIO VA DESPUÉS DEL TEXTO EN EL DOM, y no por estética. En
            escritorio es `position:absolute` y el orden da igual; en móvil pasa
            a `relative` y el orden ES el que manda: con el medio primero, el
            video salía ARRIBA del titular. El padre no es flex, así que `order`
            no lo arregla — tiene que ser el DOM.

            Los cuatro atributos del <video> son obligatorios y ninguno sobra:
            `muted` sin `autoplay` no arranca; `autoplay` sin `muted` lo bloquea
            el navegador; sin `playsinline` iOS lo abre a pantalla completa; sin
            `loop` se congela a los nueve segundos.

            UN SOLO <source>, mp4. El webm se cayó a propósito: con este
            contenido —texto de UI y tablas densas— VP9 pierde contra H.264, y
            salía en 996 KB y peor de calidad contra 842 KB del mp4. Un formato
            más grande y más feo, servido primero, es peor que no tenerlo.

            `aria-hidden` va en el CONTENEDOR, no en el <video>: el loop es
            decorativo —la ranura tiene alt: ""— y así el lector de pantalla se
            salta también el póster de respaldo.

            Nada de loading="lazy" ni preload="none": esto es el LCP. */}
        {
          mostrar("home-hero-loop") && (
            <div class="hero__demo">
            <div class="hero__medio" aria-hidden="true">
              <video
                poster={`${LOOP}.jpg`}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                width="1280"
                height="604"
              >
                <source src={`${LOOP}.mp4`} type="video/mp4" />
              </video>
              <img
                class="hero__poster"
                src={`${LOOP}.jpg`}
                alt=""
                width="1280"
                height="604"
              />
            </div>

            {/* El flujo NO va aria-hidden: es contenido, no decoración — es lo
                único que explica qué está pasando en el video. Va en <ol>
                porque es una secuencia y el orden es el dato.

                La flecha cuelga del ::before del paso SIGUIENTE y no del
                anterior. Con cinco pasos y estos rótulos la fila no cabe en una
                línea a ningún ancho, así que va a envolver; poniéndola así, la
                línea nueva ARRANCA con flecha y sigue leyéndose como flujo. Al
                revés dejaba una flecha huérfana colgando al final del renglón,
                apuntando a nada. */}
            <ol class="flujo">
              {
                flujo.map((f) => (
                  <li class:list={["flujo__paso", f.agente && "flujo__paso--agente"]}>
                    <span class="flujo__et">{f.paso}</span>
                  </li>
                ))
              }
            </ol>
            </div>
          )
        }

        {/* Los KPI van a todo lo ancho, POR DEBAJO de los dos. Se probó el
            video centrado en vertical y «2016→» quedaba encima del panel de
            KINZAL. */}
        <div class="hero__kpis">
          {
            kpis.map((k) => (
              <Stat
                dato={k.dato}
                unidad={k.unidad}
                contexto={k.contexto}
                variante="hero"
              />
            ))
          }
        </div>
      </div>
    </section>


    {/* LA BARRA DE STATS · 31 ago 2026.
        Ocupa exactamente el hueco que deja la banda de autoridad al salir, así
        que el home no crece por meterla.

        Va PEGADA al hero: sin `section-y` y sin margen. Los dos bloques
        oscuros tienen que leerse como uno solo y el corte a blanco pasa una
        sola vez, abajo. Se probó en tarjeta blanca flotante y obligaba a un
        segundo corte de fondo —oscuro, blanco, oscuro, blanco— en 200px.

        El copy es de Jorge y va LITERAL. Sin asteriscos, sin notas al pie y
        sin fuente: eso es decisión suya, no mía.

        `aria-label` porque la sección no tiene encabezado; sin él es una
        región anónima en el árbol de accesibilidad.

        La banda de autoridad se fue de aquí y no se pierde nada: los tres
        hitos que resumía —nov 2017, ene 2018, abr 2018— son los tres momentos
        que la iteración 18 desplegó completos en /nosotros § En público, con
        sus medios y sus pies. Era el índice de una sección que entonces no
        existía. El COMPONENTE se queda en el repo. */}
    <section class="stats" aria-label="Resultados del método">
      <div class="stats__reja">
        <div class="stats__uno">
          {/* El signo es × U+00D7, el de MULTIPLICACIÓN — no una equis
              minúscula, que en la tipografía de display se ve torcida al lado
              de la cifra. Va literal, como los acentos del resto del sitio. */}
          <span class="stats__cifra">12×</span>
          <span class="stats__pie">más rápido</span>
        </div>
        <div class="stats__uno">
          <span class="stats__cifra">8×</span>
          <span class="stats__pie">menos costo que humanos</span>
        </div>
        <div class="stats__uno">
          <span class="stats__cifra">6-12%</span>
          <span class="stats__pie">más ingresos</span>
        </div>
      </div>
    </section>

    {/* La banda Ilhas → Hilas. El hero NO se toca.
        Aquí solo se ve el juego; se explica en /metodo §09. */}
    <BandaHilas />

    {/* 02 · El hueco — se rehizo el 25 ago 2026 y SE COMIÓ a la vieja §03.
        Referencia: medios/hueco-referencia.html, opción 3 (#sinbanda).

        Por qué no hay una §03 con los cinco pasos otra vez: el mapa ya
        muestra las cinco letras, y repetirlas 400 px abajo no aporta. Es la
        salida (a) que pedía AUDITORIA-VISUAL.md — "el hueco es el setup del
        método, no una sección aparte".

        El costo está medido y aprobado: §02+§03 medían 537 px y esta sección
        mide ~1,637 px, así que la bifurcación se recorre de 1,279 a ~2,379 px.
        Es un intercambio consciente. NO lo "arregles" partiendo esto en dos.

        Las líneas de cada paso salen del mismo array `pasos` que usa la
        página: así el mapa y /metodo no pueden desincronizarse. */}
    <section class="section-y bg-white">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">El hueco</p>
          <h2>
            El 95% de los proyectos de IA no muestra retorno medible. Y no es
            la tecnología.
          </h2>
        </div>

        <p class="causa reveal">
          MIT analizó <strong>300 proyectos de IA empresarial</strong>: el 95%
          no mostró retorno financiero medible en seis meses. No fallaron los
          modelos, falló lo de antes. Si no mediste cómo estaba el proceso al
          arrancar, no tienes contra qué comparar el resultado. <strong>La IA amplifica lo que le metes.</strong> Si
          el fundamento está flojo, amplifica eso.
        </p>

        <div class="mapa mapa--espina reveal">
          <div class="mapa__encabezados" aria-hidden="true">
            <span>Lo que reportan que falló</span>
            <span>La parte del Método que la cubre</span>
          </div>

          {
            pasos.map((p) => (
              <div class="mapa__fila">
                <div class="falla">
                  {fallas[p.letra].texto}
                  <cite>
                    {fallas[p.letra].url ? (
                      <a
                        href={fallas[p.letra].url}
                        target="_blank"
                        rel="noopener"
                      >
                        {fallas[p.letra].fuente}
                      </a>
                    ) : (
                      fallas[p.letra].fuente
                    )}
                  </cite>
                </div>
                <div class="paso">
                  <span class="paso__letra">{p.letra}</span>
                  <span class="paso__nombre">{p.paso}</span>
                  <span class="paso__linea">{p.linea}</span>
                </div>
              </div>
            ))
          }

          {/* C · El remate. Al comerse §03, el home perdió el único lugar
              donde el acrónimo se deletreaba, así que el visitante veía cinco
              círculos con letras sueltas sin conectar que arman el nombre de
              la casa. Va después de la quinta fila, cuando ya las vio pasar:
              la línea nada más cierra la puerta. La segunda frase sale de
              docs/01-arquitectura.md, no es invención. */}
          <p class="remate">
            Cinco pasos, cinco letras: <em>I·L·H·A·S</em>.<br />
            El método es el barco; las islas son a dónde lo apuntas.
          </p>

          <p class="mapa__link">
            <a href="/metodo">Conoce el método completo →</a>
          </p>
        </div>

        <figure class="prueba reveal">
          <blockquote>
            «Algo que hacíamos en tres, cuatro horas —o hasta un día entero—
            ahora toma <em>veinte minutos</em>.»
          </blockquote>
          <div class="prueba__pie">
            <figcaption>
              <b>{testimonio.nombre}</b>
              {testimonio.rol} · {testimonio.empresa}
            </figcaption>
            <p class="prueba__link">
              <a href="/soluciones">Ver los casos completos →</a>
            </p>
          </div>
        </figure>
      </div>
    </section>

    <!-- 04 · La bifurcación — el bloque más importante del sitio -->
    {/* Va con lavado de marca, no en blanco: §02 arriba también es .bg-white y
        .bg-white + .bg-white colapsa el padding, así que la bifurcación se leía
        como continuación del hueco en vez de como sección nueva. Tampoco puede
        ir oscura — §05 (el linaje) ya lo es y las dos se fundirían. Ver la nota
        de .bg-lavado en src/styles/base.css.

        El H2 dice "ya sabes qué tiene que pasar": eso SOLO es verdad porque §02
        acaba de explicarlo. Si §02 se recorta, esta frase se queda sin piso. */}
    <section class="section-y bg-lavado">
      <div class="container">
        <Bifurcacion
          kicker="La bifurcación"
          heading="Ya sabes qué tiene que pasar. Falta decidir quién lo hace."
          lead="El mismo método en los dos carriles. Lo único que cambia son las manos."
          prominent
        />
      </div>
    </section>

    <!-- 05 · Prueba — el linaje -->
    <section class="section-y bg-dark">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">De dónde sale el método</p>
          <h2>Esto ya está corriendo.</h2>
        </div>

        <ul class="linaje">
          {
            PRODUCTOS.map((p) => (
              <TarjetaCaso
                titulo={p.titulo}
                detalle={p.detalle}
                marca={p.marca}
                capturaId={p.capturaId}
                recorte={p.recorte}
              />
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 07 · Cierre -->
    <section class="section-y bg-white">
      <div class="container prose prose-center cierre reveal">
        <h2>¿Todavía no sabes cuál es tu carril?</h2>
        <p>Conoce el método completo antes de decidir.</p>
        <a href="/metodo" class="btn btn-primary">Conocer el método</a>
      </div>
    </section>
  </article>
</Base>

<style>
  /* La sección que sigue a la banda Ilhas→Hilas arranca aún más arriba: la
     banda ya trae sus 2rem de padding y cierra con una regla, así que la
     frontera visual ya está hecha y el padding completo solo agrega blanco
     muerto. Es el hueco que Jorge señaló.

     `.hilas` va en :global() porque ese elemento vive en BandaHilas.astro y
     lleva SU hash de scope, no el de esta página: con `.hilas + .section-y` a
     secas, Astro compila `.hilas[cid-del-home]` y la regla no le pega a nada.
     Se probó y no aplicaba — la sección seguía en 72px. */
  :global(.hilas) + .section-y {
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* ===================================================================
     01 · HERO — el loop de Kinzal, entero
     Referencia: medios/hero-referencia.html, variante F.
     ===================================================================
     Se probaron cinco variantes. Lo que se aprendió:
       · Centrado en vertical choca con la fila de KPI.
       · Achicando el cuadro a 52% el panel de KINZAL se vuelve ilegible y la
         demo deja de probar nada. Por eso 58% y no menos.
       · El velo del hero viejo apagaba la captura: existía para que el texto
         se leyera ENCIMA de la foto, y ahora no se tocan.

     Deja de ser un flex centrado de 620px de alto y pasa a bloque con
     padding: columna de texto a la izquierda, el cuadro completo a la derecha
     sangrando hasta el canto del navegador, y los KPI a todo lo ancho debajo
     de los dos. */
  .hero {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--ilhas-dark);
    padding-block: clamp(2.75rem, 5vw, 4.25rem) clamp(2.25rem, 4vw, 3.25rem);
  }

  .hero__inner {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: var(--ilhas-container);
    margin-inline: auto;
    padding-inline: var(--ilhas-gutter);
  }

  /* Resplandor detrás del cuadro. Decorativo y sin eventos: solo levanta la
     esquina para que el video no aterrice sobre tinta plana. */
  .hero__resplandor {
    position: absolute;
    z-index: 0;
    right: -10%;
    top: -10%;
    width: 74%;
    height: 86%;
    pointer-events: none;
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgba(122, 60, 255, 0.32),
      transparent 70%
    );
  }

  .hero__texto {
    position: relative;
    z-index: 3;
    max-width: 38%;
    min-height: 21rem;
  }

  /* SANGRA, PERO NO RECORTA. El `right` negativo compensa el gutter del
     contenedor, así que el canto derecho del cuadro cae en el borde del
     navegador y no en el del contenedor — que es lo que Jorge quería conservar
     del look anterior. Y la caja lleva la RELACIÓN DE ASPECTO del video, así
     que no hay nada que recortar: con `cover` se perdían los planos cargando,
     que es justo lo que pidió que se viera. */
  .hero__demo {
    position: absolute;
    right: calc(-1 * var(--ilhas-gutter));
    top: 0.5rem;
    z-index: 1;
    width: 58%;
  }

  .hero__medio {
    aspect-ratio: 1280 / 604;
    border-radius: 12px 0 0 12px;
    overflow: hidden;
    border: 1px solid rgba(248, 250, 255, 0.14);
    border-right: 0;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.95);
  }

  /* ---- el flujo, debajo del cuadro ----
     Cabe en el aire que ya había entre el video y la fila de KPI (94 px a
     1440), así que el hero no crece en escritorio por ponerlo.

     El padding-right compensa el sangrado: el cuadro se sale hasta el canto,
     pero el texto no debe irse con él o el último paso queda cortado. */
  .flujo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.6rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* El padding solo hace falta cuando el cuadro DE VERDAD se sale del
     viewport, que es a 1236 y abajo: ahí el `right` negativo lo saca del canto
     y sin esto el último paso se cortaría. A 1440 el cuadro termina 102 px
     antes del borde, así que el padding solo estaba robando ancho — y era
     justo lo que empujaba el último paso a un segundo renglón. */
  @media (max-width: 1236px) {
    .flujo {
      padding-right: var(--ilhas-gutter);
    }
  }

  .flujo__paso {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    /* .68 mide 8.7:1 sobre tinta. */
    color: rgba(248, 250, 255, 0.68);
    white-space: nowrap;
  }

  /* La flecha va en el paso SIGUIENTE, no en el anterior: al envolver, el
     renglón nuevo arranca con ella en vez de dejarla huérfana al final del
     anterior apuntando a nada. */
  .flujo__paso + .flujo__paso::before {
    content: "→";
    /* .42 sobre tinta mide 4.0:1. No es texto que haya que leer —la secuencia
       ya la da el <ol>— así que la regla que aplica es 1.4.11 (3:1), y la pasa.
       Se deja por debajo de los rótulos a propósito: la flecha conecta, no
       compite. */
    color: rgba(248, 250, 255, 0.42);
    font-size: 0.9375rem;
  }

  /* Los dos agentes son lo que Ilhas construye, y por eso son los únicos que
     llevan caja y color de marca. Los tres documentos van como texto pelón:
     documento → AGENTE → documento → AGENTE → documento se lee de un vistazo
     sin tener que leerlo.

     La píldora cuelga del <span> y NO del <li>. Con el estilo en el <li>, la
     flecha del ::before quedaba DENTRO de la caja —«[→ Agente Despiece]»— y
     parecía parte del nombre del agente en vez del conector entre pasos. */
  .flujo__paso--agente .flujo__et {
