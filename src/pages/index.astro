---
import Base from "../layouts/Base.astro";
import Bifurcacion from "../components/Bifurcacion.astro";

const pasos = [
  { letra: "I", paso: "Identificar", linea: "Cómo se mueve el dinero y dónde se fuga." },
  { letra: "L", paso: "Levantamiento", linea: "Traes el estándar de los mejores." },
  { letra: "H", paso: "Hilar", linea: "Costos, precios y márgenes en un solo criterio." },
  { letra: "A", paso: "Accionar", linea: "Decides con números, no con intuición." },
  { letra: "S", paso: "Sistematizar", linea: "La IA como tu equipo, con alertas automáticas." },
];

const linaje = [
  {
    producto: "Stampay",
    resolvio:
      "Conciliación bancaria automática. Eliminó un proceso manual de 2–3 días por cierre.",
  },
  {
    producto: "Nomcont",
    resolvio:
      "Reemplazó hojas de cálculo dispersas por un ledger estructurado y auditable.",
  },
  {
    producto: "Cometa · AI Data Concierge",
    resolvio:
      "Preguntas en lenguaje natural sobre tu base financiera, respuesta al instante.",
  },
  {
    producto: "Nomada",
    resolvio: "HRIS y nómina construidos desde cero.",
  },
  {
    producto: "Paystand",
    resolvio: "AR/AP en pagos B2B: dos productos construidos de cero a uno.",
  },
  {
    producto: "Factumizer",
    resolvio:
      "Automatización de facturas CFDI, de idea a producción en menos de una semana.",
  },
];
---

<Base
  title="Ilhas"
  description="El método con el que se construyen productos que mueven millones, apuntado a tu trabajo. Aprende Ilhas, o deja que lo implementemos."
>
  <article>
    <!-- 01 · Hero — la línea de identidad -->
    <section class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="container prose hero__content">
        <h1>
          El método con el que se construyen productos que mueven millones,
          apuntado a tu trabajo.
        </h1>
        <p class="lead">
          Dos maneras de recibirlo: que te lo enseñemos, o que te lo hagamos.
        </p>
        <div class="hero__ctas">
          <a href="/finanzas">Quiero aprenderlo →</a>
          <a href="/soluciones">Quiero implementarlo →</a>
        </div>
      </div>
    </section>

    <!-- 02 · El hueco -->
    <section class="section-y-sm bg-white">
      <div class="container prose">
        <p class="kicker">El hueco</p>
        <h2>El 95% de los proyectos de IA fracasa — y no es la tecnología.</h2>
      </div>
    </section>

    <!-- 03 · El método en cinco pasos, versión corta -->
    <section class="section-y-sm">
      <div class="container">
        <div class="prose">
          <p class="kicker">El método, en corto</p>
          <h2>Cinco pasos: I·L·H·A·S.</h2>
        </div>

        <ol class="pasos-corto">
          {
            pasos.map((p) => (
              <li>
                <span class="pasos-corto__letra">{p.letra}</span>
                <span class="pasos-corto__paso">{p.paso}</span>
                <span class="pasos-corto__linea">{p.linea}</span>
              </li>
            ))
          }
        </ol>

        <p class="pasos-corto__link">
          <a href="/metodo">Conoce el método completo →</a>
        </p>
      </div>
    </section>

    <!-- 04 · La bifurcación — el bloque más importante del sitio -->
    <section class="bifurcacion-section bg-white">
      <div class="container">
        <Bifurcacion
          heading="¿Quieres aprenderlo, o quieres que lo implementemos?"
          prominent
        />
      </div>
    </section>

    <!-- 05 · Prueba — el linaje -->
    <section class="section-y">
      <div class="container">
        <div class="prose">
          <p class="kicker">De dónde sale el método</p>
          <h2>No es teoría. Es lo que ya construimos.</h2>
        </div>

        <ul class="linaje">
          {
            linaje.map((item) => (
              <li>
                <p class="linaje__producto">{item.producto}</p>
                <p class="linaje__resolvio">{item.resolvio}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 07 · Cierre -->
    <section class="section-y bg-white">
      <div class="container prose cierre">
        <h2>¿Todavía no sabes cuál es tu carril?</h2>
        <p>Conoce el método completo antes de decidir.</p>
        <a href="/metodo" class="btn btn-primary">Conocer el método</a>
      </div>
    </section>
  </article>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 32rem;
    height: 32rem;
    background: var(--ilhas-gradient);
    opacity: 0.18;
    filter: blur(90px);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero h1 {
    max-width: 52ch;
    font-size: clamp(2.125rem, 3.5vw, 3rem);
  }

  .hero .lead {
    margin-top: 1rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  .hero__ctas a {
    font-family: var(--ilhas-font-body);
    font-weight: 600;
    font-size: var(--ilhas-fs-small);
    text-decoration: none;
  }

  section > .container.prose > p:not(.kicker):not(.lead) {
    margin-top: 1.25rem;
  }

  /* --- 03 · pasos versión corta --- */
  .pasos-corto {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .pasos-corto li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .pasos-corto__letra {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--ilhas-primary);
    color: var(--ilhas-white);
    font-family: var(--ilhas-font-display);
    font-size: 0.8125rem;
    flex-shrink: 0;
  }

  .pasos-corto__paso {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    color: var(--ilhas-dark);
  }

  .pasos-corto__linea {
    color: var(--ilhas-text);
  }

  .pasos-corto__link {
    margin-top: 1.5rem;
  }

  .pasos-corto__link a {
    font-family: var(--ilhas-font-body);
    font-weight: 600;
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-primary);
    text-decoration: none;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .pasos-corto li {
      display: grid;
      grid-template-columns: 2rem 9rem 1fr;
      align-items: center;
    }
  }

  /* En desktop ancho, los cinco pasos caben en una sola fila: convierte
     una lista de 5 renglones apilados en una tira horizontal, para que
     la bifurcación (bloque 04) llegue más cerca del pliegue. */
  @media (min-width: 1024px) {
    .pasos-corto {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .pasos-corto li {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
    }

    .pasos-corto__linea {
      font-size: 0.875rem;
    }
  }

  /* --- 05 · linaje --- */
  .linaje {
    list-style: none;
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .linaje li {
    padding: 1.5rem;
    background: var(--ilhas-light);
    border: 1px solid var(--ilhas-gray);
    border-radius: var(--ilhas-radius-card);
  }

  .linaje__producto {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    color: var(--ilhas-dark);
  }

  .linaje__resolvio {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    color: var(--ilhas-text);
  }

  @media (min-width: 640px) {
    .linaje {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .linaje {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- 04 · bifurcación: padding-top reducido a propósito (el bloque
     tiene que llegar cerca del pliegue), padding-bottom completo (sigue
     siendo el bloque más importante del sitio, no se achica). --- */
  .bifurcacion-section {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: var(--ilhas-section-y);
  }

  /* --- 07 · cierre --- */
  .cierre {
    text-align: center;
  }

  .cierre h2 {
    margin-inline: auto;
  }

  .cierre p {
    margin-inline: auto;
  }

  .cierre .btn {
    margin-top: 1.75rem;
  }
</style>
