---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Bifurcacion from "../components/Bifurcacion.astro";
import BandaAutoridad from "../components/medios/BandaAutoridad.astro";
import Captura from "../components/medios/Captura.astro";
import Icono from "../components/medios/Icono.astro";
import Loop from "../components/medios/Loop.astro";
import TarjetaCaso from "../components/medios/TarjetaCaso.astro";
import { mostrar } from "../lib/medios";
import { PRODUCTOS } from "../data/productos";
import dashboardIcon from "../assets/icons/dashboard.png";

const pasos = [
  { letra: "I", paso: "Identificar", linea: "Cómo se mueve el dinero y dónde se fuga.", icono: "icono-paso-i" },
  { letra: "L", paso: "Levantamiento", linea: "Traes el estándar de los mejores.", icono: "icono-paso-l" },
  { letra: "H", paso: "Hilar", linea: "Costos, precios y márgenes en un solo criterio.", icono: "icono-paso-h" },
  { letra: "A", paso: "Accionar", linea: "Decides con números, no con intuición.", icono: "icono-paso-a" },
  { letra: "S", paso: "Sistematizar", linea: "La IA como tu equipo, con alertas automáticas.", icono: "icono-paso-s" },
];

const capturasMercado = ["home-mercado-01", "home-mercado-02", "home-mercado-03"];

const stats = [
  { dato: "6", contexto: "productos financieros construidos de cero a uno" },
  { dato: "+1,000 MDP/mes", contexto: "procesados por productos que Jorge (hijo) ha liderado" },
  { dato: "+2,000 empresas", contexto: "asesoradas en LATAM por Jorge (papá)" },
];

---

<Base
  title="Ilhas"
  description="El método con el que se construyen productos que mueven millones, apuntado a tu trabajo. Aprende Ilhas, o deja que lo implementemos."
>
  <article>
    <!-- 01 · Hero — la línea de identidad -->
    <section class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="container hero-split">
        <div class="hero__content">
          <h1>
            El método con el que se construyen productos que mueven{" "}
            <span class="text-gradient">millones</span>, apuntado a tu
            trabajo.
          </h1>
          <p class="lead">
            Dos maneras de recibirlo: que te lo enseñemos, o que te lo
            hagamos.
          </p>
          <div class="hero__ctas">
            <a href="/finanzas" class="btn btn-primary">Quiero aprenderlo</a>
            <a href="/soluciones" class="btn btn-ghost"
              >Quiero implementarlo</a
            >
          </div>
          <p class="hero__stats">
            {
              stats.map((s, i) => (
                <>
                  {i > 0 && <span class="hero__stats-sep" aria-hidden="true">·</span>}
                  <span class="hero__stats-dato">{s.dato}</span>{" "}
                  <span class="hero__stats-contexto">{s.contexto}</span>
                </>
              ))
            }
          </p>
        </div>
        <div class="hero-split__visual" aria-hidden="true">
          <Loop id="home-hero-loop" ratio="1 / 1">
            <Image src={dashboardIcon} alt="" width="380" height="380" />
          </Loop>
        </div>
      </div>
    </section>

    {/* Banda de autoridad — medios/BRIEF-historial.md §3. Tira delgada, no
        una sección, y SIN los tres videos: el home tiene ocho segundos, y
        meterle la prueba completa lo mata y hace que no se vea ninguno. La
        banda vende en dos segundos y manda a /nosotros a quien la quiera. */}
    <div class="container banda-autoridad">
      <BandaAutoridad
        titulo="Hablando de IA en público desde 2017."
        items={[
          { año: "nov 2017", etiqueta: "conferencia" },
          { año: "ene 2018", etiqueta: "radio nacional" },
          { año: "abr 2018", etiqueta: "Talent Land" },
        ]}
        href="/nosotros"
      />
    </div>

    <!-- 02 · El hueco -->
    <section class="section-y-sm bg-white">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">El hueco</p>
          <h2>El 95% de los proyectos de IA fracasa — y no es la tecnología.</h2>
        </div>

        {/* Las capturas del mercado laboral: convierten el 95% de
            estadística suelta en "mira lo que están pidiendo". */}
        {
          mostrar(...capturasMercado) && (
            <div class="mercado">
              {capturasMercado.map((id) => <Captura id={id} ancho={640} />)}
            </div>
          )
        }
      </div>
    </section>

    <!-- 03 · El método en cinco pasos, versión corta -->
    <section class="section-y-sm">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">El método, en corto</p>
          <h2>Cinco pasos: I·L·H·A·S.</h2>
        </div>

        <ol class="pasos-corto">
          {
            pasos.map((p) => (
              <li class="hover-lift reveal">
                <span class="pasos-corto__letra">{p.letra}</span>
                <Icono id={p.icono} />
                <span class="pasos-corto__paso">{p.paso}</span>
                <span class="pasos-corto__linea">{p.linea}</span>
              </li>
            ))
          }
        </ol>

        <p class="pasos-corto__link">
          <a href="/metodo">Conoce el método completo →</a>
        </p>
      </div>
    </section>

    <!-- 04 · La bifurcación — el bloque más importante del sitio -->
    <section class="bifurcacion-section bg-white">
      <div class="container">
        <Bifurcacion
          heading="¿Quieres aprenderlo, o quieres que lo implementemos?"
          prominent
        />
      </div>
    </section>

    <!-- 05 · Prueba — el linaje -->
    <section class="section-y bg-dark">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">De dónde sale el método</p>
          <h2>No es teoría. Es lo que ya construimos.</h2>
        </div>

        <ul class="linaje">
          {
            PRODUCTOS.map((p) => (
              <TarjetaCaso
                titulo={p.titulo}
                detalle={p.detalle}
                marca={p.marca}
                capturaId={p.capturaId}
                recorte={p.recorte}
              />
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 07 · Cierre -->
    <section class="section-y bg-white">
      <div class="container prose prose-center cierre reveal">
        <h2>¿Todavía no sabes cuál es tu carril?</h2>
        <p>Conoce el método completo antes de decidir.</p>
        <a href="/metodo" class="btn btn-primary">Conocer el método</a>
      </div>
    </section>
  </article>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero__glow {
    /* Más lejos y más tenue: dentro de un hero corto con overflow:hidden,
       un círculo grande se recorta en los cuatro lados y se ve como una
       mancha rectangular, no como un resplandor. */
    position: absolute;
    top: -60%;
    right: -25%;
    width: 32rem;
    height: 32rem;
    background: var(--ilhas-gradient);
    opacity: 0.12;
    filter: blur(90px);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-split {
    /* Más corto que el default de base.css a propósito: el home tiene
       la bifurcación (bloque 04) como prioridad — debe llegar cerca del
       pliegue — así que este hero no se estira tanto como los de
       /finanzas o /soluciones, solo lo suficiente para que no se sienta
       cortado en seco. */
    position: relative;
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  .hero__content {
    position: relative;
  }

  .hero h1 {
    /* El H1 más grande del sitio a propósito: es el home, el que recibe
       tráfico frío. Las páginas interiores usan un tamaño menor
       (ver su propio <style>) — la jerarquía estaba invertida. */
    font-size: clamp(2.5rem, 4.5vw, 3.75rem);
    max-width: 20ch;
  }

  .hero .lead {
    margin-top: 1rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  /* --- 01 · stat rail: prueba atribuida arriba del pliegue. Una sola
     línea de texto, no bloques de números grandes — el bloque 04
     (bifurcación) manda sobre este bloque: tiene que llegar cerca del
     pliegue, así que esta franja no puede costar más que un renglón. --- */
  .hero__stats {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ilhas-gray);
    max-width: none;
    font-size: 0.8125rem;
    color: var(--ilhas-text);
    line-height: 1.6;
  }

  .hero__stats-sep {
    margin-inline: 0.625rem;
    color: var(--ilhas-gray);
  }

  .hero__stats-dato {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    color: var(--ilhas-dark);
  }

  section > .container.prose > p:not(.kicker):not(.lead) {
    margin-top: 1.25rem;
  }

  /* --- Banda de autoridad --- */
  .banda-autoridad {
    margin-top: 0.5rem;
  }

  /* --- 02 · las capturas del mercado laboral ---
     Vacío hoy: sin archivos, .mercado no tiene hijos en producción y no
     ocupa nada (el gap de un grid sin hijos no pinta). */
  .mercado {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .mercado {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- 03 · pasos versión corta --- */
  .pasos-corto {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .pasos-corto li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .pasos-corto__letra {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--ilhas-primary);
    color: var(--ilhas-white);
    font-family: var(--ilhas-font-display);
    font-size: 0.8125rem;
    flex-shrink: 0;
  }

  .pasos-corto__paso {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    color: var(--ilhas-dark);
  }

  .pasos-corto__linea {
    color: var(--ilhas-text);
  }

  .pasos-corto__link {
    margin-top: 1.5rem;
  }

  .pasos-corto__link a {
    font-family: var(--ilhas-font-body);
    font-weight: 600;
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-primary);
    text-decoration: none;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .pasos-corto li {
      display: grid;
      grid-template-columns: 2rem 9rem 1fr;
      align-items: center;
    }
  }

  /* En desktop ancho, los cinco pasos caben en una sola fila: convierte
     una lista de 5 renglones apilados en una tira horizontal, para que
     la bifurcación (bloque 04) llegue más cerca del pliegue. */
  @media (min-width: 1024px) {
    .pasos-corto {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .pasos-corto li {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
    }

    .pasos-corto__linea {
      font-size: 0.875rem;
    }
  }

  /* --- 05 · linaje ---
     El marcado y los colores de cada tarjeta viven en TarjetaCaso.astro
     (incluido el claro-sobre-oscuro de .bg-dark). Aquí solo la rejilla. */
  .linaje {
    list-style: none;
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .linaje {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .linaje {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- 04 · bifurcación: padding-top reducido a propósito (el bloque
     tiene que llegar cerca del pliegue), padding-bottom completo (sigue
     siendo el bloque más importante del sitio, no se achica). --- */
  .bifurcacion-section {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: var(--ilhas-section-y);
  }

  /* --- 07 · cierre --- */
  .cierre {
    text-align: center;
  }

  .cierre h2 {
    margin-inline: auto;
  }

  .cierre p {
    margin-inline: auto;
  }

  .cierre .btn {
    margin-top: 1.75rem;
  }
</style>
