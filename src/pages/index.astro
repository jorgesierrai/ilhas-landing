    /* A · La espina: una línea vertical detrás de los cinco badges. No dice
       nada, agrupa — el ojo lee I-L-H-A-S hacia abajo como una palabra y no
       como cinco marcas sueltas. Mismo lenguaje que el spine de la línea de
       tiempo de /nosotros.
       Vive dentro del media query a propósito: en móvil las filas se apilan y
       la línea quedaría cortada por el texto de la falla. */
    /* `stretch` es lo que hace que la espina sea continua: la fila mide más
       que .paso (la columna de la falla es más alta), así que con .paso a su
       altura natural el trazo se cortaba entre fila y fila. Estirado, cada
       tramo va de borde a borde de su fila y, como las filas son contiguas,
       los cinco se tocan. `align-content` mantiene el contenido centrado. */
    .mapa--espina .paso {
      position: relative;
      align-self: stretch;
      align-content: center;
    }

    .mapa--espina .paso::before {
      content: "";
      position: absolute;
      left: calc(0.875rem - 1px);
      /* -1.5rem = el padding-block de la fila. Con .paso estirado, el trazo
         cruza ese espacio y engancha con el de la fila siguiente. Sin el
         stretch de arriba estos 24 px no alcanzaban, porque .paso quedaba
         centrado y sobraba aire por los dos lados. */
      top: -1.5rem;
      bottom: -1.5rem;
      z-index: 0;
      width: 2px;
      background: var(--ilhas-primary);
      opacity: 0.2;
    }

    /* Nace y muere en el centro del primer y del último badge, no en el borde
       de la fila: si no, sobresale por arriba y por abajo. Medido: con .paso
       estirado, el centro del badge queda a 1.5rem de su borde superior, en
       las cinco filas por igual. */
    .mapa--espina .mapa__fila:first-of-type .paso::before {
      top: 1.5rem;
    }

    .mapa--espina .mapa__fila:last-of-type .paso::before {
      bottom: calc(100% - 1.5rem);
    }

    .mapa--espina .paso__letra {
      position: relative;
      z-index: 1;
    }

