---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Bifurcacion from "../components/Bifurcacion.astro";
import BandaAutoridad from "../components/medios/BandaAutoridad.astro";
import Captura from "../components/medios/Captura.astro";
import Icono from "../components/medios/Icono.astro";
import TarjetaCaso from "../components/medios/TarjetaCaso.astro";
import Stat from "../components/medios/Stat.astro";
import { buscarImagen, mostrar } from "../lib/medios";
import { porId } from "../data/medios";
import { PRODUCTOS } from "../data/productos";

// La foto del hero va por el sistema de ranuras pero NO por Captura.astro:
// ese componente mete <figure> + <figcaption> y loading="lazy", y las tres
// cosas pelean con un hero absoluto que además es el LCP del home.
const fotoHero = buscarImagen("home-hero-conferencia");
const altHero = porId("home-hero-conferencia")!.alt;

const pasos = [
  { letra: "I", paso: "Identificar", linea: "Cómo se mueve el dinero y dónde se fuga.", icono: "icono-paso-i" },
  { letra: "L", paso: "Levantamiento", linea: "Traes el estándar de los mejores.", icono: "icono-paso-l" },
  { letra: "H", paso: "Hilar", linea: "Costos, precios y márgenes en un solo criterio.", icono: "icono-paso-h" },
  { letra: "A", paso: "Accionar", linea: "Decides con números, no con intuición.", icono: "icono-paso-a" },
  { letra: "S", paso: "Sistematizar", linea: "La IA como tu equipo, con alertas automáticas.", icono: "icono-paso-s" },
];

const capturasMercado = ["home-mercado-01", "home-mercado-02", "home-mercado-03"];

// Métricas del hero. El copy es de Jorge y va literal (brief de la
// iteración 3): número, unidad en violeta, y etiqueta en versalitas.
const kpis = [
  { dato: "+1,000", unidad: " MDP", contexto: "al mes, volumen respaldado" },
  { dato: "6", unidad: "+", contexto: "startups · infraestructura creada" },
  { dato: "2016", unidad: "→", contexto: "desarrollando IA" },
];

---

<Base
  title="Ilhas"
  description="El método con el que se construyen productos que mueven millones, apuntado a tu trabajo. Aprende Ilhas, o deja que lo implementemos."
  heroOscuro
>
  <article>
    <!-- 01 · Hero — la línea de identidad -->
    <!-- 01 · Hero — la foto de Talent Land, opción B2 aprobada el 25 ago 2026.
         Referencia: medios/hero-b2-referencia.html · las cuatro decisiones de
         CSS están numeradas en el <style> de abajo. -->
    <section class="hero">
      {
        fotoHero && (
          <div class="hero__foto">
            <Image
              src={fotoHero}
              alt={altHero}
              widths={[900, 1440]}
              sizes="(max-width: 899px) 100vw, 56vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )
      }
      <div class="hero__velo" aria-hidden="true"></div>

      <div class="hero__inner">
        <h1>
          Tecnología de <span class="text-gradient">clase mundial</span>.
          Accesible para tu empresa <span class="text-gradient">con IA</span>.
        </h1>

        <p class="hero__lead">
          Convertimos años de experiencia creando infraestructura crítica en un
          método probado. Todo lo que aprendimos escalando productos de millones
          de dólares y empresas unicornio, ahora adaptado para potenciar tus
          ventas, finanzas y operaciones.
        </p>

        <div class="hero__ctas">
          <a href="/finanzas" class="btn btn-primary">Quiero aprenderlo</a>
          <a href="/soluciones" class="btn btn-ghost-oscuro">Quiero implementarlo</a>
        </div>

        <div class="hero__kpis">
          {
            kpis.map((k) => (
              <Stat
                dato={k.dato}
                unidad={k.unidad}
                contexto={k.contexto}
                variante="hero"
              />
            ))
          }
        </div>
      </div>

      {fotoHero && <p class="hero__credito">Talent Land · abril 2018</p>}
    </section>

    {/* Banda de autoridad — medios/BRIEF-historial.md §3. Tira delgada, no
        una sección, y SIN los tres videos: el home tiene ocho segundos, y
        meterle la prueba completa lo mata y hace que no se vea ninguno. La
        banda vende en dos segundos y manda a /nosotros a quien la quiera. */}
    <div class="container banda-autoridad">
      <BandaAutoridad
        titulo="Hablando de IA en público desde 2017."
        items={[
          { año: "nov 2017", etiqueta: "conferencia" },
          { año: "ene 2018", etiqueta: "radio nacional" },
          { año: "abr 2018", etiqueta: "Talent Land" },
        ]}
        href="/nosotros"
      />
    </div>

    <!-- 02 · El hueco -->
    <section class="section-y-sm bg-white">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">El hueco</p>
          <h2>El 95% de los proyectos de IA fracasa — y no es la tecnología.</h2>
        </div>

        {/* Las capturas del mercado laboral: convierten el 95% de
            estadística suelta en "mira lo que están pidiendo". */}
        {
          mostrar(...capturasMercado) && (
            <div class="mercado">
              {capturasMercado.map((id) => <Captura id={id} ancho={640} />)}
            </div>
          )
        }
      </div>
    </section>

    <!-- 03 · El método en cinco pasos, versión corta -->
    <section class="section-y-sm">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">El método, en corto</p>
          <h2>Cinco pasos: I·L·H·A·S.</h2>
        </div>

        <ol class="pasos-corto">
          {
            pasos.map((p) => (
              <li class="hover-lift reveal">
                <span class="pasos-corto__letra">{p.letra}</span>
                <Icono id={p.icono} />
                <span class="pasos-corto__paso">{p.paso}</span>
                <span class="pasos-corto__linea">{p.linea}</span>
              </li>
            ))
          }
        </ol>

        <p class="pasos-corto__link">
          <a href="/metodo">Conoce el método completo →</a>
        </p>
      </div>
    </section>

    <!-- 04 · La bifurcación — el bloque más importante del sitio -->
    <section class="bifurcacion-section bg-white">
      <div class="container">
        <Bifurcacion
          heading="¿Quieres aprenderlo, o quieres que lo implementemos?"
          prominent
        />
      </div>
    </section>

    <!-- 05 · Prueba — el linaje -->
    <section class="section-y bg-dark">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">De dónde sale el método</p>
          <h2>No es teoría. Es lo que ya construimos.</h2>
        </div>

        <ul class="linaje">
          {
            PRODUCTOS.map((p) => (
              <TarjetaCaso
                titulo={p.titulo}
                detalle={p.detalle}
                marca={p.marca}
                capturaId={p.capturaId}
                recorte={p.recorte}
              />
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 07 · Cierre -->
    <section class="section-y bg-white">
      <div class="container prose prose-center cierre reveal">
        <h2>¿Todavía no sabes cuál es tu carril?</h2>
        <p>Conoce el método completo antes de decidir.</p>
        <a href="/metodo" class="btn btn-primary">Conocer el método</a>
      </div>
    </section>
  </article>
</Base>

<style>
  /* ===================================================================
     01 · HERO — opción B2. Referencia: medios/hero-b2-referencia.html
     Las cuatro decisiones numeradas de esa referencia, portadas tal cual.
     =================================================================== */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 620px;
    overflow: hidden;
    background: var(--ilhas-dark);
  }

  /* 1 · La foto SANGRA desde la derecha y se disuelve hacia la izquierda con
        máscara. No es una caja con una sombra encima: es la imagen misma
        desapareciendo. Cambiar esto por un box-shadow o por un div con
        degradado sobre una foto contenida pierde el efecto entero. */
  .hero__foto {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    width: 56%;
    height: 100%;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.5) 26%,
      #000 58%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.5) 26%,
      #000 58%
    );
  }

  .hero__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 18% 40%;
  }

  /* 2 · Velo de contraste, para que el texto pase AA sobre cualquier zona de
        la foto. Las paradas están calibradas: .92 a 40% deja el H1 sobre negro
        casi puro, y .44 a 64% es lo más que se puede aclarar sin que la última
        métrica choque con el hombro de Jorge. Moverlas reabre las dos cosas. */
  .hero__velo {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      95deg,
      rgba(14, 14, 15, 0.98) 0%,
      rgba(14, 14, 15, 0.92) 40%,
      rgba(14, 14, 15, 0.44) 64%,
      rgba(14, 14, 15, 0.12) 100%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: var(--ilhas-container);
    margin-inline: auto;
    padding-inline: var(--ilhas-gutter);
  }

  .hero h1 {
    max-width: 16ch;
    font-size: clamp(2.1rem, 3.5vw, 3.05rem);
    line-height: 1.06;
    color: var(--ilhas-white);
  }

  /* 3 · Las frases clave en el gradiente de marca, con white-space:nowrap
        para que nunca se partan entre líneas. Sobre fondo oscuro este tramo
        —violeta claro → violeta— mide de 7.5:1 a 4.6:1, así que pasa AA de
        texto grande con margen. El cian NO se toca aquí: sobre tinta es el
        único tramo del gradiente de marca que se ve barato.
        Ojo: pisa a .text-gradient de base.css, que arranca en --ilhas-primary
        y sobre oscuro se apaga demasiado. */
  .hero h1 .text-gradient {
    white-space: nowrap;
    background: linear-gradient(
      to right,
      #b98bff 0%,
      var(--ilhas-grad-end) 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero__lead {
    margin-top: 1.1rem;
    max-width: 46ch;
    font-size: 1.0625rem;
    /* .70 mide 9.6:1 sobre tinta. */
    color: rgba(255, 255, 255, 0.7);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }

  /* .btn-ghost de base.css es para fondo claro: su borde gris y su texto
     --ilhas-dark desaparecen sobre tinta. Esta es la misma pieza, invertida.
     No toca la regla compartida. */
  .btn-ghost-oscuro {
    background: transparent;
    color: var(--ilhas-white);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-ghost-oscuro:hover {
    border-color: var(--ilhas-white);
    color: var(--ilhas-white);
  }

  /* 4 · Métricas en FILA debajo del texto, no en columna a la derecha. Esa
        mitad la ocupan Jorge y la pantalla, que son dos sujetos fijos:
        cualquier número puesto ahí aterriza encima de uno de los dos. */
  .hero__kpis {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 2.1rem;
  }

  .hero__credito {
    position: absolute;
    left: var(--ilhas-gutter);
    bottom: 18px;
    z-index: 3;
    max-width: none;
    font-size: 0.75rem;
    /* .46 y no el .38 de la referencia: a 12 px, .38 mide 3.55:1 y falla AA.
       .46 mide 4.68:1. Sigue siendo blanco con opacidad, no un color nuevo. */
    color: rgba(255, 255, 255, 0.46);
  }

  /* Móvil: la foto pasa a ser una banda arriba y el texto queda abajo. Nunca
     texto encima de la foto en pantallas angostas — ahí no hay ancho
     suficiente para que la máscara separe una cosa de la otra. */
  @media (max-width: 899px) {
    .hero {
      min-height: 0;
      flex-direction: column;
      align-items: stretch;
    }

    .hero__foto {
      position: relative;
      width: 100%;
      height: 240px;
      -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
    }

    .hero__foto :global(img) {
      object-position: 22% 40%;
    }

    .hero__velo {
      display: none;
    }

    .hero__inner {
      padding-block: 1.5rem 3rem;
    }

    .hero__kpis {
      gap: 1.5rem;
    }

    .hero__credito {
      position: static;
      margin-top: 1.5rem;
      padding-inline: 0;
    }
  }

  section > .container.prose > p:not(.kicker):not(.lead) {
    margin-top: 1.25rem;
  }

  /* --- Banda de autoridad --- */
  .banda-autoridad {
    margin-top: 0.5rem;
  }

  /* --- 02 · las capturas del mercado laboral ---
     Vacío hoy: sin archivos, .mercado no tiene hijos en producción y no
     ocupa nada (el gap de un grid sin hijos no pinta). */
  .mercado {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .mercado {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- 03 · pasos versión corta --- */
  .pasos-corto {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .pasos-corto li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .pasos-corto__letra {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--ilhas-primary);
    color: var(--ilhas-white);
    font-family: var(--ilhas-font-display);
    font-size: 0.8125rem;
    flex-shrink: 0;
  }

  .pasos-corto__paso {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    color: var(--ilhas-dark);
  }

  .pasos-corto__linea {
    color: var(--ilhas-text);
  }

  .pasos-corto__link {
    margin-top: 1.5rem;
  }

  .pasos-corto__link a {
    font-family: var(--ilhas-font-body);
    font-weight: 600;
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-primary);
    text-decoration: none;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .pasos-corto li {
      display: grid;
      grid-template-columns: 2rem 9rem 1fr;
      align-items: center;
    }
  }

  /* En desktop ancho, los cinco pasos caben en una sola fila: convierte
     una lista de 5 renglones apilados en una tira horizontal, para que
     la bifurcación (bloque 04) llegue más cerca del pliegue. */
  @media (min-width: 1024px) {
    .pasos-corto {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .pasos-corto li {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
    }

    .pasos-corto__linea {
      font-size: 0.875rem;
    }
  }

  /* --- 05 · linaje ---
     El marcado y los colores de cada tarjeta viven en TarjetaCaso.astro
     (incluido el claro-sobre-oscuro de .bg-dark). Aquí solo la rejilla. */
  .linaje {
    list-style: none;
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
    /* start, no stretch: una tarjeta sin párrafo de detalle no tiene por qué
       estirarse a la altura de la más alta de su fila y dejar ~140 px de
       vacío abajo. Cada tarjeta mide lo que mide su contenido. */
    align-items: start;
  }

  @media (min-width: 640px) {
    .linaje {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .linaje {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- 04 · bifurcación: padding-top reducido a propósito (el bloque
     tiene que llegar cerca del pliegue), padding-bottom completo (sigue
     siendo el bloque más importante del sitio, no se achica). --- */
  .bifurcacion-section {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: var(--ilhas-section-y);
  }

  /* --- 07 · cierre --- */
  .cierre {
    text-align: center;
  }

  .cierre h2 {
    margin-inline: auto;
  }

  .cierre p {
    margin-inline: auto;
  }

  .cierre .btn {
    margin-top: 1.75rem;
  }
</style>
