---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Bifurcacion from "../components/Bifurcacion.astro";
import BandaAutoridad from "../components/medios/BandaAutoridad.astro";
import Captura from "../components/medios/Captura.astro";
import Icono from "../components/medios/Icono.astro";
import TarjetaCaso from "../components/medios/TarjetaCaso.astro";
import Stat from "../components/medios/Stat.astro";
import { buscarImagen, mostrar } from "../lib/medios";
import { porId } from "../data/medios";
import { PRODUCTOS } from "../data/productos";

// La foto del hero va por el sistema de ranuras pero NO por Captura.astro:
// ese componente mete <figure> + <figcaption> y loading="lazy", y las tres
// cosas pelean con un hero absoluto que además es el LCP del home.
const fotoHero = buscarImagen("home-hero-conferencia");
const altHero = porId("home-hero-conferencia")!.alt;

const pasos = [
  { letra: "I", paso: "Identificar", linea: "Cómo se mueve el dinero, dónde se fuga y desde qué número mides.", icono: "icono-paso-i" },
  { letra: "L", paso: "Levantamiento", linea: "Tus datos en un solo lugar, y el estándar de los mejores.", icono: "icono-paso-l" },
  { letra: "H", paso: "Hilar", linea: "Costos, precios y márgenes en un solo criterio.", icono: "icono-paso-h" },
  { letra: "A", paso: "Accionar", linea: "Decides con números, no con intuición.", icono: "icono-paso-a" },
  { letra: "S", paso: "Sistematizar", linea: "La IA como tu equipo, con alertas y mantenimiento.", icono: "icono-paso-s" },
];

// §02 · El mapa: lo que reportan que falló → el paso que lo cubre.
// Las cifras y las fuentes van LITERALES (prompts/iteracion-4-hueco.md §2).
// MIT va sin liga a propósito: el reporte circuló como PDF de MIT NANDA y no
// tiene URL pública estable en mit.edu. Se cita por nombre; no se liga un
// re-host de terceros.
const GARTNER =
  "https://www.gartner.com/en/newsroom/press-releases/2024-07-29-gartner-predicts-30-percent-of-generative-ai-projects-will-be-abandoned-after-proof-of-concept-by-end-of-2025";
const fallas: Record<string, { texto: string; fuente: string; url?: string }> = {
  I: {
    texto: "No había línea base: nadie sabía qué medir antes de empezar.",
    fuente: "MIT · The GenAI Divide, 2025",
  },
  L: {
    texto:
      "Datos sin preparar: solo el 24% los tiene limpios, centralizados y en tiempo real.",
    fuente: "Cisco AI Readiness Index 2025",
    url: "https://www.cisco.com/c/m/en_us/solutions/ai/readiness-index.html",
  },
  H: {
    texto:
      "Valor de negocio poco claro: el proyecto nunca se amarró a la operación.",
    fuente: "Gartner",
    url: GARTNER,
  },
  A: {
    texto: "Los costos se dispararon por encima del retorno esperado.",
    fuente: "Gartner",
    url: GARTNER,
  },
  S: {
    texto: "Abandono después del piloto: 30% no llega a producción.",
    fuente: "Gartner · pronóstico 2024",
    url: GARTNER,
  },
};

// La cita va en TEXTO, no el video: el home tiene ocho segundos y el clip
// completo vive en /soluciones, que es a donde manda la liga.
const testimonio = porId("soluciones-testimonio-oncologia")!.atribucion!;

const capturasMercado = ["home-mercado-01", "home-mercado-02", "home-mercado-03"];

// Métricas del hero. El copy es de Jorge y va literal (brief de la
// iteración 3): número, unidad en violeta, y etiqueta en versalitas.
const kpis = [
  { dato: "+1,000", unidad: " MDP", contexto: "al mes, volumen respaldado" },
  { dato: "6", unidad: "+", contexto: "startups · infraestructura creada" },
  { dato: "2016", unidad: "→", contexto: "desarrollando IA" },
];

---

<Base
  title="Ilhas"
  description="El método con el que se construyen productos que mueven millones, apuntado a tu trabajo. Aprende Ilhas, o deja que lo implementemos."
  heroOscuro
>
  <article>
    <!-- 01 · Hero — la línea de identidad -->
    <!-- 01 · Hero — la foto de Talent Land, opción B2 aprobada el 25 ago 2026.
         Referencia: medios/hero-b2-referencia.html · las cuatro decisiones de
         CSS están numeradas en el <style> de abajo. -->
    <section class="hero">
      {
        fotoHero && (
          <div class="hero__foto">
            <Image
              src={fotoHero}
              alt={altHero}
              widths={[900, 1600]}
              sizes="(max-width: 899px) 100vw, 56vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )
      }
      <div class="hero__velo" aria-hidden="true"></div>

      <div class="hero__inner">
        <h1>
          Tecnología y experiencia de{" "}
          <span class="text-gradient">clase mundial</span>. Accesible para tu
          empresa <span class="text-gradient">con IA</span>.
        </h1>

        <p class="hero__lead">
          Convertimos años de experiencia creando infraestructura crítica en un
          método probado. Todo lo que aprendimos escalando productos de millones
          de dólares y empresas unicornio, ahora adaptado para potenciar tus
          ventas, finanzas y operaciones.
        </p>

        <div class="hero__ctas">
          <a href="/finanzas" class="btn btn-primary">Quiero aprenderlo</a>
          <a href="/soluciones" class="btn btn-ghost-oscuro">Quiero implementarlo</a>
        </div>

        <div class="hero__kpis">
          {
            kpis.map((k) => (
              <Stat
                dato={k.dato}
                unidad={k.unidad}
                contexto={k.contexto}
                variante="hero"
              />
            ))
          }
        </div>
      </div>

      {fotoHero && <p class="hero__credito">Talent Land · abril 2018</p>}
    </section>

    {/* Banda de autoridad — medios/BRIEF-historial.md §3. Tira delgada, no
        una sección, y SIN los tres videos: el home tiene ocho segundos, y
        meterle la prueba completa lo mata y hace que no se vea ninguno. La
        banda vende en dos segundos y manda a /nosotros a quien la quiera. */}
    <div class="container banda-autoridad">
      <BandaAutoridad
        titulo="Hablando de IA en público desde 2017."
        items={[
          { año: "nov 2017", etiqueta: "conferencia" },
          { año: "ene 2018", etiqueta: "radio nacional" },
          { año: "abr 2018", etiqueta: "Talent Land" },
        ]}
        href="/nosotros"
      />
    </div>

    {/* 02 · El hueco — se rehizo el 25 ago 2026 y SE COMIÓ a la vieja §03.
        Referencia: medios/hueco-referencia.html, opción 3 (#sinbanda).

        Por qué no hay una §03 con los cinco pasos otra vez: el mapa ya
        muestra las cinco letras, y repetirlas 400 px abajo no aporta. Es la
        salida (a) que pedía AUDITORIA-VISUAL.md — "el hueco es el setup del
        método, no una sección aparte".

        El costo está medido y aprobado: §02+§03 medían 537 px y esta sección
        mide ~1,637 px, así que la bifurcación se recorre de 1,279 a ~2,379 px.
        Es un intercambio consciente. NO lo "arregles" partiendo esto en dos.

        Las líneas de cada paso salen del mismo array `pasos` que usa la
        página: así el mapa y /metodo no pueden desincronizarse. */}
    <section class="section-y bg-white">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">El hueco</p>
          <h2>
            El 95% de los proyectos de IA no muestra retorno medible. Y no es
            la tecnología.
          </h2>
        </div>

        <p class="causa reveal">
          MIT analizó <strong>300 proyectos de IA empresarial</strong>: el 95%
          no mostró retorno financiero medible en seis meses. No fallaron los
          modelos — falló lo de antes. Sin línea base no hay con qué comparar,
          y sin comparación no hay retorno que demostrar, aunque el proyecto
          haya funcionado. <strong>La IA amplifica lo que le metes.</strong> Si
          el fundamento está flojo, amplifica eso.
        </p>

        <div class="mapa mapa--espina reveal">
          <div class="mapa__encabezados" aria-hidden="true">
            <span>Lo que reportan que falló</span>
            <span>La parte del Método que la cubre</span>
          </div>

          {
            pasos.map((p) => (
              <div class="mapa__fila">
                <div class="falla">
                  {fallas[p.letra].texto}
                  <cite>
                    {fallas[p.letra].url ? (
                      <a
                        href={fallas[p.letra].url}
                        target="_blank"
                        rel="noopener"
                      >
                        {fallas[p.letra].fuente}
                      </a>
                    ) : (
                      fallas[p.letra].fuente
                    )}
                  </cite>
                </div>
                <div class="paso">
                  <span class="paso__letra">{p.letra}</span>
                  <span class="paso__nombre">{p.paso}</span>
                  <span class="paso__linea">{p.linea}</span>
                </div>
              </div>
            ))
          }

          {/* C · El remate. Al comerse §03, el home perdió el único lugar
              donde el acrónimo se deletreaba, así que el visitante veía cinco
              círculos con letras sueltas sin conectar que arman el nombre de
              la casa. Va después de la quinta fila, cuando ya las vio pasar:
              la línea nada más cierra la puerta. La segunda frase sale de
              docs/01-arquitectura.md, no es invención. */}
          <p class="remate">
            Cinco pasos. Cinco letras: <em>I·L·H·A·S</em>.<br />
            El método es el barco; las islas son a dónde lo apuntas.
          </p>

          <p class="mapa__link">
            <a href="/metodo">Conoce el método completo →</a>
          </p>
        </div>

        <figure class="prueba reveal">
          <blockquote>
            «Algo que hacíamos en tres, cuatro horas —o hasta un día entero—
            ahora toma <em>veinte minutos</em>.»
          </blockquote>
          <div class="prueba__pie">
            <figcaption>
              <b>{testimonio.nombre}</b>
              {testimonio.rol} · {testimonio.empresa}
            </figcaption>
            <p class="prueba__link">
              <a href="/soluciones">Ver los casos completos →</a>
            </p>
          </div>
        </figure>
      </div>
    </section>

    <!-- 04 · La bifurcación — el bloque más importante del sitio -->
    {/* Va con lavado de marca, no en blanco: §02 arriba también es .bg-white y
        .bg-white + .bg-white colapsa el padding, así que la bifurcación se leía
        como continuación del hueco en vez de como sección nueva. Tampoco puede
        ir oscura — §05 (el linaje) ya lo es y las dos se fundirían. Ver la nota
        de .bg-lavado en src/styles/base.css.

        El H2 dice "ya sabes qué tiene que pasar": eso SOLO es verdad porque §02
        acaba de explicarlo. Si §02 se recorta, esta frase se queda sin piso. */}
    <section class="section-y bg-lavado">
      <div class="container">
        <Bifurcacion
          kicker="La bifurcación"
          heading="Ya sabes qué tiene que pasar. Falta decidir quién lo hace."
          lead="El mismo método en los dos carriles. Lo único que cambia son las manos."
          prominent
        />
      </div>
    </section>

    <!-- 05 · Prueba — el linaje -->
    <section class="section-y bg-dark">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">De dónde sale el método</p>
          <h2>No es teoría. Es lo que ya construimos.</h2>
        </div>

        <ul class="linaje">
          {
            PRODUCTOS.map((p) => (
              <TarjetaCaso
                titulo={p.titulo}
                detalle={p.detalle}
                marca={p.marca}
                capturaId={p.capturaId}
                recorte={p.recorte}
              />
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 07 · Cierre -->
    <section class="section-y bg-white">
      <div class="container prose prose-center cierre reveal">
        <h2>¿Todavía no sabes cuál es tu carril?</h2>
        <p>Conoce el método completo antes de decidir.</p>
        <a href="/metodo" class="btn btn-primary">Conocer el método</a>
      </div>
    </section>
  </article>
</Base>

<style>
  /* ===================================================================
     01 · HERO — opción B2. Referencia: medios/hero-b2-referencia.html
     Las cuatro decisiones numeradas de esa referencia, portadas tal cual.
     =================================================================== */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 620px;
    overflow: hidden;
    background: var(--ilhas-dark);
  }

  /* 1 · La foto SANGRA desde la derecha y se disuelve hacia la izquierda con
        máscara. No es una caja con una sombra encima: es la imagen misma
        desapareciendo.
        La disolución termina al 26% y no al 58%: con el recorte anterior
        Jorge caía en el 12-23% del ancho, o sea que la máscara lo estaba
        pintando al 23-44% de opacidad — ESA era la razón de que se viera
        fantasma, no el velo. Ahora el recorte lo deja al 28-38%, ya en la
        zona sólida, y lo que se disuelve es pared vacía. */
  .hero__foto {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    width: 56%;
    height: 100%;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.55) 14%,
      #000 26%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.55) 14%,
      #000 26%
    );
  }

  .hero__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 18% 40%;
  }

  /* 2 · Velo de contraste, para que el texto pase AA sobre cualquier zona de
        la foto.
        Ajustado el 25 ago: Jorge cae entre el 50% y el 57% del hero, justo
        donde el velo original iba de .72 a .58 y se lo comía. La meseta
        oscura se mantiene hasta 42% —que es donde terminan el H1 y el
        párrafo, lo medí— y a partir de ahí baja más rápido. Sobre Jorge pasa
        de .72/.58 a .62/.38.
        Las métricas sí quedan sobre zona más clara que antes; por eso llevan
        sombra propia (ver .hero__kpis abajo). */
  .hero__velo {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      95deg,
      rgba(14, 14, 15, 0.98) 0%,
      rgba(14, 14, 15, 0.9) 42%,
      rgba(14, 14, 15, 0.3) 52%,
      rgba(14, 14, 15, 0.02) 66%,
      rgba(14, 14, 15, 0) 100%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: var(--ilhas-container);
    margin-inline: auto;
    padding-inline: var(--ilhas-gutter);
  }

  .hero h1 {
    /* 19ch y no 16: con el titular nuevo, a 16ch caía en cinco líneas y el
       bloque de texto se comía el hero. A 19ch son cuatro y el texto sigue
       terminando antes del 45% del ancho, o sea lejos de Jorge y de la
       pantalla. */
    max-width: 19ch;
    font-size: clamp(2.1rem, 3.4vw, 2.9rem);
    line-height: 1.06;
    color: var(--ilhas-white);
  }

  /* 3 · Las frases clave en el gradiente de marca, con white-space:nowrap
        para que nunca se partan entre líneas. Sobre fondo oscuro este tramo
        —violeta claro → violeta— mide de 7.5:1 a 4.6:1, así que pasa AA de
        texto grande con margen. El cian NO se toca aquí: sobre tinta es el
        único tramo del gradiente de marca que se ve barato.
        Ojo: pisa a .text-gradient de base.css, que arranca en --ilhas-primary
        y sobre oscuro se apaga demasiado. */
  .hero h1 .text-gradient {
    white-space: nowrap;
    background: linear-gradient(
      to right,
      #b98bff 0%,
      var(--ilhas-grad-end) 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero__lead {
    margin-top: 1.1rem;
    max-width: 46ch;
    font-size: 1.0625rem;
    /* .70 mide 9.6:1 sobre tinta. */
    color: rgba(255, 255, 255, 0.7);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }

  /* .btn-ghost de base.css es para fondo claro: su borde gris y su texto
     --ilhas-dark desaparecen sobre tinta. Esta es la misma pieza, invertida.
     No toca la regla compartida. */
  .btn-ghost-oscuro {
    background: transparent;
    color: var(--ilhas-white);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-ghost-oscuro:hover {
    border-color: var(--ilhas-white);
    color: var(--ilhas-white);
  }

  /* 4 · Métricas en FILA debajo del texto, no en columna a la derecha. Esa
        mitad la ocupan Jorge y la pantalla, que son dos sujetos fijos:
        cualquier número puesto ahí aterriza encima de uno de los dos. */
  .hero__kpis {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2.1rem;
    /* Compactas a propósito: medido a 1440 px, con el tamaño anterior la
       tercera métrica llegaba a x=925 y Jorge empieza en x=859, así que se le
       encimaba. Con este tamaño la fila termina antes de él. Es la regla 4 de
       la referencia: las métricas van en fila, pero ninguna aterriza sobre
       uno de los dos sujetos fijos de la foto. */
    text-shadow: 0 1px 12px rgba(14, 14, 15, 0.9);
  }

  .hero__credito {
    position: absolute;
    left: var(--ilhas-gutter);
    bottom: 18px;
    z-index: 3;
    max-width: none;
    font-size: 0.75rem;
    /* .46 y no el .38 de la referencia: a 12 px, .38 mide 3.55:1 y falla AA.
       .46 mide 4.68:1. Sigue siendo blanco con opacidad, no un color nuevo. */
    color: rgba(255, 255, 255, 0.46);
  }

  /* Móvil: la foto pasa a ser una banda arriba y el texto queda abajo. Nunca
     texto encima de la foto en pantallas angostas — ahí no hay ancho
     suficiente para que la máscara separe una cosa de la otra. */
  @media (max-width: 899px) {
    .hero {
      min-height: 0;
      flex-direction: column;
      align-items: stretch;
    }

    .hero__foto {
      position: relative;
      width: 100%;
      height: 240px;
      -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
    }

    .hero__foto :global(img) {
      object-position: 22% 40%;
    }

    .hero__velo {
      display: none;
    }

    .hero__inner {
      padding-block: 1.5rem 3rem;
    }

    .hero__kpis {
      gap: 1.5rem;
    }

    .hero__credito {
      position: static;
      margin-top: 1.5rem;
      padding-inline: 0;
    }
  }

  section > .container.prose > p:not(.kicker):not(.lead) {
    margin-top: 1.25rem;
  }

  /* --- Banda de autoridad --- */
  .banda-autoridad {
    margin-top: 0.5rem;
  }

  /* --- 02 · El hueco: causa, mapa y prueba ---
     Portado de medios/hueco-referencia.html, opción 3. */
  .causa {
    margin-top: 2.5rem;
    max-width: 60ch;
    font-size: var(--ilhas-fs-body);
  }

  .causa strong {
    font-weight: 600;
    color: var(--ilhas-dark);
  }

  /* El mapa hace todo el trabajo: izquierda lo que reportan que falló,
     derecha la letra que lo cubre. Nadie declara que Ilhas es la excepción;
     el lector lo concluye. */
  .mapa {
    margin-top: 3.5rem;
    border-top: 1px solid var(--ilhas-gray);
  }

  .mapa__encabezados {
    display: none;
  }

  .mapa__fila {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--ilhas-gray);
  }

  .falla {
    font-size: 1rem;
    color: var(--ilhas-text);
  }

  .falla cite {
    display: block;
    margin-top: 0.35rem;
    font-style: normal;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    /* Gris propio y no --ilhas-text: la fuente es metadato, no cuerpo.
       Mide 4.6:1 sobre blanco, así que pasa AA. */
    color: #6f6f7a;
  }

  /* La fuente es liga cuando existe URL canónica. Sin subrayado permanente:
     se subraya al hover, para no competir con las ligas de conversión que
     están 30 px abajo. */
  .falla cite a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(111, 111, 122, 0.45);
  }

  .falla cite a:hover {
    color: var(--ilhas-primary);
    border-bottom-color: var(--ilhas-primary);
  }

  /* Grid de dos filas y no flex: con el copy nuevo de I y L —más largo,
     porque ahora nombran los datos— en flex las filas 1 y 2 se partían y las
     3-5 no, y quedaba inconsistente. Así las cinco se ven igual: badge y
     nombre arriba, descripción abajo alineada bajo el nombre.
     NO lo devuelvas a flex: con este copy se vuelve a partir. */
  .paso {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.3rem 0.75rem;
    align-items: center;
  }

  .paso__nombre,
  .paso__linea {
    grid-column: 2;
  }

  .paso__letra {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    grid-row: 1;
    grid-column: 1;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--ilhas-primary);
    color: var(--ilhas-white);
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 0.8125rem;
  }

  .paso__nombre {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: var(--ilhas-fs-h3);
    letter-spacing: var(--ilhas-tracking-display);
    color: var(--ilhas-dark);
  }

  .paso__linea {
    font-size: 1rem;
    color: var(--ilhas-text);
  }

  .remate {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ilhas-gray);
    max-width: 34ch;
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: clamp(1.05rem, 1.9vw, 1.35rem);
    line-height: 1.25;
