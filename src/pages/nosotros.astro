---
import Base from "../layouts/Base.astro";
import TarjetaPersona from "../components/TarjetaPersona.astro";
import Captura from "../components/medios/Captura.astro";
import VideoClip from "../components/medios/VideoClip.astro";
import { mostrar } from "../lib/medios";
import fotoPapa from "../assets/equipo/jorge-papa.png";
import fotoHijo from "../assets/equipo/jorge-hijo.png";

// Fotos reales (docs/05-assets.md § Fotos del equipo). Números atribuidos
// por separado, nunca sumados (docs/02-paginas.md). Los dos se llaman
// Jorge Sierra — el rol y la trayectoria de cada tarjeta los distingue,
// a propósito sin "(papá)"/"(hijo)": esta página pide explícitamente que
// no se lean como dúo (ese relato es de /finanzas).
const personas = [
  {
    nombre: "Jorge Sierra",
    rol: "Finanzas corporativas",
    trayectoria:
      "40 años asesorando empresas en América Latina: diagnósticos financieros, valuaciones, modelos de inversión y reestructuras.",
    atribuciones: [
      { dato: "40 años", contexto: "asesorando empresas en LATAM" },
      { dato: "+2,000 empresas", contexto: "asesoradas" },
    ],
    foto: fotoPapa,
  },
  {
    nombre: "Jorge Sierra",
    rol: "Producto y tecnología",
    trayectoria:
      "12 años construyendo productos digitales. Ha liderado productos fintech que hoy procesan más de 1,000 millones de pesos al mes.",
    atribuciones: [
      { dato: "12 años", contexto: "construyendo productos digitales" },
      { dato: "+1,000 MDP/mes", contexto: "procesados por productos que ha liderado" },
    ],
    foto: fotoHijo,
  },
];

// Tres cortes del podcast, no el episodio. El tercero es el origen de Ilhas
// y hoy no está escrito en ninguna página del sitio.
const historia = [
  "nosotros-historia-01",
  "nosotros-historia-02",
  "nosotros-historia-03",
];

// Ninguna de las dos secciones nuevas existe en producción mientras no haya
// material. En dev sí, para poder ver las ranuras.
const hayHistoria = mostrar(...historia);
const hayAutoridad = mostrar(
  "nosotros-conferencia",
  "nosotros-radio-2018",
  "nosotros-conferencia-clip",
);
---

<Base
  title="Nosotros"
  description="Quiénes construyen Ilhas: trayectoria individual de cada participante."
>
  <section class="section-y-sm bg-dark">
    <div class="container prose reveal">
      <p class="kicker">Nosotros</p>
      <h1>Quiénes construyen Ilhas.</h1>
      <p class="lead">
        Participantes de Ilhas, cada quien con su propia trayectoria — no un
        dúo. El método se apunta a áreas distintas; así crece esta rejilla.
      </p>
    </div>
  </section>

  <section class="section-y bg-white">
    <div class="container">
      <div class="personas">
        {
          personas.map((p) => (
            <TarjetaPersona
              nombre={p.nombre}
              rol={p.rol}
              trayectoria={p.trayectoria}
              atribuciones={p.atribuciones}
              foto={p.foto}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* § nueva · La historia — tres cortes de 60-90 s del podcast. */}
  {
    hayHistoria && (
      <section class="section-y">
        <div class="container">
          <div class="section-head reveal">
            <p class="kicker">La historia</p>
            <h2>De dónde sale Ilhas.</h2>
          </div>

          <div class="historia">
            {historia.map((id) => <VideoClip id={id} />)}
          </div>
        </div>
      </section>
    )
  }

  {/* § nueva · Autoridad — la conferencia a ancho completo y la radio de
      2018, con el año en tratamiento gráfico (regla 4 de curaduría: la
      fecha es parte de la prueba). */}
  {
    hayAutoridad && (
      <section class="section-y bg-dark">
        <div class="container">
          <div class="section-head reveal">
            <p class="kicker">Autoridad</p>
            <h2>Hablando de IA en radio nacional desde 2018.</h2>
          </div>

          {
            mostrar("nosotros-conferencia") && (
              <div class="autoridad__foto">
                <Captura id="nosotros-conferencia" ancho={1100} />
              </div>
            )
          }

          {
            mostrar("nosotros-radio-2018", "nosotros-conferencia-clip") && (
              <div class="autoridad__clips">
                {mostrar("nosotros-radio-2018") && (
                  <div class="autoridad__radio">
                    <p class="autoridad__anio">2018</p>
                    <VideoClip id="nosotros-radio-2018" />
                  </div>
                )}
                <VideoClip id="nosotros-conferencia-clip" />
              </div>
            )
          }
        </div>
      </section>
    )
  }
</Base>

<style>
  /* Página interior: H1 menor que el del home. */
  h1 {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
  }

  .personas {
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
    margin-inline: auto;
  }

  /* --- § la historia y § autoridad (vacías hoy) --- */
  .historia,
  .autoridad__clips {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .autoridad__foto {
    margin-top: 2rem;
  }

  .autoridad__anio {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: var(--ilhas-fs-stat);
    line-height: 1;
    color: var(--ilhas-grad-start);
    margin-bottom: 0.75rem;
  }

  @media (min-width: 768px) {
    .historia {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .autoridad__clips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 640px) {
    .personas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* Sin tope, el grid llenaba el contenedor de 1140px: tarjetas de
         ~550px de ancho, foto incluida — obligaba a hacer scroll para
         verla completa. 44rem mantiene las tarjetas a un tamaño de
         retrato razonable a cualquier ancho de pantalla. */
      max-width: 44rem;
    }
  }
</style>
