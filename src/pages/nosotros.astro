---
import Base from "../layouts/Base.astro";
import TarjetaPersona from "../components/TarjetaPersona.astro";
import { DISTINCIONES, ENLACES } from "../data/personas";
import Captura from "../components/medios/Captura.astro";
import VideoClip from "../components/medios/VideoClip.astro";
import Stat from "../components/medios/Stat.astro";
import Historial from "../components/Historial.astro";
import { mostrar } from "../lib/medios";
import fotoPapa from "../assets/equipo/jorge-papa.png";
import fotoHijo from "../assets/equipo/jorge-hijo.png";

// Fotos reales (docs/05-assets.md § Fotos del equipo). Números atribuidos
// por separado, nunca sumados (docs/02-paginas.md). Los dos se llaman
// Jorge Sierra — el rol y la trayectoria de cada tarjeta los distingue,
// a propósito sin "(papá)"/"(hijo)": esta página pide explícitamente que
// no se lean como dúo (ese relato es de /finanzas).
const personas = [
  {
    nombre: "Jorge Sierra",
    rol: "Finanzas corporativas",
    // Amarrado al ROL, no a la posición: aquí las dos se llaman "Jorge Sierra"
    // a secas y solo el rol las distingue.
    redes: ENLACES.papa,
    trayectoria:
      "40 años asesorando empresas en América Latina: diagnósticos financieros, valuaciones, modelos de inversión y reestructuras.",
    atribuciones: [
      { dato: "40 años", contexto: "asesorando empresas en LATAM" },
      { dato: "+200 empresas", contexto: "asesoradas" },
      { dato: "+10,000 alumnos", contexto: "formados" },
    ],
    distincion: DISTINCIONES.papa,
    foto: fotoPapa,
  },
  {
    nombre: "Jorge Sierra",
    rol: "Producto y tecnología",
    redes: ENLACES.hijo,
    trayectoria:
      "12 años construyendo productos digitales. Ha liderado productos fintech que hoy procesan más de 1,000 millones de pesos al mes.",
    atribuciones: [
      { dato: "12 años", contexto: "construyendo productos digitales" },
      { dato: "+1,000 MDP/mes", contexto: "procesados por productos que ha liderado" },
      { dato: "Desde 2016", contexto: "construyendo IA, y con IA" },
    ],
    distincion: DISTINCIONES.hijo,
    foto: fotoHijo,
  },
];

// Tres cortes del podcast, no el episodio. El tercero es el origen de Ilhas
// y hoy no está escrito en ninguna página del sitio.
const historia = [
  "nosotros-historia-01",
  "nosotros-historia-02",
  "nosotros-historia-03",
];

// Ninguna de las dos secciones nuevas existe en producción mientras no haya
// material. En dev sí, para poder ver las ranuras.
const hayHistoria = mostrar(...historia);
const hayAutoridad = mostrar(
  "nosotros-conferencia",
  "nosotros-radio-2018",
  "nosotros-conferencia-clip",
);

// Las dos fotos de Talent Land solo van a dos columnas si las DOS existen.
// Con una sola, las columnas 1.93fr/1.29fr dejarían la foto ocupando el 60%
// del ancho y una columna muerta al lado.
const dosFotosTalent =
  mostrar("nosotros-conferencia") && mostrar("home-hero-conferencia");
---

<Base
  title="Nosotros"
  description="Quiénes construyen Ilhas: trayectoria individual de cada participante."
>
  <section class="section-y-sm bg-dark">
    <div class="container prose reveal">
      <p class="kicker">Nosotros</p>
      <h1>Quiénes construyen Ilhas.</h1>
      <p class="lead">
        Participantes de Ilhas, cada quien con su propia trayectoria. No somos
        un dúo. El método se apunta a áreas distintas; así crece esta rejilla.
      </p>
    </div>
  </section>

  <section class="section-y bg-white">
    <div class="container">
      <div class="personas">
        {
          personas.map((p) => (
            <TarjetaPersona
              nombre={p.nombre}
              rol={p.rol}
              trayectoria={p.trayectoria}
              atribuciones={p.atribuciones}
              foto={p.foto}
              redes={p.redes}
              distincion={p.distincion}
              prioritaria
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* § nueva · La historia — tres cortes de 60-90 s del podcast. */}
  {
    hayHistoria && (
      <section class="section-y">
        <div class="container">
          <div class="section-head reveal">
            <p class="kicker">La historia</p>
            <h2>De dónde sale Ilhas.</h2>
          </div>

          <div class="historia">
            {historia.map((id) => <VideoClip id={id} />)}
          </div>
        </div>
      </section>
    )
  }

  {/* § nueva · La línea de tiempo — medios/BRIEF-historial.md §1.
      Los hitos viven en src/data/historial.ts: para agregar un año se edita
      ese archivo, no este.

      TODO copy · Jorge escribe el párrafo de intro. El borrador de
      medios/timeline-preview.html decía:
        «A la izquierda, lo que hemos entendido de la IA. A la derecha, lo que
         hemos construido con ella — casi todo infraestructura financiera para
         fintechs. Los tres hitos que brillan tienen video o foto: no es un
         relato, está grabado.»
      Ojo: la última frase ya no aplica — la prueba en video vive en
      § Autoridad, aquí abajo, no colgando de la línea. */}
  <section class="section-y bg-dark">
    <div class="container">
      <div class="section-head reveal">
        <p class="kicker">De dónde sale esto</p>
        <h2>Once años metidos en esto, con recibos.</h2>
      </div>

      <Historial />
    </div>
  </section>

  {/* § En público — TRES MOMENTOS EN ORDEN CRONOLÓGICO.
      Antes eran tres bloques apilados sin relación: el de radio, una foto
      suelta y un clip suelto — y el rótulo decía «Imagen Radio · enero 2018»,
      que solo describía la primera pieza.

      El orden ES el argumento y NO se reordena: el titular dice «desde 2017» y
      el primer momento es de 2017, así que la afirmación se prueba sola. Y las
      tres dejan de ser medios sueltos para volverse una línea corta que se
      recorre hacia adelante.

      Los pies salen de `historial.ts`, que ya trae el copy aprobado de Jorge
      para estos mismos hitos. No se inventa ninguno. */}
  {
    hayAutoridad && (
      <section class="section-y bg-dark">
        <div class="container">
          <div class="section-head reveal">
            <p class="kicker">En público</p>
            <h2>Hablando de IA en público desde 2017.</h2>
            {/* Copy de Jorge, literal. Único ajuste: «la visión QUE la IA iba a
                ser» → «la visión DE QUE la IA iba a ser». Concordancia, nada
                más. Cubre el clip del escenario y Talent Land, por eso va de
                entrada a toda la sección y no repetido en cada momento. */}
            <p class="lead">
              Desde 2017 que comenzamos a comunicar lo que estábamos haciendo,
              teníamos la visión de que la IA iba a ser accesible para todos,
              tanto en la vida diaria como en sus trabajos. Comunicábamos cómo
              estaba siendo creada, entrenada y facilitada para que cualquier
              persona pudiera utilizarla.
            </p>
          </div>

          <div class="momentos">
            {/* 1 ······················································ nov 2017
                Jorge cerró el 28 ago 2026 la duda que los dos briefs del 24 ago
                dejaron abierta: este clip es de NOVIEMBRE 2017, no de Talent
                Land. Talent Land (abr 2018) son las fotos de abajo. */}
            {mostrar("nosotros-conferencia-clip") && (
              <div class="momento reveal">
                <div class="momento__cabeza">
                  <span class="momento__fecha">Noviembre 2017</span>
                  <span class="momento__que">Escenario</span>
                </div>
                <div class="escenario">
                  <VideoClip
                    id="nosotros-conferencia-clip"
                    marco="navegador"
                    mostrarPie={false}
                  />
                  <p class="pie-medio">
                    <b>Presenta Coophi y hacia dónde ve que va la IA.</b>
                  </p>
                </div>
              </div>
            )}

            {/* 2 ······················································ ene 2018
                Video vertical a la izquierda, el año y las dos citas a la
                derecha. En móvil se apila. */}
            {mostrar("nosotros-radio-2018") && (
              <div class="momento reveal">
                <div class="momento__cabeza">
                  <span class="momento__fecha">Enero 2018</span>
                  <span class="momento__que">Imagen Radio · RMX</span>
                </div>
                <div class="radio">
                  <VideoClip
                    id="nosotros-radio-2018"
                    ratio="1080 / 1816"
                    marco="navegador"
                    maxAncho="420px"
                    mostrarPie={false}
                  />

                  <div class="radio__texto">
                    <Stat dato="2018" contexto="hablando de IA en radio nacional" />

                    <blockquote class="radio__cita">
                      <p>
                        Nosotros lo que estamos haciendo es diseñar una
                        plataforma que introduzca inteligencia artificial,
                        lenguaje natural y análisis de datos.
                      </p>
                    </blockquote>

                    <blockquote class="radio__cita">
                      <p>
                        Creemos en el rediseño de la dinámica en la que la gente
                        puede hacer proyectos.
                      </p>
                      {/* Esta segunda cita NO se oye en el corte de 10.8 s. Se
                          marca como de la entrevista completa para que quien le
                          dé play y no la escuche no dude — es la salida (a) de
                          la decisión pendiente del brief. La (b) es que Jorge
                          extienda el corte con el tramo 1:44-1:50. */}
                      <footer class="radio__fuente">
                        En la entrevista completa
                      </footer>
                    </blockquote>

                    <p class="radio__firma">
                      Jorge Sierra · Imagen Radio · enero de 2018
                    </p>

                    <p class="radio__enlace">
                      <a
                        href="https://www.rmx.com.mx/entrevistas/buscas-un-asistente-virtual-conoce-coophi"
                        rel="noopener noreferrer"
                      >
                        Nota original en rmx.com.mx →
                      </a>
                    </p>
                  </div>
                </div>
              </div>
            )}

            {/* 3 ······················································ abr 2018
                Dos encuadres de la MISMA charla: la sala llena prueba la
                escala, el recorte del home prueba de qué estaba hablando —se
                lee la pregunta en pantalla—. Va `home-hero-conferencia` y NO
                `nosotros-conferencia-detalle`: el detalle en crudo es otra toma
                de sala desde un costado y junto a la de sala llena se ven
                redundantes. */}
            {mostrar("nosotros-conferencia") && (
              <div class="momento reveal">
                <div class="momento__cabeza">
                  <span class="momento__fecha">Abril 2018</span>
                  <span class="momento__que">Talent Land</span>
                </div>
                <div class:list={["talent", dosFotosTalent && "talent--par"]}>
                  <Captura
                    id="nosotros-conferencia"
                    ancho={1100}
                    mostrarPie={false}
                  />
                  {mostrar("home-hero-conferencia") && (
                    <Captura
                      id="home-hero-conferencia"
                      ancho={760}
                      mostrarPie={false}
                    />
                  )}
                </div>
                {/* Sin el «Sala llena, hablando de cómo se construye IA.»
                    que traía al frente: esa frase ya la dice la línea de tiempo
                    2,300 px más arriba —sale del mismo `historial.ts`— y la
                    dice sobre todo la foto de la izquierda, que ES la sala
                    llena. Lo que queda es lo único que ni la cabecera ni las
                    imágenes explican solas: por qué son DOS fotos. No se
                    reescribió nada; se quitó la mitad duplicada. */}
                <p class="pie-medio">
                  La misma charla en dos encuadres: <b>cuánta gente había</b>,
                  y{" "}<b>la pregunta que estaba en pantalla</b>.
                </p>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* Página interior: H1 menor que el del home. */
  h1 {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
  }

  .personas {
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
    margin-inline: auto;
  }

  /* --- § la historia --- */
  .historia {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  /* --- § En público · los tres momentos ---
     Separación generosa entre momentos (3.25rem) y apretada dentro de cada
     uno: es lo que hace que se lean como tres cosas y no como seis. */
  .momentos {
    margin-top: 3rem;
    display: grid;
    gap: 3.25rem;
  }

  .momento__cabeza {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding-bottom: 0.7rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(248, 250, 255, 0.16);
  }

  /* Cian y no morado: --ilhas-primary sobre --ilhas-dark mide 3.6:1 y falla
     AA para texto pequeño; --ilhas-grad-start mide 13:1. */
  .momento__fecha {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ilhas-grad-start);
    flex: 0 0 auto;
  }

  .momento__que {
    font-size: 0.9375rem;
    color: rgba(248, 250, 255, 0.7);
  }

  /* El contexto que pidió Jorge. El copy sale de historial.ts. */
  .pie-medio {
    margin: 0.9rem 0 0;
    font-size: var(--ilhas-fs-small);
    line-height: 1.5;
    color: rgba(248, 250, 255, 0.62);
    max-width: 60ch;
  }

  .pie-medio b {
    color: var(--ilhas-white);
    font-weight: 500;
  }

  /* 1 · el escenario, nov 2017 */
  .escenario {
    max-width: 44rem;
  }

  /* 3 · Talent Land, abr 2018 */
  .talent {
    display: grid;
    gap: 1rem;
  }

  /* --- § En público · el bloque de radio ---
     Video vertical a la izquierda, año y citas a la derecha. En móvil,
     una sola columna con el video arriba. */
  .radio {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .radio__texto {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .radio__cita {
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(248, 250, 255, 0.12);
    font-family: var(--ilhas-font-body);
    font-size: var(--ilhas-fs-lead);
    color: var(--ilhas-white);
    text-wrap: pretty;
  }

  .radio__cita p {
    margin: 0;
  }

  /* Las comillas van en CSS, no en el texto: así el contenido de la cita se
     puede citar y traducir sin arrastrarlas.

     Cuelgan del PÁRRAFO y no del <blockquote>: con el ::after en el blockquote
     la comilla de cierre se pintaba después del <footer>, o sea en un renglón
     suelto debajo de «— En la entrevista completa». */
  .radio__cita p::before {
    content: open-quote;
  }

  .radio__cita p::after {
    content: close-quote;
  }

  .radio__fuente {
    margin-top: 0.75rem;
    font-size: var(--ilhas-fs-small);
    color: rgba(248, 250, 255, 0.55);
  }

  .radio__fuente::before {
    content: "— ";
  }

  .radio__firma,
  .radio__enlace {
    font-family: var(--ilhas-font-body);
    font-size: var(--ilhas-fs-small);
    color: rgba(248, 250, 255, 0.7);
  }

  .radio__enlace a {
    color: var(--ilhas-grad-start);
    text-decoration: none;
  }

  .radio__enlace a:hover {
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .historia {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Las columnas van en proporción a la relación de aspecto de cada foto
     —2400×1245 = 1.928 y 1600×1240 = 1.290, medidas del archivo— para que las
     dos midan LO MISMO de alto sin recortar ninguna. */
  @media (min-width: 820px) {
    .talent--par {
      grid-template-columns: 1.93fr 1.29fr;
      align-items: start;
    }
  }

  @media (min-width: 900px) {
    .radio {
      grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  @media (min-width: 640px) {
    .personas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* Sin tope, el grid llenaba el contenedor de 1140px: tarjetas de
         ~550px de ancho, foto incluida — obligaba a hacer scroll para
         verla completa. 44rem mantiene las tarjetas a un tamaño de
         retrato razonable a cualquier ancho de pantalla. */
      max-width: 44rem;
    }
  }
</style>
