---
import Base from "../layouts/Base.astro";
import Bifurcacion from "../components/Bifurcacion.astro";
import MapaEmpresa from "../components/MapaEmpresa.astro";
import Captura from "../components/medios/Captura.astro";
import Loop from "../components/medios/Loop.astro";
import VideoClip from "../components/medios/VideoClip.astro";
import { mostrar } from "../lib/medios";
import { porId } from "../data/medios";

// §07 "Así se arma por dentro": las cuatro capturas del sistema de agentes. Es la
// única prueba de la afirmación que da título a la sección — el bloque más
// importante de todo el plan de medios.
const capturasPrompts = [
  { id: "metodo-prompts-01", marco: "navegador" as const },
  { id: "metodo-prompts-02", marco: "navegador" as const },
  { id: "metodo-prompts-03", marco: "terminal" as const },
  { id: "metodo-prompts-04", marco: "navegador" as const },
];

// §02 · Las tres capas de un resultado con IA. Es lo que sostiene el "y no es
// la tecnología" del H2: de las tres, la única que compartes con tu competencia
// es la que no puedes mejorar.
const capasIA = [
  {
    nombre: "El modelo",
    que: "El motor (GPT-3.5, GPT-4, Gemini, Sonnet, Opus…)",
    dueno: "De todos. Es el mismo para ti y para tu competencia",
    tuya: false,
  },
  {
    nombre: "El andamiaje",
    que: "El flujo, las herramientas, los pasos que lo rodean",
    dueno: "Tuyo",
    tuya: true,
  },
  {
    nombre: "El conductor",
    que: "El contexto que le das, cómo lo corriges, cómo lo diriges",
    dueno: "Tuyo",
    tuya: true,
  },
];

// HumanEval, la prueba de OpenAI: 164 ejercicios de programación, y la métrica
// es pass@1 —la PRIMERA respuesta pasa todas las pruebas—. Andrew Ng los
// publicó y comparó en The Batch (DeepLearning.AI, 20 mar 2024). Publicó, no
// midió: la cita formal vive en la línea de fuentes del final de §02.
//
// Los porcentajes van literales y SIN redondear, y el "hasta" de 95.1 tampoco
// se toca: es como lo publicó Ng y quitarlo infla el dato.
//
// Van AGRUPADOS POR MODELO, no por resultado: así las dos de GPT-3.5 quedan
// pegadas y se ve de un vistazo que el salto de 48.1 a 95.1 pasó sin cambiar de
// modelo. Ese es el argumento entero de la sección.
const humanEval = [
  {
    modelo: "GPT-3.5",
    condicion: "tal cual",
    resultado: "48.1 %",
    ancho: 48.1,
    nuestro: true,
  },
  {
    modelo: "GPT-3.5",
    condicion: "revisando y corrigiendo su propio trabajo",
    resultado: "hasta 95.1 %",
    ancho: 95.1,
    nuestro: true,
  },
  {
    modelo: "GPT-4",
    condicion: "tal cual — el modelo de la siguiente generación",
    resultado: "67.0 %",
    ancho: 67.0,
    nuestro: false,
  },
];

/**
 * §04 · Los cinco pasos.
 *
 * El contenido sale LITERAL de `docs/07-metodo-detalle.md`, que es la
 * definición canónica dictada por Jorge. Si esto y ese documento difieren,
 * manda el documento.
 *
 * La jerarquía está invertida respecto a lo que había antes: `trabajo` es el
 * protagonista y `oficio` es secundario. "Producto" a secas no lo decodifica un
 * contador ni un dueño de empresa, así que la etiqueta es "el oficio de
 * construir software y tecnología", completa.
 */
const pasos = [
  {
    letra: "I",
    paso: "Identificar",
    trabajo: [
      "Encontrar el lugar: los procesos y workflows dentro de tu trabajo, quién los hace, y por qué se hacen así. Entender cómo se mueve el dinero, dónde se fuga y qué impacto tiene eso en tu negocio.",
      "Después mapeas tus prioridades y las ordenas, para saber en qué orden vas a ir optimizando y a cuál le vas a subir el valor primero.",
    ],
    // La idea más filosa del paso, y hasta hoy no estaba dicha en el sitio.
    // Va sola: el pie que la explicaba le quitaba filo.
    destacado: "¿Qué no debería existir en estos procesos?",
    oficio: "Discovery — instrumentar y hallar el dolor antes de construir",
  },
  {
    letra: "L",
    paso: "Levantamiento",
    trabajo: [
      "De los procesos que identificaste: entender tus datos. Qué datos tienes y dónde los tienes.",
      "Luego limpiarlos y ponerlos en un solo lugar. Y ser específico en una cosa: cuál es el dato y la métrica que quieres mover, y por qué.",
      "Para eso puedes traer referencias de cómo lo hacen los mejores —sus estándares— y entenderlos para aplicarlos tú.",
    ],
    oficio: "Continuous Discovery — levantar la información y el estándar",
  },
  {
    letra: "H",
    paso: "Hilar",
    trabajo: [
      "Tener un mapeo de: proceso → paso del proceso → dato → métrica que quieres mejorar, optimizar o a la que le quieres subir el valor. Ahí entiendes los dolores y las oportunidades de mejora.",
      "Con eso sabes cómo lo puedes mejorar y cómo va a cambiar la métrica. Y defines un objetivo: hacia dónde quieres mover ese KPI, de forma que te lleve a un resultado medible en tu proceso — y que además esté conectado a mejorar el margen, los costos o los precios.",
    ],
    // §05 dejó de ser sección suelta el 27 ago 2026 y su contenido vive aquí,
    // que es donde el visitante está leyendo el paso. Se llama "el paso más
    // importante", no "el paso joya".
    joya: {
      titulo: "El paso más importante.",
      texto:
        "Hilar es enhebrar piezas sueltas en una sola línea. En construir software y tecnología eso tiene nombre —Opportunity Solution Tree: tomar oportunidades dispersas y anclarlas a un solo resultado. Mismo verbo, mismo trabajo. Aplicado a tus números, es lo que convierte costos, precios y márgenes sueltos en un solo criterio de decisión.",
    },
    oficio: "Opportunity Solution Tree — enhebrar piezas sueltas en un solo resultado",
  },
  {
    letra: "A",
    paso: "Accionar",
    trabajo: [
      "Estableces el plan de acción: qué solución, qué vas a hacer y qué vas a eliminar.",
      "Y haces pruebas baratas —prototipos, automatizaciones chicas— que te digan si lo que estás haciendo efectivamente va a mover la aguja y la métrica que definiste. No te la juegas construyendo grande antes de saberlo.",
      // Autorizado por Jorge; no venía en el dictado.
      "Antes de construir a la medida, la prueba más barata a veces es usar algo que ya existe para entender el proceso de verdad. No siempre se compra — pero saltarse esa pregunta es cómo se acaba construyendo algo caro para un proceso que no se entendía.",
    ],
    oficio: "Assumption testing + POC — decidir con datos",
  },
  {
    letra: "S",
    paso: "Sistematizar",
    trabajo: [
      "Ya sabes que funciona, está validado y platicado. Ahora sí: usar la IA como tu equipo, bajo un método, no suelta.",
    ],
    // Jorge marcó explícitamente cuál es "lo más importante" y cuál "lo
    // segundo": son dos decisiones, no dos frases más.
    decisiones: [
      {
        rango: "Lo más importante",
        titulo: "Qué nivel de tecnología le aplicas",
        texto:
          "¿Basta con una automatización? ¿Un bot? ¿Un agente? ¿Skills? ¿Una aplicación completa? ¿O con alertas y correos ya la armaste? Escoger de más cuesta dinero; escoger de menos no resuelve.",
      },
      {
        rango: "Lo segundo",
        titulo: "Cómo vas a mantener esa solución",
        // Autorizado por Jorge; no venía en el dictado.
        texto:
          "Lo que rompe la confianza en una solución con IA es que nadie la esté revisando. Un error que agarras a tiempo es mantenimiento; uno que ya salió te cuesta credibilidad. Por eso hay que decidir quién la cuida antes de darla por terminada.",
      },
    ],
    oficio: "Delivery + automatización — el motor que corre solo",
  },
];

/**
 * §06 · Los cinco principios.
 *
 * Los textos son de Jorge y no se tocan. Lo que cambió el 27 ago 2026 es la
 * FORMA, y sale del propio contenido: cuatro de los cinco son **oposiciones**.
 * Presentarlos como A contra B —con el lado que gana en tinta y el que pierde
 * apagado— hace que se escaneen en dos segundos y que el argumento se vea sin
 * leerlo.
 *
 * ⚠️ NADA de iconitos: son ideas abstractas y los íconos para abstracciones
 * acaban siempre en engranes y focos genéricos. Abaratan, no elevan — y serían
 * cinco ranuras nuevas en un manifiesto que ya tiene ocho pendientes.
 *
 * El quinto NO es oposición: es la consecuencia de los otros cuatro, así que va
 * aparte y con otro peso.
 */
const principios = [
  {
    gana: "Fundamento",
    nexo: "antes que",
    pierde: "automatización",
    texto: "Primero el criterio. Automatizas después, no antes.",
  },
  {
    gana: "Infraestructura",
    nexo: "no",
    pierde: "un feature",
    texto:
      "La IA no es un plus que agregas al final: es la base sobre la que construyes.",
  },
  {
    gana: "Workflows",
    nexo: "sobre",
    pierde: "roles",
    texto:
      "No organizas personas haciendo tareas. Organizas el proceso completo, de principio a fin.",
  },
  {
    gana: "Outcomes",
    nexo: "sobre",
    pierde: "outputs",
    texto: "No mides cuánto produces. Mides qué cambia con lo que produces.",
  },
];

const principioFinal = {
  titulo: "Builder mindset",
  texto: "Construyes el sistema. No pides que alguien más te lo construya.",
};
---

<Base
  title="El Método"
  description="I·L·H·A·S: el sistema con el que Ilhas convierte criterio en decisiones, tomado del oficio de construir software y tecnología."
>
  <article>
    {/* 01 · La tesis — reescrita el 27 ago 2026.
        Antes decía "El método no nació en las finanzas". Se cayó: definirse
        por lo que NO eres es débil, y "producto" a secas no lo decodifica un
        contador ni un dueño de empresa. Ahora se define por lo que sí es.
        Un solo gradiente en el titular (tokens.css). */}
    {/* `section-y-sm`, NO `section-y`. Era la única de las cinco rutas que
        abría con el espaciado grande: 120px de pad-top contra 40, y por eso su
        titular colgaba a 229px cuando el del home está a 129 y el de /finanzas
        a 115. Medido antes y después. */}
    <section class="section-y-sm">
      <div class="container prose metodo-hero reveal">
        <p class="kicker">El método</p>
        <h1>
          El método nació construyendo{" "}
          <span class="text-gradient">tecnología</span>, a lo largo de más de 12
          años.
        </h1>
        <p class="lead">
          Esa tecnología ha tenido un impacto enorme en sus usuarios.
        </p>
        <p>
          Lo que te enseñamos es el sistema para producir soluciones que te
          ayuden a ti y a tus clientes a <strong>mover la aguja</strong> de lo
          que quieran mover — con tus procesos y las herramientas que ya tienes
          a la mano.
        </p>

        {/* Primera aparición de "mover la aguja" en todo el sitio, y hasta hoy
            no estaba definida en ninguna parte (docs/07-metodo-detalle.md
            § Vocabulario). <details> nativo: cero JS. Nada de title="", que ni
            lo lee un lector de pantalla ni existe en táctil. */}
        <details class="ayuda">
          <summary>¿qué es mover la aguja?</summary>
          <p>Cumplir el objetivo que te planteaste.</p>
        </details>

        <p>
          El método te ayuda a saber <strong>cómo pensar</strong>, a mejorar tus
          procesos y a crear más valor.
        </p>
      </div>
    </section>

    <!-- 02 · El hueco -->
    <section class="section-y bg-white">
      <div class="container prose reveal">
        <p class="kicker">El hueco</p>
        <h2>
          El 95% de los proyectos de IA no muestra retorno medible. Y no es la
          tecnología.
        </h2>
        <p>
          Falla por falta de criterio. Métele basura a un modelo y no obtienes
          basura: obtienes basura al cuadrado. La IA no corrige un mal
          razonamiento, lo amplifica. Por eso el fundamento importa más ahora
          que antes.
        </p>

        {/* El H2 afirma "y no es la tecnología". Hasta hoy nada lo demostraba:
            el cuerpo repetía la afirmación en vez de sostenerla. Las tres capas
            son lo que la sostiene, y la figura del experimento es lo que la
            prueba. El titular ya no dice "y solo una es el modelo": esa mitad
            la dice la tabla sola, en la fila del modelo. */}
        <h3 class="capas__titulo">Un resultado con IA tiene tres capas.</h3>

        <ul class="capas">
          {
            capasIA.map((c) => (
              <li class:list={["capa-ia", c.tuya && "capa-ia--tuya"]}>
                <b>{c.nombre}</b>
                <span>{c.que}</span>
                <em>{c.dueno}</em>
              </li>
            ))
          }
        </ul>

        <p>
          La capa que compartes con tu competencia es la única que no puedes
          mover.{" "}
          <strong>
            Las otras dos las armas tú, y son las que deciden el resultado.
          </strong>{" "}
          Por eso el mismo modelo produce resultados abismalmente distintos
          según quién lo maneje.
        </p>

        {/* Dato verificado, va literal y sin redondear. Se cita a Andrew Ng,
            que es de quien es, no a terceros que lo repiten. */}
        {/* El experimento como FIGURA, no como tabla de porcentajes sueltos.
            Referencia: medios/experimento-referencia.html, opción B.

            La tabla soltaba tres cifras y esperaba que el lector confiara —y
            nunca decía qué se midió ni cuál era la trampa: que dos de los tres
            renglones son EL MISMO MODELO. Explicarlo en prosa deja el bloque en
            801 px de móvil; dibujarlo lo deja en 571. La relación entre tres
            números se dibuja.

            Cero JavaScript: son tres <span> con un `width` en porcentaje. */}
        <div class="ng">
          <p class="ng__intro">
            <strong>Te dejamos el resultado de un experimento.</strong>
          </p>
          <p class="ng__que">
            OpenAI armó un examen para calificar modelos de IA:{" "}
            <strong>164 ejercicios de programación</strong>. No se califica a
            ojo — corren el programa y ven si hace lo que se pidió. Esto es
            cuántos salieron bien <strong>al primer intento</strong>.
          </p>

          <div class="fig">
            <div class="fig__llave" aria-hidden="true">
              <span>el mismo modelo</span>
            </div>
            <ul class="fig__barras">
              {
                humanEval.map((f) => (
                  <li class:list={["barra", f.nuestro && "barra--nuestro"]}>
                    <span class="barra__rotulo">
                      <b>{f.modelo}</b> {f.condicion}
                    </span>
                    <span class="barra__cifra">{f.resultado}</span>
                    <span class="barra__via">
                      <span class="barra__marca" style={`width:${f.ancho}%`} />
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>

          <p class="ng__remate">
            Las dos primeras son <strong>el mismo modelo</strong>. Lo único que
            cambia es que a la segunda la dejaron leer lo que escribió, probarlo
            y corregirlo antes de entregar — como cuando tú relees un reporte
            antes de mandarlo.{" "}
            <strong>
              Ese repaso movió 47 puntos; comprar el modelo nuevo movió 18.9.
            </strong>
          </p>
          <p class="ng__cierre">
            Esperar al siguiente modelo te mueve menos que armar el proceso
            alrededor del que ya tienes.
          </p>
        </div>

        <p>
          La otra mitad del problema es el proceso. Automatizar un proceso que
          está mal solo{" "}
          <strong>lo hace fallar más rápido y a mayor escala.</strong> Todos
          venden automatizar más. Nosotros empezamos por{" "}
          <strong>quitar</strong>.
        </p>

        <p class="pregunta">¿Qué no debería existir en estos procesos?</p>

        {/* Las tres fuentes, literales y verificadas
            (prompts/iteracion-4-hueco.md §2). El MAPA no se duplica aquí: §04
            ya desarma los cinco pasos en profundidad, y meterlo arriba sería
            decir lo mismo dos veces en la misma página. */}
        <p class="fuentes">
          <cite>MIT · The GenAI Divide, 2025</cite>
          <cite>
            <a
              href="https://www.cisco.com/c/m/en_us/solutions/ai/readiness-index.html"
              target="_blank"
              rel="noopener"
            >
              Cisco AI Readiness Index 2025
            </a>
          </cite>
          <cite>
            <a
              href="https://www.gartner.com/en/newsroom/press-releases/2024-07-29-gartner-predicts-30-percent-of-generative-ai-projects-will-be-abandoned-after-proof-of-concept-by-end-of-2025"
              target="_blank"
              rel="noopener"
            >
              Gartner · pronóstico 2024
            </a>
          </cite>
          <cite>
            <a
              href="https://www.deeplearning.ai/the-batch/how-agents-can-improve-llm-performance"
              target="_blank"
              rel="noopener"
            >
              Andrew Ng · The Batch, 20 mar 2024
            </a>
          </cite>
        </p>
      </div>
    </section>

    <!-- 03 · El ángulo correcto -->
    <section class="section-y">
      <div class="container prose reveal">
        <p class="kicker">El ángulo correcto</p>
        <h2>¿Dónde nació el método?</h2>

        {/* El texto es el de siempre —a Jorge le gusta— partido en las ideas
            que ya traía apelmazadas, y con las palabras que cargan el argumento
            en <strong>. Sin color nuevo y sin gradiente. */}
        <p>
          Salió de <strong>construir software y tecnología</strong>. Doce años
          haciéndolo, y los cinco pasos son los mismos que se usan ahí.
        </p>
        <p>
          Es <strong>el mismo sistema</strong> que usa quien construye
          tecnología, apuntado a tu trabajo, sin que tengas que volverte técnico
          ni esperar a que te den un equipo de ingeniería.
        </p>

        {/* Lo que faltaba: §03 prometía "sin volverte técnico" y no explicaba
            por qué eso es posible. Esto lo convierte de promesa a explicación. */}
        <p class="remate-angulo">
          Saber el <em>qué</em> no te obliga a aprender el <em>cómo</em>.
        </p>
        <p>
          Hay <strong>demasiada herramienta y demasiado ruido</strong>. El
          método te dice qué resolver y en qué orden; el <em>cómo</em> técnico
          se escoge después, en <strong>Sistematizar</strong>.
        </p>
      </div>
    </section>

    <!-- 04 · I·L·H·A·S paso por paso -->
    <section class="section-y bg-dark" id="pasos">
      <div class="container">
        <div class="prose reveal">
          <p class="kicker">El método, paso por paso</p>
          <h2>Cinco pasos. Un mapeo directo a tu trabajo.</h2>
          <p class="lead">
            Cada letra es un paso real, tomado de construir software y
            tecnología, apuntado a tus números.
          </p>
        </div>

        {/* Deja de ser tabla. Con el detalle largo de docs/07, cinco celdas de
            ~80 palabras eran ilegibles: la tabla forzaba a leer en horizontal
            algo que se piensa en vertical. Cinco bloques apilados, con "En tu
            trabajo" de protagonista y el oficio de pie de página.
            El badge es el mismo tratamiento que el mapa de §02 del home. */}
        <ol class="pasos">
          {
            pasos.map((p) => (
              <li class="paso-det">
                <div class="paso-det__cabeza">
                  <span class="paso-det__letra" aria-hidden="true">
                    {p.letra}
                  </span>
                  <h3>{p.paso}</h3>
                </div>

                <div class="paso-det__cuerpo">
                  <p class="paso-det__rotulo">En tu trabajo</p>
                  {p.trabajo.map((parrafo) => <p>{parrafo}</p>)}

                  {p.destacado && (
                    <div class="paso-det__pregunta">
                      <p>{p.destacado}</p>
                    </div>
                  )}

                  {p.joya && (
                    <div class="paso-det__joya">
                      <p>
                        <b>{p.joya.titulo}</b> {p.joya.texto}
                      </p>
                    </div>
                  )}

                  {p.decisiones && (
                    <ul class="decisiones">
                      {p.decisiones.map((d) => (
                        <li>
                          <span class="decisiones__rango">{d.rango}</span>
                          <b>{d.titulo}</b>
                          <p>{d.texto}</p>
                        </li>
                      ))}
                    </ul>
                  )}

                  <p class="paso-det__oficio">
                    <span>El oficio de construir software y tecnología</span>
                    {p.oficio}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        {/* Que la S regresa a la I no estaba dicho en ninguna parte del sitio,
            y es lo que separa un método de una lista de cinco pasos. Va como
            remate, no como sexto bloque. */}
        <p class="ciclo">
          Y con eso vuelves a empezar en <strong>Identificar</strong>. Es un
          ciclo, no una línea.
        </p>

        {/* Lo que era §08 "A dónde llegas". Se disolvió aquí el 27 ago 2026:
            es el cierre del método, no una sección aparte.

            Y ya NO dice "sales con tu propio equipo de agentes". Jorge: no
            necesariamente son agentes — puede ser una automatización
            determinista, un bot, una app, o solo alertas y correos. Decir
            "agentes" promete una forma específica, y encima la de moda. El
            arreglo sale del propio paso S: el NIVEL lo decides tú. */}
        <div class="llegada">
          <p class="kicker">A dónde llegas</p>
          <p class="llegada__frase">
            Llegas con una idea de dónde estás perdiendo tiempo y dinero. Sales
            con el sistema armado y con el criterio para decidir de qué tamaño
            tenía que ser.
          </p>
        </div>

        {/* El diagrama del proceso completo, debajo de la tabla que
            describe los mismos cinco pasos. */}
        {/* metodo-timeline.png sale de aquí: era furniture de video —
            horizontal, pensada para que el tiempo revele los nodos uno por
            uno. En una página todo aterriza de golpe y catorce hitos a lo
            ancho dan 80 px cada uno. La versión vertical que la reemplaza
            vive en /nosotros. La ranura se queda en el manifiesto por si
            vuelve (medios/BRIEF-historial.md §1). */}
      </div>
    </section>

    <!-- 04b · Dónde entra el método — el mapa de la empresa -->
    {/* Va DESPUÉS del acrónimo, no antes: primero el método, luego dónde
        aplica. Al revés el visitante ve trece áreas sin saber todavía qué se
        les hace. */}
    <section class="section-y bg-white">
      <div class="container">
        <div class="prose reveal">
          <p class="kicker">Dónde entra el método</p>
          <h2>Toda empresa es lo mismo en tres capas.</h2>
          <p class="lead">
            El método no cambia de área a área. Cambia a dónde lo apuntas y con
            qué capa te conviene empezar.
          </p>
        </div>

        <MapaEmpresa variante="limpio" />
      </div>
    </section>

    <!-- 06 · Los cinco principios -->
    <section class="section-y bg-white">
      <div class="container">
        <div class="prose reveal">
          <p class="kicker">Los principios</p>
          <h2>Cinco principios que no se negocian.</h2>
        </div>

        <ol class="principios">
          {
            principios.map((p) => (
              <li class="principios__item reveal">
                <p class="principios__par">
                  <b>{p.gana}</b>
                  <i>{p.nexo}</i>
                  <s>{p.pierde}</s>
                </p>
                <p class="principios__texto">{p.texto}</p>
              </li>
            ))
          }
        </ol>

        {/* El quinto no es una oposición: es la consecuencia de los otros
            cuatro. Por eso cierra el bloque en vez de formar fila con ellos. */}
        <p class="principios__remate reveal">
          <b>{principioFinal.titulo}.</b> {principioFinal.texto}
        </p>
      </div>
    </section>

    <!-- 07 · Así se arma por dentro -->
    <section class="section-y">
      <div class="container">
        <div class="prose reveal">
          <p class="kicker">Cómo se usa en la práctica</p>
          <h2>Así se arma por dentro.</h2>
          {/* Una sola idea, dicha una sola vez: el mapa correcto es el
              proceso, no el organigrama. Antes tomaba un párrafo largo que la
              decía tres veces. */}
          <p class="lead">
            El organigrama —personas asignadas a tareas— ya no es el mapa. El
            mapa es el proceso: qué entra, qué sale y qué de eso genera dinero.
            Rediseñas eso, y la IA ejecuta la parte que ya decidiste tú.
          </p>
        </div>

        {/* Las cuatro capturas del sistema de agentes, en un visor: a la
            izquierda los cuatro pasos, a la derecha la captura del que está
            seleccionado. La afirmación literal de la sección es "esto no son
            prompts", y estas capturas son la única forma de probarlo — pero
            apiladas nadie bajaba a verlas.

            CERO JAVASCRIPT. El selector son cuatro <input type="radio"> con el
            mismo `name`, cuatro <label for> y `:checked ~` para prender la
            vista. Los inputs van ANTES del grid y como hermanos suyos: sin eso
            el combinador `~` no alcanza ni la lista ni el panel.

            Los radios se ocultan con clip-path, NUNCA con display:none ni
            visibility:hidden — con esos salen del orden de tabulación y el
            visor deja de funcionar con teclado.

            Sin role="tablist" ni aria-selected a propósito: eso pide manejo de
            foco con JS y aquí mentiría. Con radios de verdad, el lector de
            pantalla ya lo anuncia como grupo de opciones —que es lo que es— y
            las flechas ya navegan entre ellas.

            Si falta una captura, Captura.astro pinta su Ranura y el visor
            sigue de pie: se ve el hueco con su ficha, no un panel vacío. */}
        {
          mostrar(...capturasPrompts.map((c) => c.id)) && (
            <div class="visor">
              {capturasPrompts.map((c, i) => (
                <input
                  class="visor__radio"
                  type="radio"
                  name="visor"
                  id={`v${i + 1}`}
                  checked={i === 0}
                />
              ))}

              <div class="visor__grid">
                <ul class="visor__lista">
                  {capturasPrompts.map((c, i) => (
                    <li>
                      <label class="visor__paso" for={`v${i + 1}`}>
                        <span class="visor__punta" aria-hidden="true" />
                        <span class="visor__num">
                          {String(i + 1).padStart(2, "0")}
                        </span>
                        <span class="visor__nombre">{porId(c.id)!.caption}</span>
                      </label>
                    </li>
                  ))}
                </ul>

                <div class="visor__panel">
                  {capturasPrompts.map((c) => (
                    <div class="visor__vista">
                      {/* El pie se apaga: la lista de la izquierda ya nombra lo
                          que estás viendo. */}
                      <Captura
                        id={c.id}
                        marco={c.marco}
                        ancho={900}
                        mostrarPie={false}
                      />
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )
        }
      </div>
    </section>

    <!-- 09 · El barco y las islas -->
    <section class="section-y">
      <div class="container prose reveal">
        <p class="kicker">Por qué se llama Ilhas</p>
        {/* Se cayó "Finanzas es la primera isla": el método es genérico y así
            quedó la bifurcación, y esta sección no puede volver a atar el
            nombre a una sola isla. Lo que entra en su lugar es la explicación
            que la banda del home NO da — ésta es la sección que le da sentido,
            y a la que cae quien vio la banda y le picó la curiosidad. */}
        <h2>El método es el barco. Las islas son a dónde lo apuntas.</h2>
        <p>
          <strong>Ilhas</strong> son islas, en portugués — a dónde apuntas el
          método. El método funciona en cualquier área donde haya números y
          decisiones que tomar.
        </p>
        <p class="hilas-remate">
          Y si mueves la <em>H</em> de lugar, las mismas cinco letras dicen{" "}
          <strong>Hilas</strong>: hilas tus procesos, hilas tus números, hilas
          tu criterio en una sola línea.
        </p>
        <p>
          El nombre y el paso más importante están hechos de las mismas letras.
        </p>
      </div>
    </section>

    <!-- 10 · Bifurcación -->
    <section class="section-y bg-white">
      <div class="container">
        <Bifurcacion
          heading="¿Lo aprendes, o lo implementamos por ti?"
          lead="Dos maneras de recibir el mismo método. Elige tu carril."
        />
      </div>
    </section>
  </article>
</Base>

<style>
  section > .container > h2,
  .metodo-hero h1 {
    margin-top: 0.75rem;
    max-width: 30ch;
  }

  section .lead,
  section > .container.prose > p:not(.kicker):not(.lead) {
    margin-top: 1.25rem;
  }

  .metodo-hero h1 {
    /* Página interior: más chico que el H1 del home a propósito — el
       home es el que recibe tráfico frío y debe ser el titular más
       grande del sitio. */
    max-width: 16ch;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
  }

  /* Las fuentes de §02: metadato discreto, no CTA. Mismo tratamiento que en
     el mapa del home — subrayado solo al hover. */
  .fuentes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    max-width: none;
  }

  .fuentes cite {
    font-style: normal;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6f6f7a;
  }

  .fuentes cite a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(111, 111, 122, 0.45);
  }

  .fuentes cite a:hover {
    color: var(--ilhas-primary);
    border-bottom-color: var(--ilhas-primary);
  }

  #pasos .prose {
    margin-bottom: 2.5rem;
  }

  /* --- Ranuras de medios ---
     Todos estos contenedores están vacíos hoy: sin archivo, el componente no
     pinta nada en producción y el margen de arriba no llega a aplicarse
     porque no hay caja. */
  .metodo-clip,
  .metodo-loop {
    margin-top: 2.5rem;
  }

  .metodo-clip,
  .metodo-loop {
    max-width: 48rem;
  }

  /* ======================================================================
     §07 · EL VISOR

     Referencia: medios/practica-referencia.html, copiada. Reemplaza la rejilla
     2×2 de la iteración 7 y, antes de ella, las cuatro capturas apiladas a
     ancho completo que hacían de esta la sección más alta del sitio.

     `.marco` y `.marco--terminal` NO se duplican aquí: viven en base.css y los
     pinta Captura.astro. Lo que se toca de la captura es solo su tamaño, y va
     con :global() porque el componente tiene su propio scope.
     ====================================================================== */
  .visor {
    margin-top: 2.5rem;
  }

  /* Fuera de la vista, DENTRO del teclado. clip-path y no display:none:
     con display:none o visibility:hidden el input sale del orden de
     tabulación y el visor se vuelve inoperable con teclado. */
  .visor__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }

  .visor__grid {
    display: grid;
    gap: 1.5rem;
  }

  /* Los cuatro llevan borde desde el reposo: sin él se leen como párrafos y
     nadie adivina que se les da clic. Con él se leen como fichas de un
     selector, y la activa es la única que se llena de blanco y levanta. */
  .visor__lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .visor__lista li + li {
    margin-top: 0.5rem;
  }

  .visor__paso {
    display: block;
    position: relative;
    cursor: pointer;
    padding: 0.8rem 2rem 0.8rem 1.35rem;
    border-radius: 10px;
    background: transparent;
    border: 1px solid rgba(14, 14, 15, 0.07);
    transition: background 0.2s ease, border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  /* La barra del carril: transparente en reposo, morada en el activo. Es la
     misma pieza, no dos — por eso la transición se ve continua. */
  .visor__paso::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 3px;
    border-radius: 3px;
    background: transparent;
    transition: background 0.2s ease;
  }

  .visor__num {
    display: block;
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    /* --ilhas-text, no un gris claro. La referencia usaba #8e8e9b, que sobre
       --ilhas-light mide 3.10:1 y es texto de 12 px: falla AA. Bajarlo a
       #75757f tampoco alcanza (4.36:1), y tokens.css prohíbe inventar grises
       —"para texto pequeño usa --ilhas-text o --ilhas-dark sólidos"—. La
       jerarquía contra el nombre ya la hacen el tamaño, el tracking y el peso,
       y al activarse el número se pone violeta. */
    color: var(--ilhas-text);
    transition: color 0.2s ease;
  }

  .visor__nombre {
    display: block;
    margin-top: 0.15rem;
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.35;
    color: var(--ilhas-text);
    transition: color 0.2s ease;
  }

  .visor__paso:hover {
    background: var(--ilhas-white);
    border-color: var(--ilhas-gray);
  }

  /* La punta de la ficha activa apunta a la imagen: explica la sección sin una
     sola palabra de instrucciones. Solo en escritorio — en móvil la imagen va
     arriba y no apuntaría a nada. */
  .visor__punta {
    display: none;
  }

  /* Altura reservada: sin ella la sección brinca al cambiar de vista, porque
     las cuatro capturas tienen proporciones muy distintas (1.37, 2.00, 4.81 y
     0.95). Las cuatro vistas comparten la misma celda y el marco abraza su
     imagen: lo que sobra es el fondo de la sección, no una caja vacía. */
  .visor__panel {
    display: grid;
    align-items: center;
    justify-items: center;
    min-height: 22rem;
  }

  .visor__vista {
    grid-area: 1 / 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.28s ease, transform 0.28s ease;
  }

  .visor__vista :global(.captura),
  .visor__vista :global(.marco) {
    max-width: 100%;
  }

  /* `width: auto` en vez del `width: 100%` que trae Captura.astro: aquí el
     marco tiene que abrazar la imagen, no estirarse a la columna. */
  .visor__vista :global(.captura__img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 20rem;
  }

  /* --- el interruptor, todo con `:checked ~` ---------------------------- */
  #v1:checked ~ .visor__grid .visor__panel .visor__vista:nth-child(1),
  #v2:checked ~ .visor__grid .visor__panel .visor__vista:nth-child(2),
  #v3:checked ~ .visor__grid .visor__panel .visor__vista:nth-child(3),
  #v4:checked ~ .visor__grid .visor__panel .visor__vista:nth-child(4) {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  #v1:checked ~ .visor__grid label[for="v1"],
  #v2:checked ~ .visor__grid label[for="v2"],
  #v3:checked ~ .visor__grid label[for="v3"],
  #v4:checked ~ .visor__grid label[for="v4"] {
    background: var(--ilhas-white);
    border-color: var(--ilhas-gray);
    box-shadow: 0 1px 2px rgba(14, 14, 15, 0.04),
      0 10px 28px rgba(14, 14, 15, 0.06);
  }

  #v1:checked ~ .visor__grid label[for="v1"] .visor__punta,
  #v2:checked ~ .visor__grid label[for="v2"] .visor__punta,
  #v3:checked ~ .visor__grid label[for="v3"] .visor__punta,
  #v4:checked ~ .visor__grid label[for="v4"] .visor__punta {
    border-left-color: var(--ilhas-gray);
  }

  #v1:checked ~ .visor__grid label[for="v1"]::before,
  #v2:checked ~ .visor__grid label[for="v2"]::before,
  #v3:checked ~ .visor__grid label[for="v3"]::before,
  #v4:checked ~ .visor__grid label[for="v4"]::before {
    background: var(--ilhas-primary);
  }

  #v1:checked ~ .visor__grid label[for="v1"] .visor__num,
  #v2:checked ~ .visor__grid label[for="v2"] .visor__num,
  #v3:checked ~ .visor__grid label[for="v3"] .visor__num,
  #v4:checked ~ .visor__grid label[for="v4"] .visor__num {
    color: var(--ilhas-primary);
  }

  #v1:checked ~ .visor__grid label[for="v1"] .visor__nombre,
  #v2:checked ~ .visor__grid label[for="v2"] .visor__nombre,
  #v3:checked ~ .visor__grid label[for="v3"] .visor__nombre,
  #v4:checked ~ .visor__grid label[for="v4"] .visor__nombre {
    color: var(--ilhas-dark);
    font-weight: 600;
  }

  /* El input no se ve, así que el anillo de foco lo pinta su label. */
  #v1:focus-visible ~ .visor__grid label[for="v1"],
  #v2:focus-visible ~ .visor__grid label[for="v2"],
  #v3:focus-visible ~ .visor__grid label[for="v3"],
  #v4:focus-visible ~ .visor__grid label[for="v4"] {
    outline: 2px solid var(--ilhas-primary);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .visor__vista,
    .visor__paso,
    .visor__paso::before,
    .visor__num,
    .visor__nombre {
      transition: none;
    }
  }

  @media (min-width: 900px) {
    .visor__grid {
      grid-template-columns: minmax(0, 17.5rem) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }

    .visor__panel {
      min-height: 26rem;
    }

    .visor__vista :global(.captura__img) {
      max-height: 24rem;
    }

    .visor__punta {
      display: block;
      position: absolute;
      right: -1px;
      top: 50%;
      width: 0;
      height: 0;
      transform: translate(100%, -50%);
      border-block: 7px solid transparent;
      border-left: 8px solid transparent;
      transition: border-left-color 0.2s ease;
    }
  }

  /* En móvil el panel va primero: la imagen es la prueba, la lista es su
     índice. El orden del DOM no cambia — solo el visual, con `order` — así el
     teclado y el lector de pantalla siguen leyendo lista → panel. */
  @media (max-width: 899px) {
    .visor__panel {
      order: -1;
      min-height: 17rem;
    }

    .visor__vista :global(.captura__img) {
      max-height: 16.5rem;
    }

    .visor__paso {
      padding-left: 1.1rem;
    }
  }

  /* ======================================================================
     §01 · La ayuda de "mover la aguja"

     <details> nativo, cero JS. El summary se lee como texto del cuerpo con una
     flecha discreta, no como botón: es una nota al margen, no una acción. Al
     abrirse añade una línea, no un bloque — el brief pide que el salto sea
     corto.
     ====================================================================== */
  .ayuda {
    max-width: none;
    margin-top: 0.35rem;
    font-size: 0.9375rem;
  }

  .ayuda summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    cursor: pointer;
    list-style: none;
    color: var(--ilhas-primary);
    text-decoration: underline;
    text-decoration-color: rgba(122, 60, 255, 0.35);
    text-underline-offset: 3px;
  }

  /* Safari sigue pintando su triángulo propio con ::-webkit-details-marker
     aunque `list-style: none` esté puesto. */
  .ayuda summary::-webkit-details-marker {
    display: none;
  }

  .ayuda summary::before {
    content: "";
    width: 0;
    height: 0;
    border-left: 5px solid currentColor;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    transition: transform 0.15s ease;
  }

  .ayuda[open] summary::before {
    transform: rotate(90deg);
  }

  .ayuda summary:hover {
    text-decoration-color: currentColor;
  }

  .ayuda > p {
    margin-top: 0.4rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--ilhas-gray);
    color: var(--ilhas-text);
  }

  /* ======================================================================
     §02 · Las tres capas y el dato de Ng
     ====================================================================== */
  .capas__titulo {
    margin-top: 2rem;
    max-width: 30ch;
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: var(--ilhas-tracking-display);
    color: var(--ilhas-dark);
  }

  .capas {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    max-width: none;
    border: 1px solid var(--ilhas-gray);
    border-radius: var(--ilhas-radius-card);
    overflow: hidden;
    background: var(--ilhas-white);
  }

  .capa-ia {
    display: grid;
    gap: 0.15rem 1.5rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--ilhas-gray);
  }

  .capa-ia:last-child {
    border-bottom: none;
  }

  .capa-ia b {
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--ilhas-dark);
    letter-spacing: var(--ilhas-tracking-display);
  }

  .capa-ia span {
    font-size: 0.9375rem;
    color: var(--ilhas-text);
  }

  /* La marca de propiedad es lo que hace el argumento: las dos que son tuyas
     se ven distintas de la que es de todos. */
  .capa-ia em {
    font-style: normal;
    font-size: 0.8125rem;
    color: var(--ilhas-text);
  }

  .capa-ia--tuya {
    background: rgba(122, 60, 255, 0.045);
  }

  .capa-ia--tuya em {
    font-weight: 600;
    color: var(--ilhas-primary);
  }

  .ng {
    margin-top: 2rem;
    padding: 1.5rem;
    border-radius: var(--ilhas-radius-card);
    background: var(--ilhas-light);
    border: 1px solid var(--ilhas-gray);
  }

  .ng__intro,
  .ng__que,
  .ng__remate,
  .ng__cierre {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ilhas-text);
  }

  .ng__que {
    margin-top: 0.65rem;
  }

  .ng__remate {
    margin-top: 1rem;
  }

  .ng__cierre {
    margin-top: 0.65rem;
  }

  /* --- la figura ---------------------------------------------------------
     Tres barras horizontales. El trabajo del dato es comparar magnitudes con
     una identidad compartida entre dos de las tres, así que: barras, y color
     por modelo. Cero JavaScript — el largo es un `width` en porcentaje.

     Sin ejes, sin cuadrícula, sin leyenda: cada barra ya trae su modelo y su
     cifra escritos, y una leyenda repetiría lo que está a un centímetro. */
  .fig {
    margin-top: 1.1rem;
  }

  .fig__barras {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .barra {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.15rem 0.75rem;
    align-items: baseline;
  }

  .barra__rotulo {
    grid-column: 1;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--ilhas-text);
  }

  .barra__rotulo b {
    font-weight: 600;
    color: var(--ilhas-dark);
  }

  .barra__cifra {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--ilhas-font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--ilhas-text);
    /* Cifras tabulares: los tres números quedan alineados por su punto. */
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .barra__via {
    grid-column: 1 / -1;
    grid-row: 2;
    height: 10px;
    border-radius: 5px;
    background: rgba(14, 14, 15, 0.06);
  }

  /* Pizarra fría, deliberadamente recesiva: no compite con el morado. NO
     cumple el piso de croma a propósito —lee como gris— porque no es una
     categoría que pelee por atención, es el punto de referencia. Y la
     identidad nunca va sola en el color: cada barra trae su modelo escrito.

     #8481A0 y no el #8C8AA8 de la referencia. Medido: contra la vía, el
     original da 2.81:1 y no llega al piso de 3:1 que WCAG 1.4.11 pide para un
     elemento gráfico que porta información — y aquí el largo de la barra ES el
     dato, así que dónde termina tiene que verse. Este da 3.15:1 con el mismo
     croma (31) y apenas ocho puntos de luminosidad menos: sigue leyéndose como
     gris frío. */
  .barra__marca {
    display: block;
    height: 100%;
    border-radius: 5px;
    background: #8481a0;
  }

  /* Mismo modelo, mismo color. Lo que cambia entre las dos es el LARGO, que es
     justo el argumento. */
  .barra--nuestro .barra__marca {
    background: var(--ilhas-primary);
  }

  .barra--nuestro .barra__cifra {
    color: var(--ilhas-primary);
  }

  /* La llave que agrupa las dos de GPT-3.5. Solo en escritorio: en móvil el
     color y los rótulos ya lo dicen, y una llave vertical de 20 px estorba. */
