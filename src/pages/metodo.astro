---
import Base from "../layouts/Base.astro";
import Bifurcacion from "../components/Bifurcacion.astro";
import MapaEmpresa from "../components/MapaEmpresa.astro";
import Captura from "../components/medios/Captura.astro";
import Loop from "../components/medios/Loop.astro";
import VideoClip from "../components/medios/VideoClip.astro";
import { mostrar } from "../lib/medios";

// §07 "No son prompts": las cuatro capturas del sistema de agentes. Es la
// única prueba de la afirmación que da título a la sección — el bloque más
// importante de todo el plan de medios.
const capturasPrompts = [
  { id: "metodo-prompts-01", marco: "navegador" as const },
  { id: "metodo-prompts-02", marco: "navegador" as const },
  { id: "metodo-prompts-03", marco: "terminal" as const },
  { id: "metodo-prompts-04", marco: "navegador" as const },
];

// §02 · Las tres capas de un resultado con IA. Es lo que sostiene el "y no es
// la tecnología" del H2: de las tres, la única que compartes con tu competencia
// es la que no puedes mejorar.
const capasIA = [
  {
    nombre: "El modelo",
    que: "El motor",
    dueno: "De todos. Es el mismo para ti y para tu competencia",
    tuya: false,
  },
  {
    nombre: "El andamiaje",
    que: "El flujo, las herramientas, los pasos que lo rodean",
    dueno: "Tuyo",
    tuya: true,
  },
  {
    nombre: "El conductor",
    que: "El contexto que le das, cómo lo corriges, cómo lo diriges",
    dueno: "Tuyo",
    tuya: true,
  },
];

// Andrew Ng, The Batch (DeepLearning.AI), 20 mar 2024, sobre HumanEval.
// Los porcentajes van literales y SIN redondear.
const humanEval = [
  { condicion: "GPT-3.5 solo", resultado: "48.1 %", destacada: false },
  { condicion: "GPT-4 solo", resultado: "67.0 %", destacada: false },
  {
    condicion: "GPT-3.5 con un flujo de trabajo agéntico alrededor",
    resultado: "hasta 95.1 %",
    destacada: true,
  },
];

/**
 * §04 · Los cinco pasos.
 *
 * El contenido sale LITERAL de `docs/07-metodo-detalle.md`, que es la
 * definición canónica dictada por Jorge. Si esto y ese documento difieren,
 * manda el documento.
 *
 * La jerarquía está invertida respecto a lo que había antes: `trabajo` es el
 * protagonista y `oficio` es secundario. "Producto" a secas no lo decodifica un
 * contador ni un dueño de empresa, así que la etiqueta es "el oficio de
 * construir software y tecnología", completa.
 */
const pasos = [
  {
    letra: "I",
    paso: "Identificar",
    trabajo: [
      "Encontrar el lugar: los procesos y workflows dentro de tu trabajo, quién los hace, y por qué se hacen así. Entender cómo se mueve el dinero, dónde se fuga y qué impacto tiene eso en tu negocio.",
      "Después mapeas tus prioridades y las ordenas, para saber en qué orden vas a ir optimizando y a cuál le vas a subir el valor primero.",
    ],
    // La idea más filosa del paso, y hasta hoy no estaba dicha en el sitio.
    destacado: "¿Qué no debería existir en estos procesos?",
    destacadoPie:
      "Identificar no es solo encontrar qué mejorar — es encontrar qué sobra.",
    oficio: "Discovery — instrumentar y hallar el dolor antes de construir",
  },
  {
    letra: "L",
    paso: "Levantamiento",
    trabajo: [
      "De los procesos que identificaste: entender tus datos. Qué datos tienes y dónde los tienes.",
      "Luego limpiarlos y ponerlos en un solo lugar. Y ser específico en una cosa: cuál es el dato y la métrica que quieres mover, y por qué.",
      "Para eso puedes traer referencias de cómo lo hacen los mejores —sus estándares— y entenderlos para aplicarlos tú.",
    ],
    oficio: "Continuous Discovery — levantar la información y el estándar",
  },
  {
    letra: "H",
    paso: "Hilar",
    trabajo: [
      "Tener un mapeo de: proceso → paso del proceso → dato → métrica que quieres mejorar, optimizar o a la que le quieres subir el valor. Ahí entiendes los dolores y las oportunidades de mejora.",
      "Con eso sabes cómo lo puedes mejorar y cómo va a cambiar la métrica. Y defines un objetivo: hacia dónde quieres mover ese KPI, de forma que te lleve a un resultado medible en tu proceso — y que además esté conectado a mejorar el margen, los costos o los precios.",
    ],
    oficio: "Opportunity Solution Tree — enhebrar piezas sueltas en un solo resultado",
  },
  {
    letra: "A",
    paso: "Accionar",
    trabajo: [
      "Estableces el plan de acción: qué solución, qué vas a hacer y qué vas a eliminar.",
      "Y haces pruebas baratas —prototipos, automatizaciones chicas— que te digan si lo que estás haciendo efectivamente va a mover la aguja y la métrica que definiste. No te la juegas construyendo grande antes de saberlo.",
      // Autorizado por Jorge; no venía en el dictado.
      "Antes de construir a la medida, la prueba más barata a veces es usar algo que ya existe para entender el proceso de verdad. No siempre se compra — pero saltarse esa pregunta es cómo se acaba construyendo algo caro para un proceso que no se entendía.",
    ],
    oficio: "Assumption testing + POC — decidir con datos",
  },
  {
    letra: "S",
    paso: "Sistematizar",
    trabajo: [
      "Ya sabes que funciona, está validado y platicado. Ahora sí: usar la IA como tu equipo, bajo un método, no suelta.",
    ],
    // Jorge marcó explícitamente cuál es "lo más importante" y cuál "lo
    // segundo": son dos decisiones, no dos frases más.
    decisiones: [
      {
        rango: "Lo más importante",
        titulo: "Qué nivel de tecnología le aplicas",
        texto:
          "¿Basta con una automatización? ¿Un bot? ¿Un agente? ¿Skills? ¿Una aplicación completa? ¿O con alertas y correos ya la armaste? Escoger de más cuesta dinero; escoger de menos no resuelve.",
      },
      {
        rango: "Lo segundo",
        titulo: "Cómo vas a mantener esa solución",
        // Autorizado por Jorge; no venía en el dictado.
        texto:
          "Lo que rompe la confianza en una solución con IA no es que se equivoque: es que nadie revisó. Un error detectado es mantenimiento; un error publicado es credibilidad perdida. La solución no termina cuando funciona — termina cuando alguien la está cuidando.",
      },
    ],
    oficio: "Delivery + automatización — el motor que corre solo",
  },
];

const principios = [
  {
    titulo: "Fundamento antes que automatización",
    texto: "Primero el criterio. Automatizas después, no antes.",
  },
  {
    titulo: "La IA es infraestructura, no un feature",
    texto:
      "No es un plus que agregas al final: es la base sobre la que construyes.",
  },
  {
    titulo: "Workflows sobre roles",
    texto:
      "No organizas personas haciendo tareas. Organizas el proceso completo, de principio a fin.",
  },
  {
    titulo: "Outcomes sobre outputs",
    texto: "No mides cuánto produces. Mides qué cambia con lo que produces.",
  },
  {
    titulo: "Builder mindset",
    texto: "Construyes el sistema. No pides que alguien más te lo construya.",
  },
];
---

<Base
  title="El Método"
  description="I·L·H·A·S: el sistema con el que Ilhas convierte criterio en decisiones, tomado del oficio de construir software y tecnología."
>
  <article>
    {/* 01 · La tesis — reescrita el 27 ago 2026.
        Antes decía "El método no nació en las finanzas". Se cayó: definirse
        por lo que NO eres es débil, y "producto" a secas no lo decodifica un
        contador ni un dueño de empresa. Ahora se define por lo que sí es.
        Un solo gradiente en el titular (tokens.css). */}
    <section class="section-y">
      <div class="container prose metodo-hero reveal">
        <p class="kicker">El método</p>
        <h1>
          El método nació construyendo{" "}
          <span class="text-gradient">tecnología</span>, a lo largo de más de 12
          años.
        </h1>
        <p class="lead">
          Esa tecnología ha tenido un impacto enorme en sus usuarios.
        </p>
        <p>
          Lo que te enseñamos es el sistema para producir soluciones que te
          ayuden a ti y a tus clientes a <strong>mover la aguja</strong> de lo
          que quieran mover — con tus procesos y las herramientas que ya tienes
          a la mano.
        </p>

        {/* Primera aparición de "mover la aguja" en todo el sitio, y hasta hoy
            no estaba definida en ninguna parte (docs/07-metodo-detalle.md
            § Vocabulario). <details> nativo: cero JS. Nada de title="", que ni
            lo lee un lector de pantalla ni existe en táctil. */}
        <details class="ayuda">
          <summary>¿qué es mover la aguja?</summary>
          <p>Cumplir el objetivo que te planteaste.</p>
        </details>

        <p>
          El método te ayuda a saber <strong>cómo pensar</strong>, a mejorar tus
          procesos y a crear más valor.
        </p>
      </div>
    </section>

    <!-- 02 · El hueco -->
    <section class="section-y bg-white">
      <div class="container prose reveal">
        <p class="kicker">El hueco</p>
        <h2>
          El 95% de los proyectos de IA no muestra retorno medible. Y no es la
          tecnología.
        </h2>
        <p>
          Falla por falta de criterio. Métele basura a un modelo y no obtienes
          basura: obtienes basura al cuadrado — la IA no corrige un mal
          razonamiento, lo amplifica. Por eso el fundamento importa más ahora
          que antes, no menos.
        </p>

        {/* El H2 afirma "y no es la tecnología". Hasta hoy nada lo demostraba:
            el cuerpo repetía la afirmación en vez de sostenerla. Las tres capas
            son lo que la sostiene, y el dato de Ng es lo que la prueba. */}
        <h3 class="capas__titulo">
          Un resultado con IA tiene tres capas, y solo una es el modelo.
        </h3>

        <ul class="capas">
          {
            capasIA.map((c) => (
              <li class:list={["capa-ia", c.tuya && "capa-ia--tuya"]}>
                <b>{c.nombre}</b>
                <span>{c.que}</span>
                <em>{c.dueno}</em>
              </li>
            ))
          }
        </ul>

        <p>
          De las tres, la que todos comparten es la única que no puedes mejorar.
          <strong>
            {" "}Las dos que sí deciden el resultado son las que nadie te va a
            dar hecho.
          </strong>{" "}
          Por eso el mismo modelo produce resultados abismalmente distintos
          según quién lo maneje.
        </p>

        {/* Dato verificado, va literal y sin redondear. Se cita a Andrew Ng,
            que es de quien es, no a terceros que lo repiten. */}
        <div class="ng">
          <p class="ng__intro">
            Andrew Ng lo midió en la prueba de programación HumanEval:
          </p>
          <ul class="ng__filas">
            {
              humanEval.map((f) => (
                <li class:list={["ng__fila", f.destacada && "ng__fila--destacada"]}>
                  <span>{f.condicion}</span>
                  <b>{f.resultado}</b>
                </li>
              ))
            }
          </ul>
          <p class="ng__remate">
            Un modelo peor con mejor sistema le ganó a un modelo mejor sin
            sistema. Y no por poco:{" "}
            <strong>
              la diferencia que hace el andamiaje es más grande que la
              diferencia entre las dos generaciones de modelo.
            </strong>
          </p>
        </div>

        <p>
          La otra mitad del problema es el proceso. Automatizar uno que está mal
          no lo arregla —{" "}
          <strong>lo hace fallar más rápido y a mayor escala.</strong> Todos
          venden automatizar más. Nosotros empezamos por quitar.
        </p>

        <p class="pregunta">¿Qué no debería existir en estos procesos?</p>

        {/* Las tres fuentes, literales y verificadas
            (prompts/iteracion-4-hueco.md §2). El MAPA no se duplica aquí: §04
            ya desarma los cinco pasos en profundidad, y meterlo arriba sería
            decir lo mismo dos veces en la misma página. */}
        <p class="fuentes">
          <cite>MIT · The GenAI Divide, 2025</cite>
          <cite>
            <a
              href="https://www.cisco.com/c/m/en_us/solutions/ai/readiness-index.html"
              target="_blank"
              rel="noopener"
            >
              Cisco AI Readiness Index 2025
            </a>
          </cite>
          <cite>
            <a
              href="https://www.gartner.com/en/newsroom/press-releases/2024-07-29-gartner-predicts-30-percent-of-generative-ai-projects-will-be-abandoned-after-proof-of-concept-by-end-of-2025"
              target="_blank"
              rel="noopener"
            >
              Gartner · pronóstico 2024
            </a>
          </cite>
          <cite>
            <a
              href="https://www.deeplearning.ai/the-batch/how-agents-can-improve-llm-performance"
              target="_blank"
              rel="noopener"
            >
              Andrew Ng · The Batch, 20 mar 2024
            </a>
          </cite>
        </p>
      </div>
    </section>

    <!-- 03 · El ángulo correcto -->
    <section class="section-y">
      <div class="container prose reveal">
        <p class="kicker">El ángulo correcto</p>
        <h2>No es una metáfora. Es de dónde salió el método.</h2>

        {/* El texto es el de siempre —a Jorge le gusta— partido en las tres
            ideas que ya traía apelmazadas, y con las palabras que cargan el
            argumento en <strong>. Sin color nuevo y sin gradiente.
            El puente con §02: allá se dice POR QUÉ falla, aquí DE DÓNDE salió
            lo que no falla. */}
        <p>
          Arriba está por qué fallan los proyectos de IA. Esto es de dónde sale
          lo que no falla.
        </p>
        <p>
          El Método Ilhas se parece al oficio de construir software y tecnología
          porque <strong>nació ahí</strong> — no es una comparación, es el
          origen.
        </p>
        <p>
          No te estamos comparando con nadie: te estamos entregando{" "}
          <strong>el mismo sistema</strong> que usa quien construye tecnología,
          apuntado a tu trabajo. Sin volverte técnico. Sin esperar a que entre
          un equipo de ingeniería.
        </p>

        {/* Lo que faltaba: §03 prometía "sin volverte técnico" y no explicaba
            por qué eso es posible. Esto lo convierte de promesa a explicación. */}
        <p class="remate-angulo">
          Saber el <em>qué</em> no te obliga a aprender el <em>cómo</em>.
        </p>
        <p>
          El agobio con la IA no es de capacidad, es de{" "}
          <strong>filtro</strong>: hay demasiadas herramientas y demasiado
          ruido. El método es el filtro — te dice qué resolver y en qué orden, y
          el <em>cómo</em> técnico se escoge después, en el paso{" "}
          <strong>Sistematizar</strong>.
        </p>
      </div>
    </section>

    <!-- 04 · I·L·H·A·S paso por paso -->
    <section class="section-y bg-dark" id="pasos">
      <div class="container">
        <div class="prose reveal">
          <p class="kicker">El método, paso por paso</p>
          <h2>Cinco pasos. Un mapeo directo a tu trabajo.</h2>
          <p class="lead">
            I·L·H·A·S no es un acrónimo bonito: cada letra es un paso real,
            tomado del oficio de construir software y tecnología y apuntado a tus
            números.
          </p>
        </div>

        {/* Deja de ser tabla. Con el detalle largo de docs/07, cinco celdas de
            ~80 palabras eran ilegibles: la tabla forzaba a leer en horizontal
            algo que se piensa en vertical. Cinco bloques apilados, con "En tu
            trabajo" de protagonista y el oficio de pie de página.
            El badge es el mismo tratamiento que el mapa de §02 del home. */}
        <ol class="pasos">
          {
            pasos.map((p) => (
              <li class="paso-det">
                <div class="paso-det__cabeza">
                  <span class="paso-det__letra" aria-hidden="true">
                    {p.letra}
                  </span>
                  <h3>{p.paso}</h3>
                </div>

                <div class="paso-det__cuerpo">
                  <p class="paso-det__rotulo">En tu trabajo</p>
                  {p.trabajo.map((parrafo) => <p>{parrafo}</p>)}

                  {p.destacado && (
                    <div class="paso-det__pregunta">
                      <p>{p.destacado}</p>
                      <span>{p.destacadoPie}</span>
                    </div>
                  )}

                  {p.decisiones && (
                    <ul class="decisiones">
                      {p.decisiones.map((d) => (
                        <li>
                          <span class="decisiones__rango">{d.rango}</span>
                          <b>{d.titulo}</b>
                          <p>{d.texto}</p>
                        </li>
                      ))}
                    </ul>
                  )}

                  <p class="paso-det__oficio">
                    <span>El oficio de construir software y tecnología</span>
                    {p.oficio}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        {/* Que la S regresa a la I no estaba dicho en ninguna parte del sitio,
            y es lo que separa un método de una lista de cinco pasos. Va como
            remate, no como sexto bloque. */}
        <p class="ciclo">
          Y con eso vuelves a empezar en <strong>Identificar</strong>. No es una
          lista de cinco pasos: es un ciclo que se mantiene.
        </p>

        {/* El diagrama del proceso completo, debajo de la tabla que
            describe los mismos cinco pasos. */}
        {/* metodo-timeline.png sale de aquí: era furniture de video —
            horizontal, pensada para que el tiempo revele los nodos uno por
            uno. En una página todo aterriza de golpe y catorce hitos a lo
            ancho dan 80 px cada uno. La versión vertical que la reemplaza
            vive en /nosotros. La ranura se queda en el manifiesto por si
            vuelve (medios/BRIEF-historial.md §1). */}
      </div>
    </section>

    <!-- 04b · Dónde entra el método — el mapa de la empresa -->
    {/* Va DESPUÉS del acrónimo, no antes: primero el método, luego dónde
        aplica. Al revés el visitante ve trece áreas sin saber todavía qué se
        les hace. */}
    <section class="section-y bg-white">
      <div class="container">
        <div class="prose reveal">
          <p class="kicker">Dónde entra el método</p>
          <h2>Toda empresa es lo mismo en tres capas.</h2>
          <p class="lead">
            El método no cambia de área a área. Lo que cambia es a dónde lo
            apuntas — y con qué capa te conviene empezar.
          </p>
        </div>

        <MapaEmpresa variante="limpio" />
      </div>
    </section>

    <!-- 05 · Hilar = Opportunity Solution Tree -->
    <section class="section-y">
      <div class="container prose reveal">
        <p class="kicker">El paso joya</p>
        <h2>Hilar: el paso que nadie en &ldquo;finanzas con IA&rdquo; te cuenta.</h2>
        <p>
          Hilar es enhebrar piezas sueltas en una sola línea. En construcción
          de producto eso tiene nombre — Opportunity Solution Tree: tomar
          oportunidades dispersas y anclarlas a un solo resultado. Mismo
          verbo, mismo trabajo. Aplicado a tus números, es lo que convierte
          costos, precios y márgenes sueltos en un solo criterio de decisión.
        </p>

        {/* La prueba va DESPUÉS de la afirmación (regla 3 de curaduría). */}
        {
          mostrar("metodo-hilar-clip") && (
            <div class="metodo-clip">
              <VideoClip id="metodo-hilar-clip" />
            </div>
          )
        }
      </div>
    </section>

    <!-- 06 · Los cinco principios -->
    <section class="section-y bg-white">
      <div class="container">
        <div class="prose reveal">
          <p class="kicker">Los principios</p>
          <h2>Cinco principios que no se negocian.</h2>
        </div>

        <ol class="principios">
          {
            principios.map((p, i) => (
              <li class="principios__item hover-lift reveal">
                <span class="principios__num">{i + 1}</span>
                <div>
                  <p class="principios__titulo">{p.titulo}</p>
                  <p class="principios__texto">{p.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 07 · No son prompts -->
    <section class="section-y">
      <div class="container">
        <div class="prose reveal">
          <p class="kicker">Cómo se usa en la práctica</p>
          <h2>No son prompts. Es reingeniería del trabajo.</h2>
          <p>
            Esto no es una colección de prompts que copias y pegas. El
            organigrama clásico — personas asignadas a tareas — ya no es el
            mapa correcto. El mapa correcto es el proceso: qué entra, qué sale,
            y qué de eso genera dinero. Rediseñas eso, y la IA ejecuta la parte
            que ya decidiste tú.
          </p>
        </div>

        {/* Las cuatro capturas del sistema de agentes. La afirmación
            literal de la sección es "esto no son prompts": estas capturas
            son la única forma de probarlo. */}
        {
          mostrar(...capturasPrompts.map((c) => c.id)) && (
            <div class="prompts">
              {capturasPrompts.map((c) => <Captura id={c.id} marco={c.marco} ancho={900} />)}
            </div>
          )
        }
      </div>
    </section>

    <!-- 08 · BYOS → BYOA -->
    <section class="section-y bg-white">
      <div class="container">
        <div class="prose reveal">
          <p class="kicker">A dónde llegas</p>
          <h2>
            Llegas con tu hoja de cálculo. Sales con tu propio equipo de
            agentes.
          </h2>
          <p>
            Empiezas resolviendo con lo que ya tienes: un Excel, un Sheets, tu
            criterio. Terminas con algo distinto — un ecosistema de agentes de
            IA que trabaja para ti, diseñado por ti. No llegas a tu empresa a
            pedir herramientas. Llegas con el sistema ya armado.
          </p>
        </div>

        {/* "Varios agentes en paralelo" es abstracto hasta que se ve. */}
        {
          mostrar("metodo-agentes-loop") && (
            <div class="metodo-loop">
              <Loop id="metodo-agentes-loop" />
            </div>
          )
        }
      </div>
    </section>

    <!-- 09 · El barco y las islas -->
    <section class="section-y">
      <div class="container prose reveal">
        <p class="kicker">Por qué se llama Ilhas</p>
        <h2>El método es el barco. Finanzas es la primera isla.</h2>
        <p>
          Ilhas significa islas, en portugués. El método —I·L·H·A·S— es el
          barco: te lleva. Finanzas es la primera isla a la que apunta. El
          método funciona en cualquier área donde haya números y decisiones
          que tomar. Empezamos por finanzas.
        </p>
      </div>
    </section>

    <!-- 10 · Bifurcación -->
    <section class="section-y bg-white">
      <div class="container">
        <Bifurcacion
          heading="¿Lo aprendes, o lo implementamos por ti?"
          lead="Dos maneras de recibir el mismo método. Elige tu carril."
        />
      </div>
    </section>
  </article>
</Base>

<style>
  section > .container > h2,
  .metodo-hero h1 {
    margin-top: 0.75rem;
    max-width: 30ch;
  }

  section .lead,
  section > .container.prose > p:not(.kicker):not(.lead) {
    margin-top: 1.25rem;
  }

  .metodo-hero h1 {
