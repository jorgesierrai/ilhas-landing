    .cuerpo{flex:0 1 30rem}

    .enlaces{margin-top:.4rem;max-width:none;gap:.34rem}
    /* El alto de estas filas no lo manda `min-height` —el contenido ya pasa de
       58 px— lo manda el padding. 58 px es el objetivo táctil de un PULGAR; con
       ratón sobra, y .4rem devuelve 32 px repartidos en las cinco filas. */
    .enlace{min-height:0;padding:.32rem 1.05rem}
    .bio__linea{margin-top:.4rem}
    .pie{margin-top:.7rem}
