---
/**
 * /jorgesierra — el link in bio.
 * Referencia: medios/bio-referencia.html (896 px en 390×844 · 900 en escritorio).
 *
 * GENÉRICA A PROPÓSITO. La misma URL sirve para la slide de una masterclass,
 * para el perfil de Instagram y para el de TikTok: sin parámetros, sin
 * variantes, sin saludos de evento. Una sola página que no caduca — y por eso
 * el QR impreso tampoco caduca.
 *
 * NO USA `Base.astro`, y no es descuido: ese layout mete el menú y el pie del
 * sitio, y aquí los dos sobran. Un link in bio con navegación deja de ser un
 * link in bio. Por eso el documento va completo aquí, con `tokens.css` para las
 * variables y `base.css` para las @font-face (las tres viven ahí).
 *
 * JAVASCRIPT: SÓLO GA4. La versión anterior del brief traía un saludo
 * condicional con `?src=`; Jorge lo quitó al hacerla genérica, así que la
 * página no necesita JS propio y no lo tiene. Lo único que carga es la
 * analítica, y va repetida aquí porque esta página no hereda el <head> de
 * `Base.astro`. Nada más entra: los botones, el foco y los estados son CSS.
 *
 * SIN `noindex`: es la página personal de Jorge y debe poder encontrarse.
 */
import "../styles/tokens.css";
import "../styles/base.css";

const TITULO = "Jorge Sierra";
const LINEA = "Enseño a convertir el caos en dinero.";

/**
 * ⚠️ EL TIKTOK ES `@jorgesierrai`, CON i AL FINAL. La slide que Jorge proyecta
 * dice `@jorgesierra` —sin la i— y ésa manda a una cuenta que no es suya. La
 * fuente de verdad es src/data/personas.ts. Está reportado para que corrija la
 * slide; aquí va el correcto.
 */
/**
 * `grupo` parte la lista en dos, con un rótulo en medio. Se filtra por este
 * campo y NO con `.slice(0, 3)`: un índice se rompe callado el día que alguien
 * reordene un enlace, y el rótulo quedaría en medio de la nada.
 */
const enlaces = [
  {
    href: "https://www.instagram.com/soyjorgesierra",
    grupo: "redes",
    label: "Instagram",
    sub: "@soyjorgesierra",
    icono: "instagram",
    fuera: true,
  },
  {
    href: "https://www.tiktok.com/@jorgesierrai",
    grupo: "redes",
    label: "TikTok",
    sub: "@jorgesierrai",
    icono: "tiktok",
    fuera: true,
  },
  {
    // ⚠️ SIN el `?si=…` que traía el enlace que pasó Jorge. Ese parámetro es el
    // token de seguimiento que YouTube pega al compartir: identifica de dónde
    // salió el clic y no pinta nada en una página propia.
    href: "https://www.youtube.com/@soyjorgesierra",
    grupo: "redes",
    label: "YouTube",
    sub: "@soyjorgesierra",
    icono: "youtube",
    fuera: true,
  },
  {
    href: "https://www.jorgesierra.io/",
    grupo: "redes",
    label: "Mi portafolio",
    sub: "jorgesierra.io",
    icono: "sitio",
    fuera: true,
  },
  // Sin `target`: es el mismo sitio, y sacarlo a otra pestaña deja al visitante
  // con dos ilhas.ai abiertas.
  {
    href: "/",
    grupo: "tec",
    clase: "enlace--ilhas",
    label: "Tu primer proceso corriendo con agentes de IA.",
    sub: "ilhas.ai",
    icono: "ilhas",
    fuera: false,
  },
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jorge Sierra · Ilhas</title>
    <meta
      name="description"
      content="Jorge Sierra — fundador de Ilhas y Kinzal. Instagram, TikTok, portafolio y el manual de IA agéntica, gratis."
    />
    <link rel="canonical" href="https://www.ilhas.ai/jorgesierra" />
    <meta name="theme-color" content="#0E0E0F" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Ilhas" />
    <meta property="og:locale" content="es_LA" />
    <meta property="og:title" content="Jorge Sierra · Ilhas" />
    <meta
      property="og:description"
      content="Instagram, TikTok, portafolio y el manual de IA agéntica, gratis."
    />
    <meta property="og:url" content="https://www.ilhas.ai/jorgesierra" />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    {/* ⚠️ GA4 VA REPETIDO AQUÍ Y NO ES DESCUIDO. Esta página NO usa
        `Base.astro` —ver la nota de arriba—, así que no hereda nada de su
        <head>. Si el snippet vive sólo allá, la página que Jorge reparte por QR
        es justo la única que no se mide, y el embudo empieza ciego.
        Si algún día cambia el ID, son DOS lugares: aquí y `Base.astro`. */}
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-ENCWN9XWT1"></script>
    <script is:inline src="/ga.js"></script>

    {/* La foto es el LCP de esta página y lo único pesado que carga. */}
    <link rel="preload" as="image" href="/assets/bio/jorge-full.webp" />
    <link
      rel="preload"
      href="/assets/fonts/space-grotesk-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/inter-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body class="bio-doc">
    <main class="bio">
      <div class="figura">
        <div class="figura__luz" aria-hidden="true"></div>
        <img
          src="/assets/bio/jorge-full.webp"
          alt="Jorge Sierra"
          width="609"
          height="1000"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="cuerpo">
        <h1>{TITULO}</h1>
        <p class="bio__linea">{LINEA}</p>

        {/* LA LISTA VA PARTIDA EN DOS, con un rótulo en medio. Se filtra por
            el campo `grupo`, no por índice. */}
        <ul class="enlaces">
          {
            enlaces.filter((e) => e.grupo === "redes").map((e) => (
              <li>
                <a
                  class:list={["enlace", e.clase]}
                  href={e.href}
                  target={e.fuera ? "_blank" : undefined}
                  rel={e.fuera ? "noopener" : undefined}
                >
                  <span class="enlace__icono" aria-hidden="true">
                    {e.icono === "instagram" && (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 5.68a4.16 4.16 0 100 8.32 4.16 4.16 0 000-8.32zm0 6.86a2.7 2.7 0 110-5.4 2.7 2.7 0 010 5.4zm5.3-7.02a.97.97 0 11-1.94 0 .97.97 0 011.94 0z" />
                      </svg>
                    )}
                    {e.icono === "tiktok" && (
                      <svg viewBox="0 0 24 24">
                        <path d="M16.6 5.82A4.28 4.28 0 0115.54 3h-3.09v12.4a2.59 2.59 0 01-2.59 2.5 2.59 2.59 0 01-2.59-2.59 2.59 2.59 0 013.39-2.47V9.7a5.68 5.68 0 00-.8-.06A5.68 5.68 0 003.5 15.3 5.68 5.68 0 009.18 21a5.68 5.68 0 005.68-5.68V9.01a7.35 7.35 0 004.3 1.38V7.3a4.28 4.28 0 01-2.56-1.48z" />
                      </svg>
                    )}
                    {e.icono === "youtube" && (
                      <svg viewBox="0 0 24 24">
                        <path d="M23.5 6.9a3 3 0 00-2.1-2.1C19.5 4.3 12 4.3 12 4.3s-7.5 0-9.4.5A3 3 0 00.5 6.9C0 8.8 0 12 0 12s0 3.2.5 5.1a3 3 0 002.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 002.1-2.1c.5-1.9.5-5.1.5-5.1s0-3.2-.5-5.1zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z" />
                      </svg>
                    )}
                    {e.icono === "sitio" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                      >
                        <circle cx="12" cy="12" r="9" />
                        <path d="M3 12h18M12 3a15 15 0 010 18 15 15 0 010-18" />
                      </svg>
                    )}
                    {e.icono === "ilhas" && (
                      <img
                        src="/assets/logo/logo-mark.svg"
                        alt=""
                        width="22"
                        height="22"
                      />
                    )}
                  </span>
                  <span class="enlace__txt">
                    {e.label}
                    <span class="enlace__sub">{e.sub}</span>
                  </span>
                  {/* ⚠️ SIEMPRE ↗, INCLUSO EN LO INTERNO. En el resto del sitio
                      ↗ significa «abre pestaña nueva» y → «se queda aquí», y la
                      fila de Ilhas apunta a «/», que es interna y no abre nada.
                      Va en diagonal por simetría con Kinzal — pedido de Jorge,
                      5 sep 2026. Queda escrito para que nadie lo «corrija».
                      `fuera` sigue mandando en `target` y `rel`, que es lo que
                      de verdad cambia el comportamiento. */}
                  <span class="enlace__flecha" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="bio__sep">La parte tecnológica</p>
        <ul class="enlaces">
          {
            enlaces.filter((e) => e.grupo === "tec").map((e) => (
              <li>
                <a
                  class:list={["enlace", e.clase]}
                  href={e.href}
                  target={e.fuera ? "_blank" : undefined}
                  rel={e.fuera ? "noopener" : undefined}
                >
                  <span class="enlace__icono" aria-hidden="true">
                    {e.icono === "instagram" && (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 5.68a4.16 4.16 0 100 8.32 4.16 4.16 0 000-8.32zm0 6.86a2.7 2.7 0 110-5.4 2.7 2.7 0 010 5.4zm5.3-7.02a.97.97 0 11-1.94 0 .97.97 0 011.94 0z" />
                      </svg>
                    )}
                    {e.icono === "tiktok" && (
                      <svg viewBox="0 0 24 24">
                        <path d="M16.6 5.82A4.28 4.28 0 0115.54 3h-3.09v12.4a2.59 2.59 0 01-2.59 2.5 2.59 2.59 0 01-2.59-2.59 2.59 2.59 0 013.39-2.47V9.7a5.68 5.68 0 00-.8-.06A5.68 5.68 0 003.5 15.3 5.68 5.68 0 009.18 21a5.68 5.68 0 005.68-5.68V9.01a7.35 7.35 0 004.3 1.38V7.3a4.28 4.28 0 01-2.56-1.48z" />
                      </svg>
                    )}
                    {e.icono === "youtube" && (
                      <svg viewBox="0 0 24 24">
                        <path d="M23.5 6.9a3 3 0 00-2.1-2.1C19.5 4.3 12 4.3 12 4.3s-7.5 0-9.4.5A3 3 0 00.5 6.9C0 8.8 0 12 0 12s0 3.2.5 5.1a3 3 0 002.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 002.1-2.1c.5-1.9.5-5.1.5-5.1s0-3.2-.5-5.1zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z" />
                      </svg>
                    )}
                    {e.icono === "sitio" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                      >
                        <circle cx="12" cy="12" r="9" />
                        <path d="M3 12h18M12 3a15 15 0 010 18 15 15 0 010-18" />
                      </svg>
                    )}
                    {e.icono === "ilhas" && (
                      <img
                        src="/assets/logo/logo-mark.svg"
                        alt=""
                        width="22"
                        height="22"
                      />
                    )}
                  </span>
                  <span class="enlace__txt">
                    {e.label}
                    <span class="enlace__sub">{e.sub}</span>
                  </span>
                  <span class="enlace__flecha" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }

          {/* El ÚNICO sólido en morado: es lo único que la página regala. */}
          <li>
            <a
              class="enlace enlace--manual"
              href="/manual-ia-agentica.pdf"
              download
            >
              <span class="enlace__icono" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
                </svg>
              </span>
              <span class="enlace__txt">
                Descarga el manual
                <span class="enlace__sub">
                  Un agente no es un chatbot con esteroides · 24 páginas, gratis
                </span>
              </span>
            </a>
          </li>

          {/* La segunda guía. Va en CIAN —el otro extremo del mismo degradado de
              marca— y no en otro morado: junto al del manual los dos se
              confunden y parece un error de render, no una pareja. Así los dos
              descargables se leen como lo que son, lo que Ilhas regala. */}
          <li>
            <a
              class="enlace enlace--guia"
              href="/numeros-que-pagan-la-nomina.pdf"
              download
            >
              <span class="enlace__icono" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
                </svg>
              </span>
              <span class="enlace__txt">
                Descarga la guía
                <span class="enlace__sub">
                  Los números que pagan la nómina · 16 páginas, gratis
                </span>
              </span>
            </a>
          </li>
        </ul>

        {/* El separador rotula los DOS grupos, no sólo el de Kinzal, y por eso
            se llama .bio__sep y sigue la familia que ya existe en la página
            (.bio__linea). Hubo un .kz__sep; ya no existe. */}
        <p class="bio__sep">La parte tradicional</p>

        {/* KINZAL, DE VUELTA A LA LISTA (Jorge, 5 sep 2026). Fue una tarjeta con
            la foto de IU Life y llegó a pesar 227 px; el problema es que entre
            esa tarjeta y la de Ilhas la página pasaba de 1,069 a 1,428 px en
            teléfono y dejaba de verse de un vistazo.

            La fila mide lo mismo que Instagram o TikTok. Lo que la separa de un
            enlace más no es el tamaño: es la piel de aluminio, que es CSS puro y
            no cuesta ni un byte de imagen. Ver `.enlace--kinzal` en el <style>.

            Va en su propio <ul> porque el rótulo «La parte tradicional» separa
            los dos grupos, y `.bio__sep + .enlaces` le quita el margen de arriba. */}
        <ul class="enlaces">
          <li>
            <a
              class="enlace enlace--kinzal"
              href="https://kinzal.ai"
              target="_blank"
              rel="noopener"
            >
              <span class="enlace__icono" aria-hidden="true">
                <img
                  src="/assets/kinzal/kinzal-mark.svg"
                  alt=""
                  width="22"
                  height="24"
                />
              </span>
              <span class="enlace__txt">
                Conoce Kinzal
                <span class="enlace__sub">
                  Fachadas y cancelería de aluminio · kinzal.ai
                </span>
              </span>
              <span class="enlace__flecha" aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>

        {/* El renglón entero es enlace al home, logo incluido. Va como <a> y
            no como <p> con un <a> dentro para que el área de clic sea la fila
            completa y no solo el texto — en un teléfono la diferencia entre
            acertar y no. */}
        <a class="pie" href="/">
          <img src="/assets/logo/logo-mark.svg" alt="" width="17" height="17" />
          <b>ilhas</b> · Fundador de Ilhas y Kinzal
        </a>
      </div>
    </main>
  </body>
</html>

{/* ⚠️ SIN `is:global`, Y ESTO NO SE TOCA.

    Lo tuvo un rato y rompió el sitio entero: `is:global` NO deja los estilos
    en esta página, los manda a la hoja compartida —el sitio compila con
    `cssCodeSplit: false`, o sea UNA sola hoja para todo—. Dos destrozos:
    `body{background:dark}` pintó de negro las ocho páginas, y `.pie` chocó de
    frente con el pie del sitio, que usa exactamente esa clase, y lo volvió un
    flex de 13px.

    Scopeado funciona igual de bien aquí porque el <html> y el <body> están en
    ESTA plantilla, así que Astro les pone su hash y las reglas les llegan. */}
<style>
  /* Va en una CLASE del <body> y no en `body`: Astro nunca scopea `body`,
     `html` ni `:root` —los trata como globales— y un `body{background:dark}`
     aquí pinta de negro las ocho páginas del sitio. Ya pasó una vez. */
  .bio-doc{margin:0;font-family:var(--ilhas-font-body);background:var(--ilhas-dark);
    color:rgba(248,250,255,.72);line-height:1.5;-webkit-text-size-adjust:100%}

  /* ==========================================================================
     LINK IN BIO — /jorgesierra
     ==========================================================================
     Genérica a propósito: la misma URL sirve para la slide de una masterclass,
     para el perfil de Instagram y para el de TikTok. Sin parámetros, sin
     variantes, sin saludos de evento — una sola página que no caduca.

     Dos composiciones distintas, no una que se estira:
       · teléfono  → la figura arriba, el nombre encima del desvanecido, los
                     botones abajo. Es como se va a ver el 90% de las veces.
       · pantalla  → la figura a la izquierda a toda altura y el contenido a la
                     derecha, que es el encuadre de la slide que Jorge proyecta.

     El degradado de marca aparece UNA vez: el resplandor detrás de la figura.
     En los botones dejaría de ser acento y sería decoración. */

  .bio{position:relative;min-height:100svh;overflow:hidden;
    display:flex;flex-direction:column}

  /* --- la figura ----------------------------------------------------------- */
  .figura{position:relative;flex:0 0 auto;display:flex;justify-content:center;
    align-items:flex-end;padding-top:clamp(1rem,4vw,2rem)}
  .figura__luz{position:absolute;z-index:0;left:50%;bottom:6%;translate:-50% 0;
    width:min(115%,520px);aspect-ratio:1;border-radius:50%;
    background:linear-gradient(115deg,var(--ilhas-grad-start) 0%,var(--ilhas-primary) 50%,var(--ilhas-grad-end) 100%);filter:blur(60px);opacity:.34;
    pointer-events:none}
  /* `contain`, no `cover`: Jorge pidió la foto COMPLETA. Con `cover` se le
     corta la cabeza o los pies según el alto disponible. */
  .figura img{position:relative;z-index:1;display:block;
    height:clamp(300px,42svh,420px);width:auto;max-width:88vw;
    object-fit:contain}
  /* El desvanecido que amarra la figura con el fondo. Sin él, el recorte
     termina en un canto duro contra el negro y se ve pegado. */
  .figura::after{content:"";position:absolute;z-index:2;inset:auto 0 0 0;
    height:22%;pointer-events:none;
    background:linear-gradient(to top,var(--ilhas-dark) 12%,transparent)}

  /* --- el texto ------------------------------------------------------------ */
  .cuerpo{position:relative;z-index:3;flex:1;display:flex;flex-direction:column;
    align-items:center;text-align:center;
    padding:0 clamp(1.25rem,5vw,2rem) clamp(1.5rem,5vw,2.5rem);
    margin-top:-1.25rem}
  h1{margin:0;font-family:var(--ilhas-font-display);font-weight:600;
    font-size:clamp(2.1rem,8.5vw,2.9rem);line-height:1;letter-spacing:-.035em;
    background:linear-gradient(115deg,var(--ilhas-grad-start) 0%,var(--ilhas-primary) 50%,var(--ilhas-grad-end) 100%);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    /* inline-block para que el degradado se recorte sobre el TEXTO y no sobre
       una caja del ancho de la columna. */
    display:inline-block}
  .bio__linea{margin:.6rem 0 0;font-size:1rem;color:rgba(248,250,255,.72);
    max-width:30ch}

  /* --- los botones --------------------------------------------------------- */
  .bio__sep+.enlaces{margin-top:0}
  .enlaces{width:100%;max-width:26rem;margin:1.4rem 0 0;padding:0;list-style:none;
    display:grid;gap:.55rem}
  /* 58 px mínimo: por encima del objetivo táctil de 44 de Apple y 48 de
     Android, con holgura para un pulgar con prisa. */
  .enlace{display:flex;align-items:center;gap:.85rem;min-height:58px;
