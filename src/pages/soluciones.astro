---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Loop from "../components/medios/Loop.astro";
import TarjetaCaso from "../components/medios/TarjetaCaso.astro";
import MapaEmpresa from "../components/MapaEmpresa.astro";
import Testimonio from "../components/medios/Testimonio.astro";
import { mostrar } from "../lib/medios";
import { PRODUCTOS } from "../data/productos";
import Cifras from "../components/Cifras.astro";
import iaCaminoIcon from "../assets/icons/ia-camino.png";

const testimonios = [
  "soluciones-testimonio-oncologia",
  "soluciones-testimonio-despiece",
];

// La sección de testimonios no existe en producción mientras no haya material
// (docs/05-assets.md lo tenía bloqueado por eso). En dev sí, para ver las
// ranuras.
const hayTestimonios = mostrar(...testimonios);


const diagnosticoUrl = "mailto:hola@ilhas.ai?subject=Quiero%20un%20diagn%C3%B3stico";
---

<Base
  title="Soluciones"
  description="Soluciones de IA que ahorran tiempo y mueven la aguja, en cualquier área de tu empresa. Sin precio genérico: un diagnóstico real de tu caso."
>
  <article>
    <!-- 01 · Qué resolvemos -->
    <section class="section-y-sm">
      <div class="container hero-split">
        <div class="reveal">
          <h1>
            Soluciones de IA que ahorran tiempo y mueven{" "}
            <span class="text-gradient">la aguja</span>, en cualquier área
            de tu empresa.
          </h1>
          <p class="lead">
            No somos una agencia de "implementación de IA". Traemos criterio de
            producto a un proceso que hoy se hace a mano.
          </p>
          <a href={diagnosticoUrl} class="btn btn-primary hero-split__cta">
            Agendar un diagnóstico
          </a>
        </div>
        <div class="hero-split__visual" aria-hidden="true">
          <Loop id="soluciones-hero-loop" ratio="1 / 1">
            <Image src={iaCaminoIcon} alt="" width="280" height="280" />
          </Loop>
        </div>
      </div>
    </section>

    <!-- 02 · Cómo trabajamos -->
    <section class="section-y bg-white">
      <div class="container prose reveal">
        <p class="kicker">Cómo trabajamos</p>
        <h2>El mismo método, apuntado a tu empresa.</h2>
        <p>
          Usamos el Método Ilhas —Identificar, Levantamiento, Hilar,
          Accionar, Sistematizar— apuntado a tu empresa en vez de a una
          persona.
        </p>
        <p class="link-mt">
          <a href="/metodo">Conoce el método completo →</a>
        </p>
      </div>
    </section>

    <!-- 02b · Dónde ya entramos — el mapa con la prueba encima -->
    {/* El mismo mapa de /metodo, pero con el punto morado donde Ilhas ya
        construyó. Convierte el diagrama de promesa en historial sin una línea
        de copy — y prepara los casos de abajo, que son esos mismos puntos
        contados largo. */}
    <section class="section-y">
      <div class="container">
        <div class="prose reveal">
          <p class="kicker">Dónde ya entramos</p>
          <h2>Dónde ya lo hicimos.</h2>
        </div>

        <MapaEmpresa variante="prueba" />
      </div>
    </section>

    <!-- 03 · Casos -->
    <section class="section-y bg-dark">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">Casos</p>
          <h2>Esto ya lo construimos para empresas como la tuya.</h2>
        </div>

        <Cifras />

        <ul class="casos">
          {
            PRODUCTOS.map((p) => (
              <TarjetaCaso
                titulo={p.titulo}
                detalle={p.detalle}
                marca={p.marca}
                capturaId={p.capturaId}
                recorte={p.recorte}
              />
            ))
          }
        </ul>
      </div>
    </section>

    {/* § nueva · Testimonios — no existe en producción mientras no haya
        material. Los dos casos reales son los activos más caros de este
        carril y los más delicados: van con atribución o no van. */}
    {
      hayTestimonios && (
        <section class="section-y">
          <div class="container">
            <div class="section-head reveal">
              <p class="kicker">Testimonios</p>
              <h2>Lo que dicen los que ya lo hicieron.</h2>
            </div>

            <div class="testimonios">
              {testimonios.map((id) => <Testimonio id={id} />)}
            </div>
          </div>
        </section>
      )
    }

    <!-- 04 · CTA de diagnóstico -->
    <section class="section-y bg-white">
      <div class="container prose prose-center cta-diagnostico reveal">
        <h2>Cuéntanos qué proceso quieres resolver.</h2>
        <p class="lead">
          Antes de hablar de precio hacemos un diagnóstico de tu caso.
        </p>
        <a href={diagnosticoUrl} class="btn btn-primary">
          Agendar un diagnóstico
        </a>
      </div>
    </section>
  </article>
</Base>

<style>
  /* --- 01 · hero ---
     El aire de arriba que Jorge señaló NO era una ranura vacía. `Ranura` solo
     se pinta en DEV (`import.meta.env.DEV`); en producción esa columna trae el
     ícono `ia-camino` de 280px, que es el respaldo que `Loop.astro` declara a
     propósito para que el hero no quede hueco antes de que exista el loop. Se
     queda.

     Tampoco era el `align-items:center`: la columna de texto mide 389px y el
     ícono 280, así que el centrado empujaba al ÍCONO, no al texto.

     Era el doble padding. `.hero-split` trae `padding-block: clamp(2.5rem,
     6vw, 5rem)` propio —80px a 1440— y aquí vive dentro de un `section-y-sm`
     que ya pone su ritmo. Se anulan LOS DOS.

     El de abajo se había dejado puesto («separa el hero de §02»), y estaba
     mal: el hueco visible entre el botón y «CÓMO TRABAJAMOS» medía 224px
     contra los 144 del resto del sitio, y era la frontera más ancha de las
     cinco páginas. La separación la pone la sección, no la caja de adentro.

     Va scopeado aquí y no en base.css porque /soluciones es la ÚNICA página
     que usa `.hero-split` — /finanzas tiene su propio `.hero-fin`. */
  .hero-split {
    padding-block: 0;
  }

  /* Página interior: H1 menor que el del home. */
  .hero-split h1 {
    max-width: 16ch;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
  }

  .hero-split__cta {
    margin-top: 1.75rem;
  }

  /* --- 02 · kicker/h2/párrafo, mismo patrón que /metodo: sin esto el
     kicker, el titular y el párrafo quedan pegados entre sí. --- */
  section > .container.prose > h2 {
    margin-top: 0.75rem;
    max-width: 30ch;
  }

  section .lead,
  section > .container.prose > p:not(.kicker):not(.lead) {
    margin-top: 1.25rem;
  }

  .link-mt {
    margin-top: 1.5rem;
  }

  .link-mt a {
    font-family: var(--ilhas-font-body);
    font-weight: 600;
    font-size: var(--ilhas-fs-small);
    color: var(--ilhas-primary);
    text-decoration: none;
  }

  /* --- 03 · casos --- */
  .casos {
    list-style: none;
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
    /* Ver .linaje del home: sin estirar el vacío de las tarjetas cortas. */
    align-items: start;
  }

  @media (min-width: 640px) {
    .casos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .casos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- § testimonios --- */
  .testimonios {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  @media (min-width: 768px) {
    .testimonios {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* --- 04 · CTA de diagnóstico --- */
  .cta-diagnostico {
    text-align: center;
  }

  .cta-diagnostico h2,
  .cta-diagnostico .lead {
    margin-inline: auto;
  }

  .cta-diagnostico .btn {
    margin-top: 1.75rem;
  }
</style>
